{{!-- Карточка проверки V20 — «бюллетень»: шапка, кости, исход-лента, кнопки. --}}
<div class="r-roll-card kind-{{kind}} {{outcome.css}} {{typeClass}} {{#if line.mage}}is-cast{{/if}} {{#if line.backlash}}is-backlash{{/if}}">
  {{#if emblem}}{{rSym emblem "r-card-emblem"}}{{/if}}
  <header class="r-card-head">
    {{#if actorImg}}<img class="r-card-img" src="{{actorImg}}" alt="">{{/if}}
    <div class="r-card-titles">
      <span class="r-card-title">{{title}}</span>
      {{#if subtitle}}<span class="r-card-sub">{{subtitle}}</span>{{/if}}
    </div>
    <span class="r-card-pool" data-tooltip="{{localize 'VTM20.Roll.Pool'}}"><b>{{pool}}</b><i class="fa-solid fa-dice-d10"></i>{{#if showDifficulty}}<em>{{localize "VTM20.Roll.Vs"}} {{difficulty}}</em>{{/if}}</span>
  </header>

  {{!-- Чародейство мага: Сферы эффекта со знаками и вид магии --}}
  {{#if line.mage}}
  <div class="r-cast-chips">
    {{#each line.mage.spheres}}<span class="r-cast-chip">{{rSym sym "r-mg"}}{{name}} <b>{{rank}}</b></span>{{/each}}
    <span class="r-cast-chip is-kind is-{{line.mage.kind}}"><i class="fa-solid {{line.mage.kindIcon}}"></i> {{line.mage.kindLabel}}</span>
    {{#if line.mage.quint}}<span class="r-cast-chip is-quint"><i class="fa-solid fa-sun"></i> −{{line.mage.quint}}</span>{{/if}}
  </div>
  {{/if}}
  {{!-- Свой блок линейки (оборотень: Дар, ритуал, форма, бешенство…): чипы с тем, что это и чем заплачено --}}
  {{#if line.any.chips.length}}
  <div class="r-line-chips">{{#each line.any.chips}}<span class="r-line-chip {{cls}}">{{#if sym}}{{rSym sym "r-wg"}}{{else if icon}}<i class="fa-solid {{icon}}"></i>{{/if}}{{label}}{{#if value}} <b>{{value}}</b>{{/if}}</span>{{/each}}</div>
  {{/if}}
  {{#if breakdown.length}}
  <div class="r-card-breakdown">{{#each breakdown}}<span>{{label}} <b>{{rSigned value}}</b></span>{{/each}}</div>
  {{/if}}

  <div class="r-dice-tray">
    {{#each dice}}<span class="r-die {{cls}}"><span>{{value}}</span></span>{{/each}}
    {{#if willpower}}<span class="r-die is-will" data-tooltip="{{localize 'VTM20.Roll.WillpowerSuccess'}}"><i class="fa-solid fa-star"></i></span>{{/if}}
    {{#if auto}}<span class="r-die is-will" data-tooltip="{{localize 'VTM20.Roll.AutoSuccess'}}"><i class="fa-solid fa-hand-fist"></i><small>{{auto}}</small></span>{{/if}}
  </div>
  {{#if opposed}}
  <div class="r-opposed-tray"><span class="r-opp-label">{{opposed.label}} · <b>{{opposed.successes}}</b></span>{{#each opposed.dice}}<span class="r-die is-torment {{cls}}"><span>{{value}}</span></span>{{/each}}</div>
  {{/if}}
  {{#if dice.length}}
  <div class="r-card-tally">
    <span class="is-hit" data-tooltip="{{localize 'VTM20.Roll.TallyHits'}}"><i class="fa-solid fa-check"></i> {{ev.hits}}</span>
    {{#if ev.ones}}<span class="is-one" data-tooltip="{{localize 'VTM20.Roll.TallyOnes'}}"><i class="fa-solid fa-xmark"></i> {{ev.ones}}</span>{{/if}}
    {{#if ev.tens}}<span class="is-ten" data-tooltip="{{localize 'VTM20.Roll.TallyTens'}}">10 × {{ev.tens}}{{#if specialty}} <em>×2</em>{{/if}}</span>{{/if}}
  </div>
  {{/if}}

  {{!-- Призыв демона: кость Муки — отдельным огненным ромбом и исходом эффекта --}}
  {{#if torment}}
  <div class="r-torment-line {{#if torment.high}}is-high{{/if}}">
    <span class="r-die is-torment"><span>{{#if torment.die}}{{torment.die}}{{else}}{{torment.low}}{{/if}}</span></span>
    <span class="r-tl-text"><b>{{#if torment.high}}{{localize "VTM20.Demon.EffectHigh"}}{{else}}{{localize "VTM20.Demon.EffectNormal"}}{{/if}}</b>
      <em>{{#if torment.chosen}}{{localize "VTM20.Demon.ChoseHigh"}}{{else if torment.die}}{{localize "VTM20.Demon.TormentDieTitle"}} {{torment.die}} · {{localize "VTM20.Demon.Torment"}} {{torment.n}}{{else}}{{localize "VTM20.Demon.TormentSplit" n=torment.n low=torment.low hi=torment.hi}}{{/if}}</em></span>
    {{#unless torment.high}}<button type="button" class="r-tl-choose" data-r-action="chooseHigh" data-tooltip="{{localize 'VTM20.Demon.ChooseHighHint'}}"><i class="fa-solid fa-fire"></i></button>{{/unless}}
  </div>
  {{/if}}

  <div class="r-outcome">
    <span class="r-outcome-ribbon"><i class="fa-solid {{outcome.icon}}"></i> {{outcome.label}}</span>
    {{#unless (or (eq kind "damage") (eq kind "soak"))}}<span class="r-outcome-num"><b>{{successes}}</b> {{localize "VTM20.Roll.Successes"}}</span>{{/unless}}
  </div>

  {{!-- итог чародейства: что вышло по таблице успехов и чем заплачено Парадоксом --}}
  {{#if line.mage}}
  <div class="r-cast-result">
    <p>{{line.mage.text}}</p>
    {{#if line.mage.paradox}}<p class="r-cast-paradox"><i class="fa-solid fa-burst"></i> {{line.mage.paradoxText}}</p>{{/if}}
  </div>
  {{#if line.mage.backlash}}<div class="r-card-buttons"><button type="button" data-r-action="mageBacklash"><i class="fa-solid fa-burst"></i> {{line.mage.backlashLabel}}</button></div>{{/if}}
  {{/if}}
  {{#if line.any.text}}<div class="r-line-result {{line.any.cls}}"><p>{{{line.any.text}}}</p>{{#if line.any.sub}}<p class="r-line-sub">{{line.any.sub}}</p>{{/if}}</div>{{/if}}
  {{#if line.backlash}}
  <div class="r-cast-result">
    <p>{{line.backlash.text}}</p>
    {{#if line.backlash.left}}<p class="r-cast-paradox"><i class="fa-solid fa-burst"></i> {{line.backlash.left}}</p>{{/if}}
  </div>
  {{#if line.backlash.burn}}<div class="r-card-buttons"><button type="button" data-r-action="mageBurn"><i class="fa-solid fa-fire"></i> {{line.backlash.burn}}</button></div>{{/if}}
  {{/if}}
  {{#if specialty}}<div class="r-card-note"><i class="fa-solid fa-feather"></i> {{localize "VTM20.Roll.SpecialtyUsed"}}{{#if specialtyName}}: {{specialtyName}}{{/if}}</div>{{/if}}
  {{#if extraNeeded}}<div class="r-card-note is-warn">{{localize "VTM20.Roll.ExtraNeeded" n=extraNeeded}}</div>{{/if}}
  {{#if hint}}<div class="r-card-hint">{{hint}}</div>{{/if}}
  {{#each notes}}<div class="r-card-note">{{{this}}}</div>{{/each}}
  {{#if effect}}<details class="r-card-effect" {{#if effectLabel}}open{{/if}}><summary>{{#if effectLabel}}{{effectLabel}}{{else}}{{localize "VTM20.Roll.Effect"}}{{/if}}</summary><div class="r-card-body">{{{effect}}}</div></details>{{/if}}

  {{#if extended}}
  <div class="r-ext">
    <div class="r-ext-bar"><i style="width: {{extended.pct}}%"></i></div>
    <span>{{localize "VTM20.Contest.Progress" n=extended.total need=extended.need step=extended.step}}</span>
  </div>
  {{#if extended.botched}}<div class="r-card-note is-warn">{{localize "VTM20.Contest.ExtBotch"}}</div>
  {{else if extended.done}}<div class="r-card-note">{{localize "VTM20.Contest.ExtDone"}}</div>
  {{else}}<div class="r-card-buttons"><button type="button" data-r-action="extend"><i class="fa-solid fa-forward"></i> {{localize "VTM20.Contest.Continue"}}</button></div>{{/if}}
  {{/if}}
  {{#if (eq contest "resisted")}}<div class="r-card-buttons"><button type="button" data-r-action="resist"><i class="fa-solid fa-arrows-left-right"></i> {{localize "VTM20.Contest.Resist"}}</button></div>{{/if}}
  {{#if (eq contest "teamwork")}}<div class="r-card-buttons"><button type="button" data-r-action="assist"><i class="fa-solid fa-handshake-angle"></i> {{localize "VTM20.Contest.Assist"}}</button></div>{{/if}}

  {{#if canDamage}}
  <div class="r-card-buttons">
    <button type="button" data-r-action="damage"><i class="fa-solid fa-burst"></i> {{localize "VTM20.Roll.RollDamage"}} · {{damageDice}} <span class="r-dmg">{{damageType}}</span></button>
  </div>
  {{/if}}
  {{#if powerHit}}
  <div class="r-card-buttons"><button type="button" data-r-action="powerHit"><i class="fa-solid fa-burst"></i> {{powerHit}}</button></div>
  {{/if}}
  {{#if atavism}}<div class="r-card-note is-warn"><i class="fa-solid fa-paw"></i> {{localize "VTM20.Roll.Atavism"}}</div>{{/if}}
  {{#if canLoseWill}}
  <div class="r-card-buttons">
    <button type="button" data-r-action="loseWill"><i class="fa-solid fa-star-half-stroke"></i> {{localize "VTM20.Magic.LoseWill"}}</button>
    <button type="button" data-r-action="loseWill" data-permanent="1"><i class="fa-solid fa-star"></i> {{localize "VTM20.Magic.LoseWillPermanent"}}</button>
  </div>
  {{/if}}
  {{#if canFrenzy}}<div class="r-card-buttons"><button type="button" data-r-action="huntFrenzy"><i class="fa-solid fa-face-angry"></i> {{localize "VTM20.Hunt.FrenzyCheck"}}</button></div>{{/if}}
  {{#if canFeed}}
  <div class="r-card-buttons"><button type="button" data-r-action="feed"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Hunt.Feed"}}</button></div>
  {{/if}}
  {{#if canApply}}
  <div class="r-card-buttons">
    <button type="button" data-r-action="apply" data-soak="1"><i class="fa-solid fa-shield-halved"></i> {{localize "VTM20.Roll.ApplySoak"}}</button>
    <button type="button" data-r-action="apply" data-soak="0"><i class="fa-solid fa-heart-crack"></i> {{localize "VTM20.Roll.ApplyRaw"}}</button>
  </div>
  {{/if}}
</div>
