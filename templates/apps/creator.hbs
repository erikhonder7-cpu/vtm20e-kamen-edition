        <b>{{label}}</b> <small>{{en}} · {{costText}}</small>
        <span class="r-cr-thorn-n">{{#if multi}}<a class="r-step" data-action="wrShadow" data-what="thorn" data-key="{{key}}" data-d="-1">−</a><b>{{n}}</b>{{/if}}<a class="r-step" data-action="wrShadow" data-what="thorn" data-key="{{key}}" data-d="{{#if on}}{{#if multi}}1{{else}}-1{{/if}}{{else}}1{{/if}}">{{#if on}}{{#if multi}}+{{else}}✓{{/if}}{{else}}+{{/if}}</a></span>
      </div>
      {{/each}}
    </div>
    {{else if wraith.isProjector}}
