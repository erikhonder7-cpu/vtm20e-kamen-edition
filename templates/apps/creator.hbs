            <b>{{total}}</b><em>{{#if gift}}+{{gift}}{{/if}}</em>
            <a class="r-cr-pm" data-action="pactGift" data-kind="attr" data-key="{{key}}" data-d="1"><i class="fa-solid fa-plus"></i></a></div>{{/each}}</div>{{/each}}
