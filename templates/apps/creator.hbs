      <span>{{localize "VTM20.WraithCr.ShadowPool"}}: <b>{{wraith.shadowPool}}</b>{{#if wraith.trade}} <small>({{localize "VTM20.WraithCr.Trade"}} {{wraith.trade}})</small>{{/if}}</span>
