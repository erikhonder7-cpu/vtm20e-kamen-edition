{{!-- Мастер создания V20 по образцу V5: шапка шага с кружками, подсказка, тело шага, подвал. --}}
<div class="r-cr">
  <nav class="r-cr-steps">
    <div class="r-cr-steps-head">
      {{#if typeSym}}{{rSym typeSym "r-wg"}}{{else}}<img src="{{typeSigil}}" alt="">{{/if}}
      <b>{{typeLabel}}</b>
    </div>
    <ol>
      {{#each steps}}
      <li class="r-cr-step {{#if active}}is-active{{/if}} {{#if done}}is-done{{/if}}">
        <a data-action="goto" data-i="{{i}}">
          <span class="r-cr-step-coin">{{#if done}}<i class="fa-solid fa-check"></i>{{else}}{{rRoman n}}{{/if}}</span>
          <span class="r-cr-step-label">{{label}}</span>
        </a>
      </li>
      {{/each}}
    </ol>
  </nav>

  <header class="r-cr-head">
    <span class="r-cr-stepno">{{localize "VTM20.Creator.StepN" n=(rRoman stepNumber) m=(rRoman stepCount)}}</span>
    <h1>{{title}}</h1>
    <p class="r-cr-hint">{{hint}}</p>
    {{#if sectRule}}<p class="r-cr-hint r-cr-sectrule"><i class="fa-solid fa-scroll"></i> {{sectRule}}</p>{{/if}}
  </header>

  <aside class="r-cr-patent">
    {{#if patent.sym}}{{rSym patent.sym "r-cr-patent-wm"}}{{/if}}
    <div class="r-cr-patent-frame">
      <img class="r-portrait" src="{{patent.img}}" alt="">
      {{#if patent.generation}}<div class="r-seal"><span class="r-seal-num">{{rRoman patent.generation}}</span><span class="r-seal-cap">{{localize "VTM20.Sheet.Gen"}}</span></div>{{/if}}
    </div>
    <div class="r-cr-patent-name">{{#if patent.name}}{{patent.name}}{{else}}—{{/if}}</div>
    {{#if patent.concept}}<div class="r-cr-patent-concept">{{patent.concept}}</div>{{/if}}
    <div class="r-cr-patent-kicker">{{typeLabel}}{{#if patent.clan}} · <span>{{patent.clan}}</span>{{/if}}</div>
    {{#if patent.sect}}<div class="r-cr-patent-sect">{{#if patent.sectSym}}{{rSym patent.sectSym "r-sym-inline"}}{{/if}}{{patent.sect}}</div>{{/if}}
    <div class="r-cr-patent-stats">
      <div><b>{{patent.morality}}</b><span>{{patent.pathName}}</span></div>
      <div><b>{{patent.willpower}}</b><span>{{localize "VTM20.Willpower"}}</span></div>
      {{#if patent.garou}}<div><b>{{patent.gnosis}}</b><span>{{localize "VTM20.Werewolf.Gnosis"}}</span></div>{{/if}}
      {{#if patent.demon}}<div><b>{{patent.torment}}</b><span>{{localize "VTM20.Demon.Torment"}}</span></div>{{/if}}
      {{#if patent.blood}}<div><b>{{patent.blood}}</b><span>{{localize "VTM20.Sheet.BloodPool"}}</span></div>{{/if}}
    </div>
    <h4 class="r-cr-ledger-title"><span>{{localize "VTM20.Creator.Ledger"}}</span></h4>
    <ul class="r-cr-ledger">
      {{#each patent.ledger}}<li class="is-{{state}}"><span>{{label}}</span><b>{{left}}</b><i style="--pct: {{pct}}%"></i></li>{{/each}}
    </ul>
  </aside>

  <div class="r-cr-body">

    {{!-- I. Концепция и возраст --}}
    {{#if is_concept}}
    <div class="r-cols2">
      <div>
        <div class="r-fields is-two">
          <label class="r-f is-span2"><span>{{localize "VTM20.Sheet.Name"}}</span><input type="text" data-field="name" value="{{st.name}}"></label>
          <label class="r-f is-span2"><span>{{localize "VTM20.Details.concept"}}</span><input type="text" data-field="concept" value="{{st.concept}}" placeholder="{{localize 'VTM20.Creator.ConceptPh'}}"></label>
          <label class="r-f"><span>{{localize "VTM20.Details.nature"}}</span>
            <input type="text" data-field="nature" value="{{st.nature}}" data-combo="r-cr-arch" placeholder="—"></label>
          <label class="r-f"><span>{{localize "VTM20.Details.demeanor"}}</span>
            <input type="text" data-field="demeanor" value="{{st.demeanor}}" data-combo="r-cr-arch" placeholder="—"></label>
          <datalist id="r-cr-arch">{{#each archetypes}}<option value="{{name}}"></option>{{/each}}</datalist>
          {{#if isVampire}}<label class="r-f"><span>{{localize "VTM20.Details.sire"}}</span><input type="text" data-field="sire" value="{{st.sire}}"></label>{{/if}}
          {{#if isDhampir}}
          <label class="r-f"><span>{{localize "VTM20.Dhampir.Concept"}}</span><select data-field="dhConcept"><option value="">—</option>{{#each dhConcepts}}<option value="{{value}}" {{#if selected}}selected{{/if}} title="{{tip}}">{{label}}</option>{{/each}}</select></label>
          <label class="r-f"><span>{{localize "VTM20.Dhampir.Antecedent"}}</span><input type="text" data-field="antecedent" value="{{st.antecedent}}"></label>
          <label class="r-f"><span>{{localize "VTM20.Dhampir.AntecedentClan"}}</span><select data-field="antecedentClan"><option value="">—</option>{{#each antecedentClans}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          {{else if isGhoul}}<label class="r-f"><span>{{localize "VTM20.Details.domitor"}}</span><input type="text" data-field="domitor" value="{{st.domitor}}"></label>{{/if}}
        </div>
        {{#if natureRegain}}<div class="r-cr-note"><i class="fa-solid fa-star"></i> <b>{{st.nature}}</b> — {{localize "VTM20.Sheet.NatureRegain"}} {{natureRegain}}</div>{{/if}}
        {{#if dhWeakness}}<div class="r-cr-note"><i class="fa-solid fa-droplet"></i> <b>{{localize "VTM20.Dhampir.WeaknessOf"}}:</b> {{dhWeakness}}</div>{{/if}}
      </div>
      <div>
        {{#unless (or isDemon isMortal isHunter isWerewolf)}}
        <h3 class="r-h3">{{tierTitle}}</h3>
        <div class="r-cr-tiles is-tiers">
          {{#each tiers}}
          <a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="tier" data-tier="{{key}}">
            <b>{{label}}</b><span>{{hint}}</span>{{#if xp}}<em>+{{xp}} {{localize "VTM20.Creator.XpShort"}}</em>{{/if}}
          </a>
          {{/each}}
        </div>
        {{else}}<h3 class="r-h3">{{localize "VTM20.Sheet.Experience"}}</h3><p class="r-note r-explain">{{#if (or isMortal isHunter isWerewolf)}}{{localize "VTM20.Creator.XpMortal"}}{{else}}{{localize "VTM20.Creator.XpDemon"}}{{/if}}</p>{{/unless}}
        <label class="r-cr-xpinput">{{localize "VTM20.Creator.XpCustom"}} <input type="number" data-field="xpTotal" value="{{st.xpTotal}}" min="0" step="5"></label>
        {{#if isHunter}}<label class="r-cr-xpinput">{{localize "VTM20.Creator.HunterExtra"}} <input type="number" data-field="hunterExtra" value="{{st.hunterExtra}}" min="0" max="6"></label>
        <p class="r-note r-explain">{{localize "VTM20.Creator.HunterExtraHint"}}</p>{{/if}}
      </div>
    </div>
        {{#if isMortal}}
        {{!-- Слуга падшего (Damned and Deceived, гл. 4): свои числа и шаг «Танец с Дьяволом» --}}
        <div class="r-cr-eb is-thrall {{#if st.thrall}}is-on{{/if}}">
          <div class="r-cr-eb-head">
            <span class="r-cr-eb-sym"><i class="fa-solid fa-handshake-angle"></i></span>
            <div class="r-cr-eb-titles">
              <b>{{localize "VTM20.Creator.Thrall"}}</b>
              <span class="r-note">{{#if st.thrall}}{{localize "VTM20.Creator.ThrallOn"}}{{else}}{{localize "VTM20.Creator.ThrallOff"}}{{/if}}</span>
            </div>
            <a class="r-btn {{#if st.thrall}}is-ghost{{else}}is-primary{{/if}}" data-action="thrall">{{#if st.thrall}}<i class="fa-solid fa-rotate-left"></i> {{localize "VTM20.Creator.ThrallBack"}}{{else}}<i class="fa-solid fa-handshake"></i> {{localize "VTM20.Creator.ThrallMake"}}{{/if}}</a>
          </div>
          {{#if st.thrall}}
          <ul class="r-cr-eb-rules">
            <li><b>6 / 4 / 3</b><span>{{localize "VTM20.Sheet.Attributes"}}</span></li>
            <li><b>11 / 7 / 4</b><span>{{localize "VTM20.Sheet.Abilities"}}</span></li>
            <li><b>5</b><span>{{localize "VTM20.Sheet.Backgrounds"}}</span></li>
            <li><b>1 + 3</b><span>{{localize "VTM20.Sheet.Virtues"}}</span></li>
            <li><b>1</b><span>{{localize "VTM20.Creator.ThrallFaith"}}</span></li>
            <li><b>0</b><span>{{localize "VTM20.Demon.Torment"}}</span></li>
            <li><b>15</b><span>{{localize "VTM20.Creator.Freebies"}}</span></li>
            <li><b>≤ 7</b><span>{{localize "VTM20.Sheet.Flaws"}}</span></li>
          </ul>
          {{/if}}
        </div>
        {{#unless st.thrall}}
        {{!-- Особый смертный: Родня Гару (W20 Kinfolk), Ками (W20 Umbra), фомор (Book of the Wyrm) --}}
        <div class="r-cr-markbox {{#if marks.mark}}is-on{{/if}}">
          <div class="r-cr-markbox-head"><b>{{localize "VTM20.Creator.Mark.title"}}</b><span>{{localize "VTM20.Creator.Mark.lead"}}</span></div>
          <div class="r-cr-mark-tiles">
            {{#each marks.tiles}}<a class="r-cr-mark-tile {{#if active}}is-active{{/if}}" data-action="mark" data-mark="{{key}}" role="button" aria-pressed="{{#if active}}true{{else}}false{{/if}}">
              <i class="fa-solid {{icon}}"></i><b>{{label}}</b><small>{{short}}</small></a>{{/each}}
          </div>
          {{#if marks.mark}}<div class="r-cr-mark-detail"><p class="r-cr-mark-hint"><i class="fa-solid fa-circle-info"></i> {{marks.hint}}</p>{{/if}}
          {{#if (rEq marks.mark "sorcerer")}}
          <div class="r-cr-mark-fields">
            <label class="r-cr-mark-field is-wide"><span>{{localize "VTM20.Sorcerer.Affiliation"}}</span>
              <select data-field="sorcAff"><option value="">—</option>{{#each marks.affiliations}}<option value="{{key}}" {{#if selected}}selected{{/if}} title="{{tip}}">{{label}}</option>{{/each}}</select></label>
          </div>
          <p class="r-cr-mark-hint">{{localize "VTM20.SorcCr.Hint"}}</p>
          {{/if}}
          {{#if (rEq marks.mark "kinfolk")}}
          <div class="r-cr-mark-fields">
            <label class="r-cr-mark-field is-wide"><span>{{localize "VTM20.Werewolf.Tribe"}}</span>
              <select data-field="markTribe"><option value="">—</option>{{#each marks.tribes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
          {{/if}}
          {{#if (rEq marks.mark "kami")}}
          <div class="r-cr-mark-fields">
            <label class="r-cr-mark-field"><span>{{localize "VTM20.Werewolf.Kami.kindLabel"}}</span>
              <select data-field="kamiKind">{{#each marks.kamiKinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="r-cr-mark-field is-wide"><span>{{localize "VTM20.Werewolf.Kami.geas"}}</span><input type="text" data-field="kamiGeas" value="{{st.kamiGeas}}" placeholder="{{localize 'VTM20.Creator.Mark.geasPh'}}"></label>
          </div>
          <div class="r-cr-pw-head"><b>{{localize "VTM20.Creator.Mark.kamiPowersTitle"}}</b><span class="r-cr-pw-count {{#if (rEq marks.kamiPicked 0)}}is-empty{{/if}}">{{localize "VTM20.Creator.Mark.picked" n=marks.kamiPicked cap=marks.kamiCap}}</span></div>
          <div class="r-cr-pw-grid">{{#each marks.kamiPowers}}<a class="r-cr-pw {{#if on}}is-on{{/if}} {{#if full}}is-full{{/if}}" data-action="markPower" data-key="{{key}}" data-tooltip="{{text}}" role="button" aria-pressed="{{#if on}}true{{else}}false{{/if}}">
            <i class="{{#if on}}fa-solid fa-circle-check{{else}}fa-regular fa-circle{{/if}}"></i><b>{{label}}</b><small>{{short}}</small></a>{{/each}}</div>
          {{/if}}
          {{#if (rEq marks.mark "fomor")}}
          <div class="r-cr-mark-fields">
            <label class="r-cr-mark-field is-wide"><span>{{localize "VTM20.Creator.Mark.fomorBreed"}}</span>
              <select data-field="fomorBreed"><option value="">—</option>{{#each marks.fomorBreeds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          </div>
          {{#if marks.fomorText}}<p class="r-cr-mark-hint">{{marks.fomorText}}</p>{{/if}}
          <div class="r-cr-pw-head"><b>{{localize "VTM20.Creator.Mark.fomorPowersTitle"}}</b><span class="r-cr-pw-count {{#if (rEq marks.fomorPicked 0)}}is-empty{{/if}}">{{localize "VTM20.Creator.Mark.pickedFomor" n=marks.fomorPicked cap=marks.fomorCap}}</span></div>
          <div class="r-cr-pw-grid">{{#each marks.fomorPowers}}<a class="r-cr-pw {{#if on}}is-on{{/if}} {{#if own}}is-own{{/if}} {{#if full}}is-full{{/if}}" {{#unless own}}data-action="markPower" data-key="{{key}}" role="button"{{/unless}} data-tooltip="{{text}}">
            <i class="{{#if own}}fa-solid fa-lock{{else if on}}fa-solid fa-circle-check{{else}}fa-regular fa-circle{{/if}}"></i><b>{{label}}</b><small>{{#if own}}{{localize "VTM20.Creator.Mark.fromBreed"}} · {{/if}}{{short}}</small></a>{{/each}}</div>
          {{/if}}
          {{#if marks.mark}}</div>{{/if}}
        </div>
        {{/unless}}
        {{/if}}
    {{#if isHunter}}
    {{!-- Кредо (Hunter: The Reckoning, гл. 3): основная Добродетель, начальная Убеждённость, путь Граней --}}
    <h3 class="r-h3">{{localize "VTM20.Hunter.Creed"}}</h3>
    <div class="r-cr-tiles r-cr-creeds">
      {{#each creeds}}
      <a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="creed" data-creed="{{key}}" data-tooltip="{{tips}}">
        <b>{{name}} <small>· {{who}}</small></b><span>{{text}}</span><em>{{virtueName}} · {{localize "VTM20.Hunter.Conviction"}} {{conviction}}{{#if lost}} · {{localize "VTM20.Hunter.LostCreed"}}{{/if}}</em>
      </a>
      {{/each}}
    </div>
    {{/if}}
    {{#if isVampire}}
    <h3 class="r-h3">{{localize "VTM20.Details.sect"}}</h3>
    <div class="r-cr-sects">
      {{#each sects}}
      <a class="r-cr-sect {{#if active}}is-active{{/if}}" data-action="sect" data-sect="{{key}}">
        <span class="r-cr-sect-sym r-cr-medal">{{#if sym}}{{rSym sym}}{{else if ../typeSym}}{{rSym ../typeSym "r-wg"}}{{else}}<img src="{{../typeSigil}}" alt="">{{/if}}</span>
        <b>{{label}}</b>
      </a>
      {{/each}}
    </div>
    {{/if}}
    {{/if}}

    {{!-- II. Клан и поколение --}}
    {{#if is_clan}}
    <div class="r-cr-gtabs">{{#each clanGroupTabs}}<a class="{{#if active}}is-active{{/if}}" data-action="clanGroup" data-group="{{key}}">{{label}}</a>{{/each}}</div>
    <div class="r-cr-clans">
      {{#each clans}}
      <a class="r-cr-clan {{#if active}}is-active{{/if}}" data-action="clan" data-clan="{{key}}">
        <span class="r-cr-clan-sym r-cr-medal">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid fa-droplet"></i>{{/if}}</span>
        <b>{{name}}</b>{{#if nickname}}<em>«{{nickname}}»</em>{{/if}}
        <span class="r-cr-clan-disc">{{disciplines}}</span>
      </a>
      {{/each}}
    </div>
    {{#if clan}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{clan.name}}</span></h4>
      <span class="r-cr-clancard-sym r-cr-medal">{{#if clan.sym}}{{rSym clan.sym}}{{/if}}</span>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{clan.name}}{{#if clan.nickname}} <em>«{{clan.nickname}}»</em>{{/if}}{{#if clan.sect}} · <small>{{clan.sect}}</small>{{/if}}</div>
        <div class="r-cr-discrow">
          {{#each clan.discCards}}<span class="r-cr-disc-chip">{{#if sym}}{{rSym sym}}{{/if}}{{label}}</span>{{/each}}
          {{#if clan.choiceOptions.length}}<span class="r-cr-or">+ {{localize "VTM20.Creator.OneOf"}}:</span>
            {{#each clan.choiceOptions}}<a class="r-cr-disc-chip is-choice {{#if active}}is-active{{/if}}" data-action="choice" data-key="{{value}}">{{#if sym}}{{rSym sym}}{{/if}}{{label}}</a>{{/each}}{{/if}}
          {{#unless clan.disciplines.length}}<span class="r-cr-or">{{localize "VTM20.Creator.AnyDisc"}}</span>{{/unless}}
        </div>
        <div class="r-weakness-text"><b>{{localize "VTM20.Sheet.Weakness"}}:</b> {{{clan.weakness}}}</div>
        <a class="r-cr-clan-more" data-action="clanAtlas" data-clan="{{clan.key}}"><i class="fa-solid fa-book-open"></i> {{localize "VTM20.Clans.More"}}</a>
        {{#if isVentrue}}<label class="r-f"><span>{{localize "VTM20.Creator.VentrueTaste"}}</span><input type="text" data-field="weaknessNote" value="{{st.weaknessNote}}"></label>{{/if}}
      </div>
    </div>
    {{/if}}
    <div class="r-cols2 r-cr-genrow">
      <div>
        <h3 class="r-h3">{{localize "VTM20.Details.generation"}}</h3>
        <div class="r-cr-gens">
          {{#each gens}}<a class="r-cr-gen {{#if active}}is-active{{/if}}" data-action="gen" data-gen="{{g}}" data-tooltip="{{localize 'VTM20.Creator.GenTip' pool=pool turn=perTurn cost=cost}}"><b>{{rRoman g}}</b><small>{{#if cost}}{{cost}} {{localize "VTM20.Creator.BgPts"}}{{else}}—{{/if}}</small></a>{{/each}}
        </div>
        <p class="r-note r-explain">{{localize "VTM20.Creator.GenerationHint"}}</p>
      </div>
      <div>
        <h3 class="r-h3">{{localize "VTM20.Sheet.Path"}}</h3>
        <input type="text" data-field="path" class="r-cr-path" data-combo="r-cr-paths" data-key="{{st.path}}" value="{{pathName}}">
        <datalist id="r-cr-paths">{{#each paths}}<option value="{{name}}" data-group="{{group}}" data-key="{{key}}"></option>{{/each}}</datalist>
        {{#if pathInfo}}<p class="r-note">{{localize "VTM20.Sheet.Virtues"}}: <b>{{pathInfo.virtues}}</b> · {{localize "VTM20.Sheet.Bearing"}}: <b>{{pathInfo.bearing}}</b>{{#unless (eq st.path "humanity")}}<br>{{localize "VTM20.Creator.PathRules"}}{{/unless}}</p>{{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- II. Дом падшего: Дом, Облик, фракция, имена --}}
    {{#if is_house}}
    <div class="r-cr-clans r-cr-houses">
      {{#each houses}}
      <a class="r-cr-clan {{#if active}}is-active{{/if}}" data-action="house" data-house="{{key}}">
        <span class="r-cr-clan-sym r-cr-medal"><i class="fa-solid fa-fire-flame-curved"></i></span>
        <b>{{name}}</b><em>«{{akkadian}}» · {{localize "VTM20.Demon.Torment"}} {{#if ../st.earthbound}}10{{else}}{{torment}}{{/if}}</em>
        <span class="r-cr-clan-disc">{{lores}}</span>
      </a>
      {{/each}}
    </div>
    {{#if house}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{house.name}}</span></h4>
      <span class="r-cr-clancard-sym r-cr-medal"><img src="systems/vtm20e-kamen-edition/assets/ui/fallen-sigil.svg" alt=""></span>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{house.name}} <em>«{{house.akkadian}}»</em> · <small>{{localize "VTM20.Demon.StartTorment"}} {{#if st.earthbound}}10{{else}}{{house.torment}}{{/if}}</small></div>
        <p class="r-note">{{house.text}}</p>
        <div class="r-cr-discrow">
          <span class="r-cr-or">{{localize "VTM20.Demon.Visage"}}:</span>
          {{#each house.visages}}<a class="r-cr-disc-chip is-choice {{#if active}}is-active{{/if}}" data-action="visage" data-visage="{{key}}" data-tooltip="{{#each low}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}"><b>{{name}}</b>&nbsp;· {{lore}}</a>{{/each}}
        </div>
        <a class="r-cr-clan-more" data-action="houseAtlas"><i class="fa-solid fa-book-open"></i> {{localize "VTM20.Demon.Atlas"}}</a>
      </div>
    </div>
    {{!-- Привязанный к Земле (Earthbound, гл. 3): переключатель, правила, реликварий --}}
    <div class="r-cr-eb {{#if st.earthbound}}is-on{{/if}}">
      <div class="r-cr-eb-head">
        <span class="r-cr-eb-sym"><i class="fa-solid fa-fire"></i></span>
        <div class="r-cr-eb-titles">
          <b>{{localize "VTM20.Creator.Earthbound"}}</b>
          <span class="r-note">{{#if st.earthbound}}{{localize "VTM20.Creator.EarthboundOn"}}{{else}}{{localize "VTM20.Creator.EarthboundOff"}}{{/if}}</span>
        </div>
        <a class="r-btn {{#if st.earthbound}}is-ghost{{else}}is-primary{{/if}}" data-action="earthbound">{{#if st.earthbound}}<i class="fa-solid fa-rotate-left"></i> {{localize "VTM20.Creator.EarthboundBack"}}{{else}}<i class="fa-solid fa-gem"></i> {{localize "VTM20.Creator.EarthboundMake"}}{{/if}}</a>
      </div>
      {{#if st.earthbound}}
      <ul class="r-cr-eb-rules">
        <li><b>8 / 6 / 4</b><span>{{localize "VTM20.Sheet.Attributes"}}</span></li>
        <li><b>17 / 12 / 7</b><span>{{localize "VTM20.Sheet.Abilities"}}</span></li>
        <li><b>10</b><span>{{localize "VTM20.Demon.Lores"}}</span></li>
        <li><b>10</b><span>{{localize "VTM20.Demon.Backgrounds"}}</span></li>
        <li><b>1 + 3</b><span>{{localize "VTM20.Demon.Urges"}}</span></li>
        <li><b>4</b><span>{{localize "VTM20.Demon.Faith"}}</span></li>
        <li><b>10</b><span>{{localize "VTM20.Demon.Torment"}}</span></li>
        <li><b>21</b><span>{{localize "VTM20.Creator.Freebies"}}</span></li>
      </ul>
      <h4 class="r-cr-eb-sub">{{localize "VTM20.Demon.Reliquary"}}</h4>
      <div class="r-cr-eb-rel">
        {{#each reliquaryKinds}}
        <a class="r-cr-eb-relcard {{#if active}}is-active{{/if}}" data-action="reliquary" data-kind="{{value}}">
          <i class="fa-solid {{icon}}"></i><b>{{label}}</b><span>{{hint}}</span>
        </a>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/if}}
    <div class="r-cols2 r-cr-genrow">
      <div>
        <h3 class="r-h3">{{localize "VTM20.Demon.Faction"}}</h3>
        <div class="r-cr-discrow">{{#each factions}}<a class="r-cr-disc-chip is-choice {{#if active}}is-active{{/if}}" data-action="faction" data-faction="{{key}}" data-tooltip="{{text}}">{{name}}</a>{{/each}}</div>
        <p class="r-note r-explain">{{localize "VTM20.Creator.FactionHint"}}</p>
      </div>
      <div class="r-fields is-two r-cr-names">
        <label class="r-f"><span>{{localize "VTM20.Demon.Celestial"}}</span><input type="text" data-field="names.celestial" value="{{st.names.celestial}}"></label>
        <label class="r-f"><span>{{localize "VTM20.Demon.TrueName"}}</span><input type="text" data-field="names.trueName" value="{{st.names.trueName}}"></label>
      </div>
    </div>
    {{/if}}

    {{!-- II. Гару (W20, гл. 3): род — Гару или один из Фера; порода, аугурия, племя плитками; у Фера — выбор внутри рода --}}
    {{!-- II. Подменыш (C20, гл. 3): кит, ступень, двор, Дом, Наследия, Порог и Антитеза --}}
    {{#if is_changeling}}
    <h3 class="r-h3">{{localize "VTM20.Changeling.Kith"}}</h3>
    <div class="r-cr-clans r-cr-tribes">
      {{#each cl.kiths}}<a class="r-cr-clan {{#if active}}is-active{{/if}}" data-action="clPick" data-what="kith" data-key="{{key}}"><b>{{label}}</b><span class="r-cr-clan-disc">{{sub}}</span></a>{{/each}}
    </div>
    {{#if cl.kith}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{cl.kith.name}}</span></h4>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{cl.kith.name}} <em>{{cl.kith.en}}</em></div>
        {{#if cl.kith.affinityText}}<p class="r-note">{{localize "VTM20.ClCr.Affinity"}}: <b>{{cl.kith.affinityText}}</b></p>{{/if}}
        {{#each cl.kith.birthrights}}<p class="r-note"><b>{{name}}</b> <em>{{en}}</em> — {{text}}</p>{{/each}}
        {{#if cl.kith.frailty}}<div class="r-weakness-text"><b>{{localize "VTM20.ClCr.Frailty"}}: {{cl.kith.frailty.name}}</b> — {{cl.kith.frailty.text}}</div>{{/if}}
      </div>
    </div>
    {{/if}}
    <h3 class="r-h3">{{localize "VTM20.Changeling.Seeming"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-three">
      {{#each cl.seemings}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="clPick" data-what="seeming" data-key="{{key}}" data-tooltip="{{text}}"><b>{{label}}</b><span class="r-cr-tile-text">{{temper}}</span></a>{{/each}}
    </div>
    {{#if cl.wilder}}<div class="r-cr-tiles r-cr-garou-tiles is-two">{{#each cl.wilder}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="clPick" data-what="wilder" data-key="{{key}}"><b>{{label}}</b></a>{{/each}}</div>{{/if}}
    <h3 class="r-h3">{{localize "VTM20.Changeling.CourtLabel"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-two">
      {{#each cl.courts}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="clPick" data-what="court" data-key="{{key}}"><b>{{label}}</b></a>{{/each}}
    </div>
    <div class="r-cols2 r-cr-genrow">
      <label class="r-f"><span>{{localize "VTM20.Changeling.LegacySeelie"}}</span><select data-field="cl.legacySeelie"><option value="">—</option>{{#each cl.legaciesSeelie}}<option value="{{key}}" {{#if selected}}selected{{/if}} title="{{tip}}">{{name}}</option>{{/each}}</select></label>
      <label class="r-f"><span>{{localize "VTM20.Changeling.LegacyUnseelie"}}</span><select data-field="cl.legacyUnseelie"><option value="">—</option>{{#each cl.legaciesUnseelie}}<option value="{{key}}" {{#if selected}}selected{{/if}} title="{{tip}}">{{name}}</option>{{/each}}</select></label>
      <label class="r-f"><span>{{localize "VTM20.Changeling.House"}} <em class="r-h3-note">{{localize "VTM20.ClCr.HouseOptional"}}</em></span><select data-field="cl.house">{{#each cl.houses}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label class="r-f" data-tooltip="{{localize 'VTM20.Changeling.ThresholdHint'}}"><span>{{localize "VTM20.Changeling.Threshold"}}</span><input type="text" data-field="cl.threshold" value="{{st.cl.threshold}}"></label>
      <label class="r-f" data-tooltip="{{localize 'VTM20.Changeling.AntithesisHint'}}"><span>{{localize "VTM20.Changeling.Antithesis"}}</span><input type="text" data-field="cl.antithesis" value="{{st.cl.antithesis}}"></label>
    </div>
    {{#if cl.house}}<p class="r-note"><b>{{cl.house.name}}</b> — {{cl.house.short}}{{#if cl.house.boon}}<br><b>{{localize "VTM20.ClCr.Boon"}}:</b> {{cl.house.boon}}{{/if}}{{#if cl.house.flaw}}<br><b>{{localize "VTM20.ClCr.HouseFlaw"}}:</b> {{cl.house.flaw}}{{/if}}</p>{{/if}}
    <p class="r-note r-explain">{{localize "VTM20.ClCr.Tempers" g=cl.glamour w=cl.will b=cl.banality}}</p>
    {{#each cl.issues}}<p class="r-note is-warn">{{this}}</p>{{/each}}
    {{/if}}

    {{!-- II. Маг (M20, гл. 6): фракция со знаком, Сущность, родовая Сфера, фокус --}}
    {{#if is_mage}}
    <div class="r-cr-gtabs r-cr-garou-kinds">{{#each mage.groups}}<a class="{{#if active}}is-active{{/if}}" data-action="magePick" data-what="group" data-key="{{key}}">{{rSym sym "r-mg r-cr-kind-sym"}} {{label}}</a>{{/each}}</div>
    <div class="r-cr-clans r-cr-tribes">
      {{#each mage.factions}}
      <a class="r-cr-clan {{#if active}}is-active{{/if}}" data-action="magePick" data-what="faction" data-key="{{key}}">
        <span class="r-cr-clan-sym r-cr-medal">{{rSym sym "r-mg"}}</span>
        <b>{{label}}</b><span class="r-cr-clan-disc">{{sub}}</span>
      </a>
      {{/each}}
    </div>
    {{#if mage.faction}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{mage.faction.name}}</span></h4>
      <span class="r-cr-clancard-sym r-cr-medal">{{rSym mage.faction.sym "r-mg"}}</span>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{mage.faction.name}} <em>{{mage.faction.en}}</em></div>
        {{#if mage.faction.affinityText}}<p class="r-note">{{localize "VTM20.Mage.Affinity"}}: <b>{{mage.faction.affinityText}}</b></p>{{/if}}
        {{#if mage.faction.practices}}<div class="r-weakness-text"><b>{{localize "VTM20.Mage.Practice"}}:</b> {{mage.faction.practices}}</div>{{/if}}
      </div>
    </div>
    {{/if}}
    {{#if mage.subs.length}}
    <h3 class="r-h3">{{mage.subLabel}} <em class="r-h3-note">{{localize "VTM20.MageCr.SubOptional"}}</em></h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-three r-cr-affinities">
      {{#each mage.subs}}<a class="r-cr-tile {{#if sym}}has-sym{{/if}} {{#if active}}is-active{{/if}}" data-action="magePick" data-what="sub" data-key="{{key}}" {{#if note}}data-tooltip="{{note}}"{{/if}}>{{#if sym}}{{rSym sym "r-mg r-cr-tile-sym"}}{{/if}}<b>{{label}}</b>{{#if note}}<span class="r-cr-tile-text">{{note}}</span>{{/if}}</a>{{/each}}
    </div>
    {{/if}}
    <h3 class="r-h3">{{localize "VTM20.Mage.Essence"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-four">
      {{#each mage.essences}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="magePick" data-what="essence" data-key="{{key}}" data-tooltip="{{text}}"><b>{{label}}</b><span class="r-cr-tile-text">{{text}}</span></a>{{/each}}
    </div>
    <h3 class="r-h3">{{localize "VTM20.Mage.Affinity"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-three r-cr-affinities">
      {{#each mage.affinities}}<a class="r-cr-tile has-sym {{#if active}}is-active{{/if}} {{#if off}}is-off{{/if}}" data-action="magePick" data-what="affinity" data-key="{{key}}" {{#if off}}data-tooltip="{{localize 'VTM20.MageCr.NotFaction'}}"{{/if}}>{{rSym sym "r-mg r-cr-tile-sym"}}<b>{{label}}</b></a>{{/each}}
    </div>
    <p class="r-note r-explain">{{localize "VTM20.Mage.AffinityHint"}}</p>
    <h3 class="r-h3">{{localize "VTM20.Mage.Focus"}}</h3>
    <div class="r-cols2 r-cr-genrow">
      <label class="r-f"><span>{{localize "VTM20.Mage.Paradigm"}}</span><input type="text" data-field="mg.paradigm" value="{{st.mg.paradigm}}" list="r-cr-mpar" placeholder="{{localize 'VTM20.Mage.ParadigmHint'}}"></label>
      <label class="r-f" data-tooltip="{{localize 'VTM20.Mage.ResRule'}}"><span>{{localize "VTM20.Mage.Resonance"}}</span><input type="text" data-field="mg.resName" value="{{st.mg.resName}}" placeholder="{{localize 'VTM20.Mage.ResNameHint'}}"></label>
      <label class="r-f"><span>{{localize "VTM20.Mage.Practice"}}</span><input type="text" data-field="mg.practice" value="{{st.mg.practice}}" list="r-cr-mpra" placeholder="{{localize 'VTM20.Mage.PracticeHint'}}"></label>
      <datalist id="r-cr-mpar">{{#each mage.paradigms}}<option value="{{this}}"></option>{{/each}}</datalist>
      <datalist id="r-cr-mpra">{{#each mage.practices}}<option value="{{this}}"></option>{{/each}}</datalist>
    </div>
    <p class="r-note r-explain">{{localize "VTM20.MageCr.FocusHint"}}</p>
    {{/if}}

    {{!-- II. Призрак (Wraith 20, гл. 1, 4): Легион — по смерти, Гильдия — по Арканосу (вступление — Фон «Статус»), фракция, как умер --}}
    {{#if is_wraith}}
    {{!-- путь: призрак, Спектр (гл. 10), Восставший (гл. 11), проектор «Орфея» и Оттенок цвета (приложение) --}}
    <div class="r-cr-tiles r-cr-garou-tiles is-five r-cr-wrpaths">
      {{#each wraith.paths}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="path" data-key="{{key}}"><b><i class="fa-solid {{icon}}"></i> {{label}}</b><span class="r-cr-tile-text">{{sub}}</span></a>{{/each}}
    </div>
    {{#if wraith.isSpectre}}
    <h3 class="r-h3">{{localize "VTM20.Wraith.Spectre.Caste"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-three">
      {{#each wraith.castes}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="caste" data-key="{{key}}"><b>{{label}}</b><em>{{en}}</em><span class="r-cr-tile-text">{{sub}}</span></a>{{/each}}
    </div>
    {{/if}}
    {{#if wraith.isProjector}}
    <h3 class="r-h3">{{localize "VTM20.Wraith.Proj.ShadeLabel"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-four">
      {{#each wraith.shades}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="shade" data-key="{{key}}"><b>{{label}}</b><em>{{en}}</em><span class="r-cr-tile-text">{{sub}}</span></a>{{/each}}
    </div>
    <div class="r-cr-tiles r-cr-garou-tiles is-four">
      {{#each wraith.laments}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="lament" data-key="{{key}}"><b>{{label}}</b></a>{{/each}}
    </div>
    {{/if}}
    <h3 class="r-h3">{{localize "VTM20.Wraith.Legion"}}</h3>
    <div class="r-cr-clans r-cr-tribes r-cr-wrlegions">
      {{#each wraith.legions}}
      <a class="r-cr-clan {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="legion" data-key="{{key}}" data-tooltip="{{tip}}">
        <span class="r-cr-clan-sym r-cr-medal">{{rSym sym "r-wrg"}}</span>
        <b>{{label}}</b><span class="r-cr-clan-disc">{{sub}}</span>
      </a>
      {{/each}}
    </div>
    {{#unless wraith.noGuild}}
    <h3 class="r-h3">{{localize "VTM20.Wraith.Guild"}} <em class="r-h3-note">{{localize "VTM20.WraithCr.GuildOptional"}}</em></h3>
    {{#each wraith.guilds}}
    <div class="r-cr-sub">{{label}}</div>
    <div class="r-cr-tiles r-cr-garou-tiles is-five r-cr-affinities r-cr-wrguilds">
      {{#each list}}<a class="r-cr-tile has-sym {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="guild" data-key="{{key}}">{{rSym sym "r-wrg r-cr-tile-sym"}}<b>{{label}}</b><span>{{sub}}</span></a>{{/each}}
    </div>
    {{/each}}
    {{/unless}}
    <div class="r-cols2 r-cr-genrow">
      <label class="r-f"><span>{{localize "VTM20.Wraith.Faction"}}</span>
        <select data-field="wr.faction"><option value="">—</option>{{#each wraith.factions}}<option value="{{key}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="r-f"><span>{{localize "VTM20.Wraith.Death"}}</span><input type="text" data-field="wr.death" value="{{st.wr.death}}" placeholder="{{localize 'VTM20.WraithCr.DeathHint'}}"></label>
    </div>
    {{#each wraith.issues}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    {{/if}}

    {{#if is_garou}}
    <div class="r-cr-gtabs r-cr-garou-kinds">{{#each garou.kinds}}<a class="{{#if active}}is-active{{/if}}" data-action="garouPick" data-what="fera" data-key="{{key}}" {{#if en}}data-tooltip="{{en}}"{{/if}}>{{rSym sym "r-wg r-cr-kind-sym"}} {{label}}</a>{{/each}}</div>
    {{#if garou.fera}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{garou.fera.label}}</span></h4>
      <span class="r-cr-clancard-sym r-cr-medal">{{rSym garou.fera.sym "r-wg"}}</span>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{garou.fera.label}} <em>{{garou.fera.en}}</em> · <small>{{localize "VTM20.GarouCr.T.rage"}} {{garou.base.rage}} · {{localize "VTM20.GarouCr.T.gnosis"}} {{garou.base.gnosis}} · {{localize "VTM20.GarouCr.T.will"}} {{garou.base.will}}</small></div>
        {{#if garou.fera.facts.length}}<dl class="r-cr-garou-facts">{{#each garou.fera.facts}}<dt>{{k}}</dt><dd>{{{v}}}</dd>{{/each}}</dl>{{/if}}
      </div>
    </div>
    {{#each garou.fera.dims}}
    <h3 class="r-h3">{{label}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles">
      {{#each options}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="garouPick" data-what="sub.{{../key}}" data-key="{{key}}" {{#if tip}}data-tooltip="{{tip}}"{{/if}}><b>{{label}}</b>{{#if stats}}<em>{{stats}}</em>{{/if}}{{#if text}}<span class="r-cr-tile-text">{{{text}}}</span>{{/if}}</a>{{/each}}
    </div>
    {{/each}}
    {{else}}
    <h3 class="r-h3">{{localize "VTM20.GarouCr.Breed"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-three">
      {{#each garou.breeds}}<a class="r-cr-tile has-sym {{#if active}}is-active{{/if}}" data-action="garouPick" data-what="breed" data-key="{{key}}" data-tooltip="{{tip}}">{{rSym sym "r-wg r-cr-tile-sym"}}<b>{{label}}</b><em>{{sub}}</em></a>{{/each}}
    </div>
    {{#if garou.breedNotes}}<p class="r-note r-cr-garou-note">{{{garou.breedNotes}}}</p>{{/if}}
    <h3 class="r-h3">{{localize "VTM20.GarouCr.Auspice"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-five">
      {{#each garou.auspices}}<a class="r-cr-tile has-sym {{#if active}}is-active{{/if}}" data-action="garouPick" data-what="auspice" data-key="{{key}}" data-tooltip="{{tip}}">{{rSym sym "r-wg r-cr-tile-sym"}}<b>{{label}}</b><span>{{sub}}</span></a>{{/each}}
    </div>
    <h3 class="r-h3">{{localize "VTM20.GarouCr.Tribe"}}</h3>
    <div class="r-cr-clans r-cr-tribes">
      {{#each garou.tribes}}
      <a class="r-cr-clan {{#if active}}is-active{{/if}} {{#if wyrm}}is-wyrm{{/if}}" data-action="garouPick" data-what="tribe" data-key="{{key}}">
        <span class="r-cr-clan-sym r-cr-medal">{{rSym sym "r-wg"}}</span>
        <b>{{label}}</b><span class="r-cr-clan-disc">{{sub}}</span>
      </a>
      {{/each}}
    </div>
    {{#if garou.tribe}}
    <div class="r-cr-clancard">
      <h4 class="r-banner"><span>{{garou.tribe.label}}</span></h4>
      <span class="r-cr-clancard-sym r-cr-medal">{{rSym garou.tribe.sym "r-wg"}}</span>
      <div class="r-cr-clancard-body">
        <div class="r-cr-clancard-title">{{garou.tribe.label}} <em>{{garou.tribe.en}}</em> · <small>{{localize "VTM20.GarouCr.T.rage"}} {{garou.base.rage}} · {{localize "VTM20.GarouCr.T.gnosis"}} {{garou.base.gnosis}} · {{localize "VTM20.GarouCr.T.will"}} {{garou.base.will}}</small></div>
        <p class="r-note">{{localize "VTM20.Werewolf.Totem"}}: <b>{{garou.tribe.totem}}</b></p>
        {{#if garou.tribe.bg}}<div class="r-weakness-text"><b>{{localize "VTM20.Sheet.Backgrounds"}}:</b> {{{garou.tribe.bg}}}</div>{{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}
    {{#if garou.deformities}}
    <div class="r-cols2 r-cr-genrow">
      <label class="r-f"><span>{{localize "VTM20.GarouCr.Deformity"}}</span>
        <select data-field="ww.deform"><option value="">—</option>{{#each garou.deformities}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <p class="r-note">{{{garou.deformText}}}</p>
    </div>
    {{/if}}
    {{/if}}

    {{!-- III. Характеристики / IV. Способности --}}
    {{#if is_attributes}}
    <div class="r-cols3">
      {{#each attrGroups}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{label}}</span></h3>
        <div class="r-cr-prios">{{#each prios}}<a class="r-cr-prio {{#if active}}is-active{{/if}}" data-action="prio" data-kind="attr" data-group="{{../key}}" data-i="{{i}}" data-tooltip="{{label}} — {{n}}"><b>{{n}}</b> <span>{{label}}</span></a>{{/each}}</div>
        <div class="r-cr-left {{#if (lt left 0)}}is-over{{else if (eq left 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{left}}</b></div>
        {{#each list}}
        <div class="r-trait-main"><span class="r-trait-label">{{label}}</span><span class="r-leader"></span>
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}} {{#if locked}}is-locked{{/if}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>
        </div>
        {{#if locked}}<div class="r-note">{{localize "VTM20.Creator.Ugly"}}</div>{{/if}}
        {{/each}}
      </div>
      {{/each}}
    </div>
    <p class="r-note r-cr-legend"><i class="r-dot r-cr-dot is-base"></i> {{localize "VTM20.Creator.LegendBase"}} · <i class="r-dot r-cr-dot is-alloc"></i> {{localize "VTM20.Creator.LegendAlloc"}} · <i class="r-dot r-cr-dot is-free"></i> {{localize "VTM20.Creator.LegendFree"}} · <i class="r-dot r-cr-dot is-xp"></i> {{localize "VTM20.Creator.LegendXp"}}</p>
    {{/if}}

    {{#if is_abilities}}
    <div class="r-cols3">
      {{#each abilGroups}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{label}}</span></h3>
        <div class="r-cr-prios">{{#each prios}}<a class="r-cr-prio {{#if active}}is-active{{/if}}" data-action="prio" data-kind="abil" data-group="{{../key}}" data-i="{{i}}" data-tooltip="{{label}} — {{n}}"><b>{{n}}</b> <span>{{label}}</span></a>{{/each}}</div>
        <div class="r-cr-left {{#if (lt left 0)}}is-over{{else if (eq left 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{left}}</b></div>
        {{#each list}}
        <div class="r-trait-main"><span class="r-trait-label">{{label}}</span><span class="r-leader"></span>
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>
        </div>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- V. Дисциплины --}}
    {{#if is_disciplines}}
    <div class="r-cr-left {{#if (lt rem.disc 0)}}is-over{{else if (eq rem.disc 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{rem.disc}}</b>{{#if isGhoul}} · {{localize "VTM20.Creator.GhoulDisc"}}{{/if}}</div>
    {{#if isMage}}<div class="r-cr-arete"><span>{{localize "VTM20.Mage.Arete"}}</span>
      <a class="r-step" data-action="free" data-kind="morality" data-key="" data-d="-1">−</a><b>{{mage.arete}}</b><a class="r-step" data-action="free" data-kind="morality" data-key="" data-d="1">+</a>
      <em>{{localize "VTM20.MageCr.AreteHere" n=rem.free}}</em></div>{{/if}}
    {{#each sphereIssues}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    {{#if isDhampir}}<label class="r-check r-cr-dhswap" data-tooltip="{{localize 'VTM20.Creator.DhSwapHint'}}"><input type="checkbox" data-action="dhSwap" {{#if st.dhSwap}}checked{{/if}}> {{localize "VTM20.Creator.DhSwap"}}</label>{{/if}}
    <div class="r-cr-discs">
      {{#each discCards}}
      <div class="r-cr-disc {{#if inClan}}is-clan{{/if}}">
        <div class="r-cr-disc-head">
          <span class="r-disc-sigil">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
          <div class="r-cr-disc-title"><b>{{rName this}}</b><em>{{rAlt this}}{{#if inClan}} · {{@root.inClanLabel}}{{/if}}{{#if extra}} · {{localize "VTM20.Creator.ExtraDiscMark"}}{{/if}}{{#if outOfClan}} · {{localize "VTM20.Creator.OutOfClan"}}{{/if}}</em></div>
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>
          {{#if removable}}<a class="r-cr-disc-drop" data-action="dropDisc" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Creator.DropDisc'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </div>
        <ol class="r-cr-powers">
          {{#each powers}}<li class="{{#if owned}}is-owned{{/if}}"{{#if tip}} data-tooltip="{{tip}}"{{/if}}><span>{{rRoman level}}</span> {{rName this}}</li>{{/each}}
          {{#if pathed}}<li class="r-note r-explain">{{localize "VTM20.Creator.PathedNote"}}</li>{{/if}}
        </ol>
      </div>
      {{/each}}
    </div>
    {{> crExtraDisc}}
    {{> crAddDisc}}
    {{/if}}

    {{!-- V. Дары Гару (W20, гл. 3): три Дара 1-го уровня по ячейкам; сверх — свои Дары 1-го уровня за бонусные очки --}}
    {{#if is_gifts}}
    <div class="r-cr-gifts">
      {{#each giftSlots}}
      <div class="r-cr-panel r-tcol r-cr-giftslot {{#if wide}}is-wide{{/if}}">
        <h3 class="r-colhead"><span>{{label}}</span></h3>
        {{#each list}}
        <a class="r-cr-edge {{#if on}}is-on{{/if}}" data-action="garouGift" data-slot="{{../key}}" data-key="{{key}}" data-tooltip="{{text}}">
          <span class="r-cr-edge-lvl">I</span><b>{{label}}</b>{{#if cost}} <small>{{cost}}</small>{{/if}}{{#if on}}<i class="fa-solid fa-check"></i>{{/if}}
        </a>
        {{!-- в {{else}} у each контекст — сама ячейка, поэтому need, а не ../need --}}
        {{else}}<div class="r-note">{{#if need}}{{need}}{{else}}—{{/if}}</div>{{/each}}
      </div>
      {{/each}}
    </div>
    <h3 class="r-h3">{{localize "VTM20.Creator.GarouExtra" n=giftCost}}</h3>
    {{#if giftExtraReady}}
    <div class="r-cr-edges r-cr-giftextra">
      {{#each giftExtra}}
      <a class="r-cr-edge {{#if on}}is-on{{/if}}" data-action="garouExtra" data-key="{{key}}" data-tooltip="{{text}}">
        <span class="r-cr-edge-lvl">I</span><b>{{label}}</b>{{#if from}}<em class="r-cr-gift-from">{{from}}</em>{{/if}}{{#if cost}}<small>{{cost}}</small>{{/if}}{{#if on}}<i class="fa-solid fa-check"></i>{{/if}}
      </a>
      {{/each}}
    </div>
    {{else}}<p class="r-note r-explain">{{localize "VTM20.Creator.GarouExtraAfter"}}</p>{{/if}}
    {{/if}}

    {{!-- VI. Факты биографии и Добродетели --}}
    {{#if is_advantages}}
    <div class="r-cr-advgrid">
      <div>
        <div class="r-cr-sub">{{bgLabel}} <span class="r-cr-left {{#if (lt rem.bg 0)}}is-over{{else if (eq rem.bg 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{rem.bg}}</b></span></div>
        <div class="r-cr-bgs">
          {{#each bgCards}}
          <div class="r-cr-bg {{#if on}}is-on{{/if}} {{#if open}}is-open{{/if}}">
            <div class="r-cr-bg-head">
              <a class="r-cr-take" data-action="bgToggle" data-name="{{name}}" data-tooltip="{{#if on}}{{localize 'VTM20.Creator.Drop'}}{{else}}{{localize 'VTM20.Creator.Take'}}{{/if}}"><i class="fa-solid {{#if on}}fa-check{{else}}fa-plus{{/if}}"></i></a>
              <a class="r-cr-bg-name" data-action="read" data-key="bg:{{name}}"><b>{{rName this}}</b>{{#if sectLabel}} <small>{{sectLabel}}</small>{{/if}}{{#if bonus}} <small>{{localize "VTM20.Hunter.PatronFree" n=bonus}}</small>{{/if}}</a>
              {{#if on}}<span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>{{/if}}
              <a class="r-cr-readbtn" data-action="read" data-key="bg:{{name}}" data-tooltip="{{#if open}}{{localize 'VTM20.Creator.Collapse'}}{{else}}{{localize 'VTM20.Creator.Read'}}{{/if}}"><i class="fa-solid {{#if open}}fa-book{{else}}fa-book-open{{/if}}"></i></a>
            </div>
            {{#if open}}<div class="r-cr-fulltext">{{{html}}}</div>
            {{else}}<p class="r-cr-preview" data-action="read" data-key="bg:{{name}}">{{text}} <span>{{localize "VTM20.Creator.Read"}}</span></p>{{/if}}
          </div>
          {{/each}}
        </div>
      </div>
      {{#if isMage}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{localize "VTM20.MageCr.Start"}}</span></h3>
        <div class="r-cr-garou-base">
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Mage.Arete"}}</span><b>{{mage.arete}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Willpower"}}</span><b>{{mage.will}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Mage.Quintessence"}}</span><b>{{mage.quint}}</b></div>
        </div>
        <p class="r-note r-explain">{{localize "VTM20.MageCr.StartHint"}}</p>
      </div>
      {{else if isWraith}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{localize "VTM20.MageCr.Start"}}</span></h3>
        <div class="r-cr-garou-base">
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Wraith.Pathos"}}</span><b>{{wraith.pathos}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Willpower"}}</span><b>{{wraith.will}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.Wraith.Corpus"}}</span><b>10</b></div>
        </div>
        <p class="r-note r-explain">{{localize "VTM20.WraithCr.StartHint"}}</p>
      </div>
      {{else if isWerewolf}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{localize "VTM20.GarouCr.Renown"}}</span></h3>
        {{#unless garou.renownFixed}}<div class="r-cr-left {{#if (lt renownLeft 0)}}is-over{{else if (eq renownLeft 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{renownLeft}}</b></div>{{/unless}}
        {{#each renown}}
        <div class="r-trait-main"><span class="r-trait-label">{{label}}</span><span class="r-leader"></span>
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>
        </div>
        {{/each}}
        <p class="r-note">{{renownText}}</p>
        <div class="r-cr-garou-base">
          <div class="r-cr-sum-item"><span>{{localize "VTM20.GarouCr.T.rage"}}</span><b>{{garou.base.rage}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.GarouCr.T.gnosis"}}</span><b>{{garou.base.gnosis}}</b></div>
          <div class="r-cr-sum-item"><span>{{localize "VTM20.GarouCr.T.will"}}</span><b>{{garou.base.will}}</b></div>
        </div>
        <p class="r-note r-explain">{{localize "VTM20.Creator.GarouBaseHint"}}</p>
      </div>
      {{else}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{#if isLost}}{{localize "VTM20.Sheet.Virtues"}}{{else if isHunter}}{{localize "VTM20.Creator.HunterVirtues"}}{{else}}{{localize "VTM20.Sheet.Virtues"}}{{/if}}</span></h3>
        <div class="r-cr-left {{#if (lt rem.virt 0)}}is-over{{else if (eq rem.virt 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{rem.virt}}</b></div>
        {{#each virtues}}
        <div class="r-trait-main"><span class="r-trait-label">{{#if primary}}◆ {{/if}}{{label}}</span><span class="r-leader"></span>
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="dot" data-kind="{{kind}}" data-key="{{key}}" data-n="{{n}}"></a>{{/each}}</span>
        </div>
        {{/each}}
        <p class="r-note r-explain">{{#if isLost}}{{localize "VTM20.Creator.VirtueHintLost"}}{{else if isHunter}}{{localize "VTM20.Creator.VirtueHintHunter"}}{{else}}{{localize "VTM20.Creator.VirtueHint"}}{{/if}}</p>
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{!-- VI½. Грани охотника: очки Добродетелей, пути по порядку, чужие — не выше пути кредо --}}
    {{#if is_edges}}
    <div class="r-cr-freebar">{{#each edgeBudget}}<span class="{{#if (gt used value)}}is-over{{else if (eq used value)}}is-done{{/if}}">{{label}}: <b>{{used}} / {{value}}</b></span>{{/each}}</div>
    <div class="r-cr-edges">
      {{#each edgePaths}}
      <div class="r-cr-edgepath {{#if primary}}is-primary{{/if}}">
        <h3 class="r-h3">{{name}} <small>· {{virtue}}{{#if primary}} · {{localize "VTM20.Hunter.PrimaryPath"}}{{/if}}</small></h3>
        {{#each edges}}
        <a class="r-cr-edge {{#if on}}is-on{{/if}} {{#unless ok}}is-blocked{{/unless}}" data-action="edgeToggle" data-key="{{key}}" data-tooltip="{{#if why}}{{why}}{{else}}{{text}}{{/if}}">
          <span class="r-cr-edge-lvl">{{rRoman level}}</span><b>{{name}}</b>{{#if book}} <small class="r-cr-edge-book" data-tooltip="{{book}}"><i class="fa-solid fa-book" aria-hidden="true"></i></small>{{/if}}{{#if mad}} <i class="fa-solid fa-brain" aria-hidden="true"></i>{{/if}}{{#if on}}<i class="fa-solid fa-check"></i>{{/if}}
        </a>
        {{/each}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{#if is_bloodrights}}
    {{!-- Кровные права дампира (Accursed Heirs, гл. 4): бесплатные точки, сверх — 5 свободных пунктов за точку; не выше 3 --}}
    <div class="r-cr-freebar"><span class="{{#if (gt brBudget.used brBudget.base)}}is-over{{else if (eq brBudget.used brBudget.base)}}is-done{{/if}}">{{localize "VTM20.Dhampir.Bloodrights"}}: <b>{{brBudget.used}} / {{brBudget.base}}</b></span>{{#if brBudget.extra}}<span>{{localize "VTM20.Creator.BloodrightsExtra" n=brBudget.extra}}</span>{{/if}}</div>
    <div class="r-cr-edges r-cr-bloodrights">
      {{#each brList}}
      <div class="r-cr-br {{#if n}}is-on{{/if}} {{#if favored}}is-favored{{/if}}" data-tooltip="{{text}}">
        <b>{{rName this}}</b> <small>{{rAlt this}}{{#if req}} · {{req}} I{{/if}}{{#if rare}} · {{localize "VTM20.Dhampir.Rare"}}{{/if}}{{#if favored}} · {{localize "VTM20.Creator.BloodrightFavored"}}{{/if}}</small>
        <span class="r-dots">{{#each dots}}<a class="r-dot {{#if on}}is-filled{{/if}}" data-action="brSet" data-key="{{../key}}" data-n="{{i}}"></a>{{/each}}</span>
        <span class="r-cr-br-powers">{{powers}}</span>
      </div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- VII. Достоинства и недостатки --}}
    {{#if is_merits}}
    <div class="r-cr-mfbar">
      <div class="r-cr-gtabs">{{#each mfTabs}}<a class="{{#if active}}is-active{{/if}}" data-action="mfTab" data-tab="{{key}}">{{label}} <small>{{n}}</small></a>{{/each}}</div>
      <div class="r-cr-cats">{{#each mfCats}}<a class="{{#if active}}is-active{{/if}}" data-action="mfCat" data-cat="{{key}}">{{label}}</a>{{/each}}</div>
      <input type="search" class="r-cr-search" data-mf-search value="{{ui.mfSearch}}" placeholder="{{localize 'VTM20.Creator.Search'}}">
    </div>
    {{#each traitIssues}}<div class="r-cr-issue is-{{level}}"><i class="fa-solid {{#if (eq level "block")}}fa-ban{{else}}fa-triangle-exclamation{{/if}}"></i> {{text}}</div>{{/each}}
    <div class="r-cr-mfsum">
      <span>{{localize "VTM20.Sheet.Merits"}}: <b>{{meritPoints}}</b></span>
      <span>{{localize "VTM20.Sheet.Flaws"}}: <b>{{flawRaw}}</b>{{#if (gt flawRaw 7)}} ({{localize "VTM20.Creator.FlawCap"}}){{/if}}</span>
      {{#each merits}}<span class="r-cr-picked is-merit">{{rName this}}{{#if da}} <em class="r-da-mark" data-tooltip="{{localize 'VTM20.Library.Filter.DarkAges'}}">ТВ</em>{{/if}} {{#if ranged}}<input type="number" class="r-qty" data-field="merits.{{index}}.cost" value="{{cost}}" min="{{min}}" max="{{max}}">{{else}}({{cost}}){{/if}} <a data-action="mfToggle" data-kind="merit" data-name="{{name}}"><i class="fa-solid fa-xmark"></i></a></span>{{/each}}
      {{#if extraDisc}}{{> crExtraDisc}}{{/if}}
      {{#each flaws}}<span class="r-cr-picked is-flaw">{{rName this}}{{#if da}} <em class="r-da-mark" data-tooltip="{{localize 'VTM20.Library.Filter.DarkAges'}}">ТВ</em>{{/if}} {{#if ranged}}<input type="number" class="r-qty" data-field="flaws.{{index}}.cost" value="{{cost}}" min="{{min}}" max="{{max}}">{{else}}({{cost}}){{/if}} <a data-action="mfToggle" data-kind="flaw" data-name="{{name}}"><i class="fa-solid fa-xmark"></i></a></span>{{/each}}
    </div>
    <div class="r-cr-mfgrid">
      {{#each mfCards}}
      <div class="r-cr-mf is-{{@root.ui.mfTab}} {{#if on}}is-on{{/if}} {{#if open}}is-open{{/if}}">
        <span class="r-cr-mf-cost" data-tooltip="{{#if (eq @root.ui.mfTab 'flaw')}}{{localize 'VTM20.Creator.FlawGives'}}{{else}}{{localize 'VTM20.Creator.MeritCosts'}}{{/if}}">{{cost}}</span>
        <div class="r-cr-mf-main">
          <a class="r-cr-mf-title" data-action="read" data-key="{{key}}"><b>{{rName this}}</b>{{#if (rAlt this)}}<em>{{rAlt this}}</em>{{/if}}</a>
          <span class="r-cr-mf-tags"><span class="r-tag">{{cat}}</span>{{#if srcShort}}<span class="r-tag r-tag-src{{#if da}} is-da{{/if}}" data-tooltip="{{src}}">{{srcShort}}</span>{{/if}}</span>
          {{#if open}}<div class="r-cr-fulltext">{{{html}}}</div>
          {{else}}<p class="r-cr-preview" data-action="read" data-key="{{key}}">{{text}} <span>{{localize "VTM20.Creator.Read"}}</span></p>{{/if}}
        </div>
        <a class="r-cr-mf-take" data-action="mfToggle" data-name="{{name}}">{{#if on}}<i class="fa-solid fa-check"></i> {{localize "VTM20.Creator.Taken"}}{{else}}<i class="fa-solid fa-plus"></i> {{localize "VTM20.Creator.Take"}}{{/if}}</a>
      </div>
      {{else}}<div class="r-empty">{{localize "VTM20.Creator.NothingFound"}}</div>
      {{/each}}
    </div>
    {{/if}}

    {{!-- Призрак: Страсти (действие + чувство, 10 очков) и Оковы (люди, места, вещи, 10 очков), рейтинги 1–5 --}}
    {{#if is_passions}}
    <div class="r-cols2">
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{#if wraith.isSpectre}}{{localize "VTM20.Wraith.Spectre.OwnPassions"}}{{else}}{{localize "VTM20.Wraith.Passions"}}{{/if}}</span></h3>
        <div class="r-cr-left {{#if (lt wraith.passionsLeft 0)}}is-over{{else if (eq wraith.passionsLeft 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{wraith.passionsLeft}}</b></div>
        {{#each wraith.passions}}
        <div class="r-cr-wrrow">
          <input type="text" data-field="wr.passions.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.PassionText'}}">
          <input type="text" class="r-cr-wremo" data-field="wr.passions.{{i}}.emotion" value="{{emotion}}" placeholder="{{localize 'VTM20.Wraith.Emotion'}}"><span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="wrRow" data-list="passions" data-op="dot" data-i="{{../i}}" data-n="{{n}}"></a>{{/each}}</span>
          {{#if @root.wraith.isHue}}<a class="r-icon-btn r-cr-huedark {{#if (eq @root.wraith.hueDark i)}}is-on{{/if}}" data-action="wrPick" data-what="hueDark" data-key="{{i}}" data-tooltip="{{localize 'VTM20.WraithCr.HueDarkTip'}}"><i class="fa-solid fa-moon"></i></a>{{/if}}
          <a class="r-icon-btn is-danger" data-action="wrRow" data-list="passions" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>
        </div>
        {{/each}}
        <a class="r-btn is-ghost" data-action="wrRow" data-list="passions" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
        <p class="r-note r-explain">{{localize "VTM20.WraithCr.PassionsHint"}}</p>
      </div>
      {{#if wraith.hasFetters}}
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{#if wraith.isProjector}}{{localize "VTM20.Wraith.Proj.Tethers"}}{{else}}{{localize "VTM20.Wraith.Fetters"}}{{/if}}</span></h3>
        <div class="r-cr-left {{#if (lt wraith.fettersLeft 0)}}is-over{{else if (eq wraith.fettersLeft 0)}}is-done{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{wraith.fettersLeft}}</b></div>
        {{#each wraith.fetters}}
        <div class="r-cr-wrrow">
          <input type="text" data-field="wr.fetters.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.FetterText'}}">
          <span class="r-dots">{{#each dots}}<a class="r-dot r-cr-dot is-{{state}}" data-action="wrRow" data-list="fetters" data-op="dot" data-i="{{../i}}" data-n="{{n}}"></a>{{/each}}</span>
          <a class="r-icon-btn is-danger" data-action="wrRow" data-list="fetters" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>
        </div>
        {{/each}}
        <a class="r-btn is-ghost" data-action="wrRow" data-list="fetters" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
        <p class="r-note r-explain">{{#if wraith.isProjector}}{{localize "VTM20.WraithCr.TethersHint"}}{{else}}{{localize "VTM20.WraithCr.FettersHint"}}{{/if}}</p>
        {{#if wraith.isRisen}}<label class="r-f"><span>{{localize "VTM20.Wraith.Risen.Conduit"}}</span><input type="text" data-field="wr.conduit" value="{{wraith.conduit}}" placeholder="{{localize 'VTM20.WraithCr.ConduitHint'}}"></label>{{/if}}
      </div>
      {{/if}}
    </div>
    {{#each wraith.passionIssues}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{this}}</p>{{/each}}
    {{/if}}

    {{!-- Призрак: Тень (гл. 6) — архетип, бросок постоянного Ангста, Тёмные Страсти 7, свободные очки Тени: Ангст, Тёмные Страсти, Шипы --}}
    {{#if is_shadow}}
    {{#if wraith.isSpectre}}
    {{!-- Психея (гл. 10): архетип, рейтинг Пафоса (не выше Воли), Страсти 7; очки — отданные ей свободные --}}
    <div class="r-cr-freebar">
      <span>{{localize "VTM20.WraithCr.PsychePool"}}: <b>{{wraith.psyche.pool}}</b></span>
      <span>{{localize "VTM20.Creator.FreeSpent"}}: <b>{{wraith.psyche.spent}}</b></span>
      <span class="{{#if (lt wraith.psyche.left 0)}}is-over{{/if}}">{{localize "VTM20.Creator.LeftShort"}}: <b>{{wraith.psyche.left}}</b></span>
      <span class="r-note r-explain">{{localize "VTM20.WraithCr.PsycheCosts"}}</span>
    </div>
    <h3 class="r-h3">{{localize "VTM20.Wraith.Spectre.PsycheArchetype"}}</h3>
    <div class="r-cr-tiles r-cr-garou-tiles is-four">
      {{#each wraith.psyche.archetypes}}<a class="r-cr-tile {{#if active}}is-active{{/if}}" data-action="wrPick" data-what="psycheArch" data-key="{{key}}"><b>{{label}}</b><em>{{en}}</em></a>{{/each}}
    </div>
    <div class="r-cols2">
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{localize "VTM20.Wraith.Pathos"}}</span></h3>
        <div class="r-trait-main"><span class="r-trait-label">{{localize "VTM20.WraithCr.PsycheRating"}}</span><span class="r-leader"></span><b class="r-cr-val">{{wraith.psyche.rating}}</b>
          <a class="r-step" data-action="wrShadow" data-what="psycheRating" data-d="-1">−</a><a class="r-step" data-action="wrShadow" data-what="psycheRating" data-d="1">+</a></div>
        <p class="r-note r-explain">{{localize "VTM20.WraithCr.PsycheHint"}}</p>
      </div>
      <div class="r-cr-panel r-tcol">
        <h3 class="r-colhead"><span>{{localize "VTM20.Wraith.Spectre.PsychePassions"}} <small>{{wraith.psyche.sum}} / {{wraith.psyche.base}}</small></span></h3>
        {{#each wraith.psyche.passions}}
        <div class="r-cr-wrrow">
          <input type="text" data-field="wr.psyche.passions.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.PassionText'}}">
