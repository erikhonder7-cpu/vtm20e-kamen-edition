{{!-- Справочник линейки (маг, оборотень): слева — группы, поиск и список со знаками; справа — карточка. Разметка справочника кланов. --}}
<div class="r-cl">
  <aside class="r-cl-side">
    <div class="r-cl-groups">
      {{#each groups}}<a class="{{#if active}}is-active{{/if}}" data-action="group" data-group="{{key}}" data-tooltip="{{label}}"><span>{{label}}</span> <b>{{n}}</b></a>{{/each}}
    </div>
    <label class="r-cl-find"><i class="fa-solid fa-magnifying-glass"></i><input type="search" class="r-cl-search" value="{{v.q}}" placeholder="{{localize 'VTM20.Atlas.Search'}}"></label>
    <ol class="r-cl-list">
      {{#each list}}
      <li class="r-cl-item" data-text="{{text}}">
        <a class="{{#if active}}is-active{{/if}}" data-action="pick" data-key="{{key}}">
          <span class="r-cl-medal r-cr-medal">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
          <span class="r-cl-name">{{name}}{{#if sub}}<em>{{sub}}</em>{{/if}}</span>
        </a>
      </li>
      {{/each}}
      <li class="r-cl-empty" hidden>{{localize "VTM20.Clans.Nothing"}}</li>
    </ol>
  </aside>

  {{#with card}}
  <article class="r-cl-card">
    {{#if sym}}{{rSym sym "r-cl-watermark"}}{{/if}}
    <header class="r-cl-head">
      <span class="r-cl-bigmedal r-cr-medal">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
      <div class="r-cl-titles">
        <div class="r-cl-kicker">{{kicker}}</div>
        <h2>{{name}}</h2>
        {{#if nick}}<div class="r-cl-nick">«{{nick}}»</div>{{/if}}{{#if tag}}<div class="r-cl-nick">{{tag}}</div>{{/if}}
        {{#if en}}<div class="r-cl-en">{{en}}</div>{{/if}}
        {{!-- паспорт: короткие факты одной строкой под названием --}}
        {{#if passport.length}}<div class="r-cl-passport">{{#each passport}}<span><b>{{label}}</b> {{{value}}}</span>{{/each}}</div>{{/if}}
      </div>
    </header>

    {{!-- две колонки на широком окне: слева текст и строки, справа плашки и длинные факты; на узком — прежний порядок --}}
    <div class="r-cl-body">
      <div class="r-cl-main">
        {{!-- предание (data/line-lore.json) — как «О клане» у справочника кланов; ниже — правила записи --}}
        {{#if lore}}<section class="r-cl-sec r-cl-lore r-at-lore"><h3>{{localize "VTM20.Atlas.Lore"}}</h3>{{{lore}}}</section>{{/if}}
        {{#if text}}<section class="r-cl-sec r-at-text{{#if lore}} is-rules{{/if}}">{{#if lore}}<h3>{{localize "VTM20.Atlas.Features"}}</h3>{{/if}}{{{text}}}</section>{{/if}}
      </div>
      {{#if (or chips.length facts.length)}}
      <aside class="r-cl-aside">
        {{#if chips.length}}
        <section class="r-cl-sec"><div class="r-cl-discs">{{#each chips}}{{#if link}}<a class="r-cl-disc is-link" data-action="jump" data-key="{{link}}">{{#if sym}}{{rSym sym}}{{/if}}{{label}}</a>{{else}}<span class="r-cl-disc">{{#if sym}}{{rSym sym}}{{/if}}{{label}}</span>{{/if}}{{/each}}</div></section>
        {{/if}}
        {{#if facts.length}}
        <section class="r-cl-sec"><dl class="r-at-facts">{{#each facts}}<dt>{{label}}</dt><dd>{{{value}}}</dd>{{/each}}</dl></section>
        {{/if}}
      </aside>
      {{/if}}
      <div class="r-cl-rows">
    {{#each sections}}
    <section class="r-cl-sec">
      <h3>{{title}}{{#if sub}} <em class="r-at-sub">{{sub}}</em>{{/if}}{{#if n}} <b>{{n}}</b>{{/if}}</h3>
      {{#if plain}}
      <div class="r-at-rows">
        {{#each rows}}<div class="r-at-row">{{#if sym}}<span class="r-at-row-sym">{{rSym sym}}</span>{{/if}}<div><b>{{name}}</b>{{#if em}} <em>{{em}}</em>{{/if}}{{#if html}}<div class="r-at-row-text">{{{html}}}</div>{{/if}}</div></div>{{/each}}
      </div>
      {{else}}
      {{#each rows}}
      <details class="r-cl-trait" {{#if open}}open{{else}}name="r-atlas-trait"{{/if}}><summary><span>{{#if lvl}}<i class="r-at-lvl">{{lvl}}</i>{{/if}}{{name}}{{#if em}} <em>{{em}}</em>{{/if}}</span></summary>
        <div class="r-cl-trait-body">{{{html}}}</div>
      </details>
      {{/each}}
      {{/if}}
    </section>
    {{/each}}
      </div>
    </div>
  </article>
  {{/with}}
</div>
