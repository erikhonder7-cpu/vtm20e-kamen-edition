{{!-- Справочник линейки (маг, оборотень): слева — группы, поиск и список со знаками; справа — карточка. Разметка справочника кланов. --}}
<div class="r-cl">
  <aside class="r-cl-side">
    <div class="r-cl-groups">
      {{#each groups}}<a class="{{#if active}}is-active{{/if}}" data-action="group" data-group="{{key}}">{{label}} <b>{{n}}</b></a>{{/each}}
    </div>
    <label class="r-cl-find"><i class="fa-solid fa-magnifying-glass"></i><input type="search" class="r-cl-search" value="{{v.q}}" placeholder="{{localize 'VTM20.Atlas.Search'}}"></label>
    <ol class="r-cl-list">
      {{#each list}}
      <li class="r-cl-item" data-text="{{text}}">
        <a class="{{#if active}}is-active{{/if}}" data-action="pick" data-key="{{key}}">
          <span class="r-cl-medal r-cr-medal">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
          <span class="r-cl-name">{{name}}{{#if sub}}<em>{{sub}}</em>{{/if}}</span>
        </a>
      </li>
      {{/each}}
      <li class="r-cl-empty" hidden>{{localize "VTM20.Clans.Nothing"}}</li>
    </ol>
  </aside>

  {{#with card}}
  <article class="r-cl-card">
    {{#if sym}}{{rSym sym "r-cl-watermark"}}{{/if}}
    <header class="r-cl-head">
      <span class="r-cl-bigmedal r-cr-medal">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
      <div class="r-cl-titles">
        <div class="r-cl-kicker">{{kicker}}</div>
        <h2>{{name}}</h2>
        {{#if nick}}<div class="r-cl-nick">«{{nick}}»</div>{{/if}}
        {{#if en}}<div class="r-cl-en">{{en}}</div>{{/if}}
      </div>
    </header>

    {{#if text}}<section class="r-cl-sec r-at-text">{{{text}}}</section>{{/if}}

    {{#if chips.length}}
    <section class="r-cl-sec"><div class="r-cl-discs">{{#each chips}}<span class="r-cl-disc">{{#if sym}}{{rSym sym}}{{/if}}{{label}}</span>{{/each}}</div></section>
    {{/if}}

    {{#if facts.length}}
    <section class="r-cl-sec"><dl class="r-at-facts">{{#each facts}}<dt>{{label}}</dt><dd>{{value}}</dd>{{/each}}</dl></section>
    {{/if}}

    {{#each sections}}
    <section class="r-cl-sec">
      <h3>{{title}}{{#if sub}} <em class="r-at-sub">{{sub}}</em>{{/if}}{{#if n}} <b>{{n}}</b>{{/if}}</h3>
      {{#if plain}}
      <div class="r-at-rows">
        {{#each rows}}<div class="r-at-row">{{#if sym}}<span class="r-at-row-sym">{{rSym sym}}</span>{{/if}}<div><b>{{name}}</b>{{#if em}} <em>{{em}}</em>{{/if}}{{#if html}}<div class="r-at-row-text">{{{html}}}</div>{{/if}}</div></div>{{/each}}
      </div>
      {{else}}
      {{#each rows}}
      <details class="r-cl-trait" {{#if open}}open{{/if}}><summary><span>{{#if lvl}}<i class="r-at-lvl">{{lvl}}</i>{{/if}}{{name}}{{#if em}} <em>{{em}}</em>{{/if}}</span></summary>
        <div class="r-cl-trait-body">{{{html}}}</div>
      </details>
      {{/each}}
      {{/if}}
    </section>
    {{/each}}
  </article>
  {{/with}}
</div>
