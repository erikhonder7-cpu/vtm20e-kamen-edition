{{!-- Окно опыта (01) — на тех же элементах, что и лист: слева кошель опыта и разделы, справа черты строками «название … точки» с ценой. --}}
<div class="r-xp-app-body">
  <aside class="r-xw-side">
    <div class="r-assignat r-xw-purse">
      <div class="r-assignat-head">
        <span class="r-assignat-title">{{localize "VTM20.Xp.available"}}</span>
        <span class="r-assignat-num"><b>{{xp.available}}</b><small>/{{xp.total}}</small></span>
      </div>
      <div class="r-xw-bar" data-tooltip="{{localize 'VTM20.Xp.spent'}}: {{pct}}%"><i style="width: {{pct}}%"></i></div>
      <div class="r-assignat-meta"><span>{{localize "VTM20.Xp.spent"}} <b>{{xp.spent}}</b></span></div>
    </div>

    <nav class="r-xw-cats">
      {{#each cats}}
      <a class="r-xw-cat {{#if active}}is-active{{/if}}" data-action="cat" data-cat="{{key}}">
        <i class="fa-solid {{icon}}"></i><span>{{label}}</span>
        {{#if afford}}<em data-tooltip="{{localize 'VTM20.Xp.OnlyAffordable'}}">{{afford}}</em>{{else if count}}<small>{{count}}</small>{{/if}}
      </a>
      {{/each}}
    </nav>

    {{#if editable}}
    <div class="r-xw-grant">
      <h3 class="r-h3 r-colhead"><span>{{localize "VTM20.Xp.Add"}}</span></h3>
      <div class="r-xw-grant-row">
        <input type="number" name="amount" value="1" step="1" aria-label="{{localize 'VTM20.Xp.Add'}}">
        <a class="r-h2-btn" data-action="grant"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Xp.Grant"}}</a>
      </div>
      <input type="text" name="reason" placeholder="{{localize 'VTM20.Xp.reason'}}">
    </div>
    {{/if}}
  </aside>

  <main class="r-xw-main">
    {{#if train}}
    <div class="r-xp-list r-xw-list">
      <h2 class="r-h2"><span>{{localize "VTM20.Train.Head"}}</span></h2>
      <p class="r-note">{{localize "VTM20.Train.Lead"}}</p>
      <div class="r-xw-train">
        {{#each train}}
        <article class="r-vcard r-xw-tcard {{#unless ok}}is-dim{{/unless}}" data-train="{{ref}}">
          <header class="r-xw-thead">
            <b>{{label}}</b>
            <span class="r-dots">{{#each dots}}<span class="r-dot {{#if on}}is-filled{{/if}} {{#if next}}is-next{{/if}}"></span>{{/each}}</span>
          </header>
          {{#if ok}}
          <div class="r-xw-tline"><i class="fa-solid fa-coins"></i> {{localize "VTM20.Train.Cost" n=cost}} <small>{{why}}</small>{{#if bank}} · <span class="r-xw-bank">{{localize "VTM20.Train.Bank" n=bank}}</span>{{/if}}</div>
          {{/if}}
          <label class="r-xw-tline"><i class="fa-solid fa-chalkboard-user"></i>
            <input type="text" name="mentor" value="{{mentor}}" list="r-xw-mentors" placeholder="{{localize 'VTM20.Train.Mentor'}}" {{#unless @root.editable}}disabled{{/unless}}></label>
          {{#if mentorBg.length}}<div class="r-xw-tline"><small>{{#each mentorBg}}{{name}} {{value}}{{#unless @last}}, {{/unless}}{{/each}}</small></div>{{/if}}
          {{#if hasNights}}<div class="r-xw-tline"><i class="fa-solid fa-moon"></i> {{localize "VTM20.Train.Nights" n=nights}}</div>{{/if}}
          <p class="r-xw-tnote">{{note}}</p>
          {{#if @root.editable}}
          <footer class="r-vc-tools r-xw-ttools">
            {{#if ok}}<a class="r-btn {{#unless can}}is-off{{/unless}}" data-action="trainDone"><i class="fa-solid fa-graduation-cap"></i> {{localize "VTM20.Train.Finish" n=need}}</a>{{/if}}
            {{#if lore}}<a class="r-btn" data-action="trainRoll"><i class="fa-solid fa-dice-d10"></i> {{localize "VTM20.Train.Teacher"}}</a>{{/if}}
            <a class="r-icon-btn is-danger" data-action="trainDrop" data-tooltip="{{localize 'VTM20.Train.Drop'}}"><i class="fa-solid fa-xmark"></i></a>
          </footer>
          {{/if}}
        </article>
        {{else}}
        <p class="r-empty">{{localize "VTM20.Train.Empty"}}</p>
        {{/each}}
      </div>
    </div>
    {{else if history}}
    <div class="r-xp-list r-xw-list">
      <h2 class="r-h2"><span>{{localize "VTM20.Xp.History"}}</span></h2>
      <ol class="r-xw-hist">
        {{#each log}}<li class="{{#if spend}}is-spend{{else}}is-gain{{/if}}"><b>{{#if spend}}−{{else}}+{{/if}}{{abs}}</b><span>{{#if reason}}{{reason}}{{else}}—{{/if}}</span><small>{{date}}</small></li>
        {{else}}<li class="r-empty">{{localize "VTM20.Xp.Nothing"}}</li>{{/each}}
      </ol>
    </div>
    {{else}}
    <header class="r-xw-top">
      <label class="r-cl-find r-xw-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" class="r-xp-search-input" value="{{query}}" placeholder="{{localize 'VTM20.Xp.Search'}}"></label>
      <a class="r-h2-btn {{#if onlyAffordable}}is-on{{/if}}" data-action="filter"><i class="fa-solid {{#if onlyAffordable}}fa-square-check{{else}}fa-square{{/if}}"></i> {{localize "VTM20.Xp.OnlyAffordable"}}</a>
    </header>
    <div class="r-xp-list r-xw-list">
      {{#each groups}}
      <section class="r-xp-sec">
        <h2 class="r-h2"><span>{{label}}</span></h2>
        <div class="r-xw-cols">
          {{#each rows}}
          <div class="r-xp-item r-trait r-xw-row {{#unless can}}is-dim{{/unless}} {{#if flash}}is-flash{{/if}}" data-search="{{search}}">
            <div class="r-trait-main">
              <span class="r-trait-label">{{label}}</span>
              <span class="r-leader"></span>
              <span class="r-dots">{{#each dots}}<span class="r-dot {{#if on}}is-filled{{/if}} {{#if next}}is-next{{/if}}"></span>{{/each}}</span>
              <a class="r-h2-btn r-xw-buy {{#unless can}}is-off{{/unless}}" {{#if @root.editable}}data-action="buy"{{/if}} data-ref="{{ref}}" data-label="{{label}}"
                 data-tooltip="{{#if isNew}}{{localize 'VTM20.Xp.New'}}{{else}}{{cur}} → {{next}}{{/if}}<br>{{why}}{{#if short}}<br>{{localize 'VTM20.Xp.Short' n=short}}{{/if}}">
                <i class="fa-solid {{#if can}}fa-plus{{else}}fa-lock{{/if}}"></i><b>{{cost}}</b>
              </a>
              {{#if @root.editable}}<a class="r-icon-btn r-xw-plan {{#if planned}}is-on{{/if}}" data-action="plan" data-ref="{{ref}}" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Train.PlanHint'}}"><i class="fa-solid fa-graduation-cap"></i></a>{{/if}}
            </div>
          </div>
          {{/each}}
        </div>
      </section>
      {{else}}
      <p class="r-empty">{{localize "VTM20.Xp.Nothing"}}</p>
      {{/each}}
    </div>
    {{/if}}
  </main>
</div>
