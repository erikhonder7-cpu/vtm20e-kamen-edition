{{!-- Дисциплина: точки, клановая, силы по уровням (из справочника), правила и описание. --}}
<div class="r-item-sheet is-discipline">
  {{> rItemHead}}
  <div class="r-item-body">
    <div class="r-item-level">
      {{> rDots dots=dots cls="is-disc"}}
      <label class="r-f-check r-item-clan"><input type="checkbox" name="system.inClan" {{checked system.inClan}}><span>{{localize "VTM20.Sheet.InClan"}}</span></label>
    </div>

    {{#if powers.length}}
    <h2 class="r-h2"><span>{{localize "VTM20.ItemSheet.Powers"}}</span></h2>
    <div class="r-item-powers">
      {{#each powers}}
      <details class="r-ipower {{#if owned}}is-owned{{else}}is-locked{{/if}} {{#if next}}is-next{{/if}}">
        <summary><span class="r-power-lvl">{{roman}}</span><span class="r-ipower-name">{{name}}{{#if en}} <em>{{en}}</em>{{/if}}</span>
          {{#if pool}}<span class="r-power-pool">{{pool}}</span>{{/if}}</summary>
        <div class="r-ipower-body">{{{html}}}</div>
      </details>
      {{/each}}
    </div>
    {{/if}}

    {{#if rules}}
    <details class="r-item-setup is-text">
      <summary><i class="fa-solid fa-book"></i> {{localize "VTM20.ItemSheet.Rules"}}</summary>
      <div class="r-ipower-body">{{{rules}}}</div>
    </details>
    {{/if}}

    <details class="r-item-setup is-text" {{#unless powers.length}}open{{/unless}}>
      <summary><i class="fa-solid fa-feather-pointed"></i> {{localize "VTM20.Item.description"}}</summary>
      <div class="r-editor r-item-text">
        <prose-mirror name="system.description" value="{{system.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
      </div>
    </details>

    <details class="r-item-setup">
      <summary><i class="fa-solid fa-sliders"></i> {{localize "VTM20.ItemSheet.Setup"}}</summary>
      <div class="r-fields is-wide">
        <label class="r-f"><span>{{localize "VTM20.Item.discipline"}}</span>
          <select name="system.key">{{#each disciplineOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.Item.value"}}</span><input type="number" name="system.value" value="{{system.value}}" min="0" max="10"></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.Item.source"}}</span><input type="text" name="system.source" value="{{system.source}}"></label>
      </div>
    </details>
  </div>
</div>
