{{!-- Ритуал падших: Знания (первичное — у Анкиды, вторичные — у Маду), цена, время, бросок эффекта; текст, высокая Мука, варианты; поля — в «Настройках». --}}
<div class="r-item-sheet is-ritual is-demon-ritual">
  {{> rItemHead}}
  <div class="r-item-body">
    {{!-- печать ритуала: Знания чипами, факты строкой, сколько успехов нужно --}}
    <div class="r-rite-sheet">
      <span class="r-rite-seal is-big"><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17"/><circle cx="20" cy="20" r="12.5"/>
        <path d="M20 3 L34.7 28.5 H5.3 Z"/><path d="M20 37 L5.3 11.5 H34.7 Z"/></svg><b>{{totalDots}}</b></span>
      <div class="r-rite-sheet-main">
        <span class="r-rite-chips">{{#each loreChips}}<span class="r-lchip {{#if primary}}is-primary{{/if}}">{{name}} <i>{{dots}}</i></span>{{/each}}</span>
        <div class="r-rite-facts">
          {{#if houseName}}<span data-tooltip="{{localize 'VTM20.DRitual.House'}}"><i class="fa-solid fa-fire-flame-curved"></i>{{houseName}}</span>{{/if}}
          {{#if system.time}}<span data-tooltip="{{localize 'VTM20.DRitual.Time'}}"><i class="fa-solid fa-clock"></i>{{system.time}}</span>{{/if}}
          <span data-tooltip="{{localize 'VTM20.DRitual.Cost'}}"><i class="fa-solid fa-star"></i>{{system.cost}} {{localize "VTM20.Demon.XpShort"}}</span>
          <span data-tooltip="{{localize 'VTM20.ItemSheet.Roll'}}"><i class="fa-solid fa-dice-d10"></i>{{#if pool}}{{pool}}{{else if system.rollText}}{{system.rollText}}{{else}}—{{/if}}{{#if system.roll.difficulty}} · {{localize "VTM20.Roll.Vs"}} {{system.roll.difficulty}}{{/if}}</span>
        </div>
        {{#if system.limits}}<div class="r-rite-facts"><span data-tooltip="{{localize 'VTM20.DRitual.Limits'}}"><i class="fa-solid fa-moon"></i>{{system.limits}}</span></div>{{/if}}
        <p class="r-rite-need">{{localize "VTM20.DRitual.NeedText" n=totalDots}}</p>
      </div>
    </div>
    {{#if book}}<p class="r-item-src">{{localize "VTM20.Item.source"}}: {{book}}</p>{{/if}}

    <h2 class="r-h2"><span>{{localize "VTM20.DRitual.Effect"}}</span></h2>
    <div class="r-editor r-item-text">
      <prose-mirror name="system.description" value="{{system.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
    </div>
    {{#if system.high}}<div class="r-rite-note is-high"><b>{{localize "VTM20.DRitual.High"}}</b>{{system.high}}</div>{{/if}}
    {{#if system.variants}}<div class="r-rite-note is-var"><b>{{localize "VTM20.DRitual.Variants"}}</b>{{system.variants}}</div>{{/if}}

    <details class="r-item-setup">
      <summary><i class="fa-solid fa-sliders"></i> {{localize "VTM20.ItemSheet.Setup"}}</summary>
      <div class="r-fields is-wide">
        <label class="r-f"><span>{{localize "VTM20.DRitual.Primary"}}</span>
          <select name="system.primary.key"><option value="">—</option>{{#each primaryOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.Item.level"}}</span><input type="number" name="system.primary.level" value="{{system.primary.level}}" min="1" max="5"></label>
        {{#each secondarySlots}}
        <label class="r-f"><span>{{localize "VTM20.DRitual.Secondary"}} {{n}}</span>
          <select name="secondary.{{i}}.key"><option value="">—</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.Item.level"}}</span><input type="number" name="secondary.{{i}}.level" value="{{level}}" min="1" max="5"></label>
        {{/each}}
        <label class="r-f"><span>{{localize "VTM20.DRitual.House"}}</span>
          <select name="system.house">{{#each houseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.DRitual.Cost"}}</span><input type="number" name="system.cost" value="{{system.cost}}" min="0"></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.DRitual.Time"}}</span><input type="text" name="system.time" value="{{system.time}}"></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.DRitual.Limits"}}</span><input type="text" name="system.limits" value="{{system.limits}}"></label>
        <label class="r-f"><span>{{localize "VTM20.Item.trait1"}}</span>
          <select name="system.roll.trait1"><option value="">—</option>{{#each traitGroups.t1}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.Item.trait2"}}</span>
          <select name="system.roll.trait2"><option value="">—</option>{{#each traitGroups.t2}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</optgroup>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.Roll.Difficulty"}}</span><input type="number" name="system.roll.difficulty" value="{{system.roll.difficulty}}" min="0" max="10"></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.DRitual.High"}}</span><textarea name="system.high" rows="2">{{system.high}}</textarea></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.DRitual.Variants"}}</span><textarea name="system.variants" rows="2">{{system.variants}}</textarea></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.Item.source"}}</span><input type="text" name="system.source" value="{{system.source}}"></label>
      </div>
    </details>
  </div>
</div>
