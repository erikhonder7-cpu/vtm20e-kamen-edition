{{!-- Реликвия падших: вид, Знания мастера, как пользоваться, описание и система; поля — в «Настройках». --}}
<div class="r-item-sheet is-relic">
  {{> rItemHead}}
  <div class="r-item-body">
    <div class="r-rite-sheet">
      <span class="r-rite-seal is-gem is-big"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 L33 14 L20 36 L7 14 Z"/><path d="M7 14 H33 M14 14 L20 36 L26 14 M14 14 L20 4 L26 14"/></svg></span>
      <div class="r-rite-sheet-main">
        <span class="r-rite-chips"><span class="r-kindtag">{{kindLabel}}</span>{{#if houseName}}<span class="r-lchip is-house">{{houseName}}</span>{{/if}}{{#each loreChips}}<span class="r-lchip">{{this}}</span>{{/each}}</span>
        {{#if system.use}}<div class="r-rite-facts"><span data-tooltip="{{localize 'VTM20.Relic.Use'}}"><i class="fa-solid fa-hand-sparkles"></i>{{system.use}}</span></div>{{/if}}
      </div>
    </div>
    {{#if book}}<p class="r-item-src">{{localize "VTM20.Item.source"}}: {{book}}</p>{{/if}}

    <h2 class="r-h2"><span>{{localize "VTM20.Item.description"}}</span></h2>
    <div class="r-editor r-item-text">
      <prose-mirror name="system.description" value="{{system.description}}" toggled {{#unless editable}}disabled{{/unless}}>{{{descriptionHTML}}}</prose-mirror>
    </div>
    {{#if system.mechanics}}<div class="r-rite-note is-sys"><b>{{localize "VTM20.Relic.Mechanics"}}</b>{{system.mechanics}}</div>{{/if}}

    <details class="r-item-setup">
      <summary><i class="fa-solid fa-sliders"></i> {{localize "VTM20.ItemSheet.Setup"}}</summary>
      <div class="r-fields is-wide">
        <label class="r-f"><span>{{localize "VTM20.Relic.KindLabel"}}</span>
          <select name="system.kind">{{#each kindOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-f"><span>{{localize "VTM20.DRitual.House"}}</span>
          <select name="system.house">{{#each houseOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#each loreSlots}}
        <label class="r-f"><span>{{localize "VTM20.Relic.Lore"}} {{n}}</span>
          <select name="lores.{{i}}"><option value="">—</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{/each}}
        <label class="r-f is-span2"><span>{{localize "VTM20.Relic.Use"}}</span><input type="text" name="system.use" value="{{system.use}}"></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.Relic.Mechanics"}}</span><textarea name="system.mechanics" rows="3">{{system.mechanics}}</textarea></label>
        <label class="r-f is-span2"><span>{{localize "VTM20.Item.source"}}</span><input type="text" name="system.source" value="{{system.source}}"></label>
      </div>
    </details>
  </div>
</div>
