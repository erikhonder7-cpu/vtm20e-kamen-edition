{{!-- Подменыш (C20, гл. 4): Искусства с уровнями (химерический / Вирд), Царства — на что направлен кантрип (module/apps/changeling.mjs) --}}
<section class="tab r-pane r-edges r-cl-pane {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{!-- Грёза (C20, гл. 6): три Темпера рядом — Гламур (рейтинг точками, пул клетками), Банальность (рейтинг и пул; пул выше Гламура —
       Туманы), Кошмар (10 — Дисбаланс); ниже — действия с подписями, дросс, отметки и кнопки ведущего (module/apps/changeling.mjs) --}}
  {{#unless (or hsien daf)}}
  <div class="r-cl-dream {{#if changelingInfo.mists}}is-mists{{/if}} {{#if changelingInfo.bedlam}}is-bedlam{{/if}}">
    <div class="r-cl-temper is-glamour">
      <div class="r-cl-temper-head"><h4 class="r-banner">{{localize "VTM20.Changeling.Glamour"}}</h4></div>
      {{> rDots dots=changelingInfo.glamourDots cls="is-ten is-glamour"}}
      <div class="r-boxes is-glamour">{{#each changelingInfo.glamourBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
    </div>
    <div class="r-cl-temper is-banality">
      <div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Changeling.BanalityHint'}}">{{localize "VTM20.Changeling.Banality"}}</h4>
        <span class="r-cl-temper-num">{{#if changelingInfo.mists}}<small class="is-warn" data-tooltip="{{localize 'VTM20.Changeling.BanalityPoolHint'}}">{{localize "VTM20.Changeling.Mists"}}</small>{{/if}}</span></div>
      {{> rDots dots=changelingInfo.banalityDots cls="is-ten is-banality"}}
      <div class="r-boxes is-banality">{{#each changelingInfo.banalityBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
    </div>
    <div class="r-cl-temper is-nightmare">
      <div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Changeling.NightmareHint'}}">{{localize "VTM20.Changeling.Nightmare"}}</h4>
        <span class="r-cl-temper-num">{{#if changelingInfo.imbalance}}<small class="is-warn" data-tooltip="{{localize 'VTM20.Changeling.ImbalanceHint'}}">{{localize "VTM20.Changeling.Imbalance"}} {{changelingInfo.imbalance}}</small>{{/if}}</span></div>
      <div class="r-boxes is-nightmare">{{#each changelingInfo.nightmareBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
      <div class="r-cl-states">
        <span class="r-cl-state is-dross" data-tooltip="{{localize 'VTM20.Changeling.DrossHint'}}"><i class="fa-solid fa-gem"></i> {{changelingInfo.dross}}{{#if editable}} <a data-action="clDross" data-d="-1"><i class="fa-solid fa-minus"></i></a><a data-action="clDross" data-d="1"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
        {{#if changelingInfo.wyrd}}<span class="r-cl-state is-wyrd" data-tooltip="{{localize 'VTM20.Changeling.WyrdHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Changeling.WyrdChip"}}</span>{{/if}}
        {{#if changelingInfo.threshold}}<span class="r-cl-state is-bedlam" data-tooltip="{{changelingInfo.threshold.name}}: {{changelingInfo.threshold.text}}"><i class="fa-solid fa-masks-theater"></i> {{changelingInfo.threshold.n}}
          {{#if changelingInfo.isGM}}<a data-action="clBedlamEnd" data-tooltip="{{localize 'VTM20.Changeling.BedlamEnd'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>{{/if}}
        {{#if changelingInfo.place}}<span class="r-cl-state is-place" data-tooltip="{{localize 'VTM20.Changeling.PlaceHint'}}"><i class="fa-solid fa-building"></i> {{changelingInfo.place}}</span>{{/if}}
      </div>
    </div>
    {{#if editable}}<div class="r-cl-dream-bar">
      <a class="r-btn" data-action="clGlamour" data-d="-1" data-tooltip="{{localize 'VTM20.Changeling.SpendGlamour'}}"><i class="fa-solid fa-minus"></i> {{localize "VTM20.Changeling.Glamour"}}</a>
      <a class="r-btn" data-action="clGlamour" data-d="1" data-tooltip="{{localize 'VTM20.Changeling.GainGlamour'}}"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Changeling.Glamour"}}</a>
      {{#unless lykeian}}<a class="r-btn" data-action="clEpiphany" data-tooltip="{{localize 'VTM20.Changeling.Epi.Hint'}}"><i class="fa-solid fa-lightbulb"></i> {{localize "VTM20.Changeling.Epi.Short"}}</a>
      <a class="r-btn {{#if changelingInfo.wyrd}}is-active{{/if}}" data-action="clWyrd" data-tooltip="{{localize 'VTM20.Changeling.WyrdHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Changeling.WyrdChip"}}</a>{{/unless}}
      <a class="r-btn" data-action="clAutumn" data-tooltip="{{localize 'VTM20.Changeling.AutumnHint'}}"><i class="fa-solid fa-leaf"></i> {{localize "VTM20.Changeling.AutumnShort"}}</a>
      <a class="r-btn" data-action="clTrigger" data-tooltip="{{localize 'VTM20.Changeling.TriggerHint'}}"><i class="fa-solid fa-snowflake"></i> {{localize "VTM20.Changeling.TriggerShort"}}</a>
      <a class="r-btn" data-action="clNightmare" data-d="1" data-tooltip="{{localize 'VTM20.Changeling.NightmarePlus'}}"><i class="fa-solid fa-moon"></i> {{localize "VTM20.Changeling.Nightmare"}} +1</a>
      {{#if changelingInfo.isGM}}<span class="r-cl-gm"><a class="r-vc-btn is-sq" data-action="clMists" data-tooltip="{{localize 'VTM20.Changeling.MistsT.Title'}}"><i class="fa-solid fa-smog"></i></a>
        <a class="r-vc-btn is-sq" data-action="clQuest" data-tooltip="{{localize 'VTM20.Changeling.Quest.Hint'}}"><i class="fa-solid fa-flag"></i></a>
        <a class="r-vc-btn is-sq" data-action="clPlace" data-tooltip="{{localize 'VTM20.Changeling.PlaceBanality'}}"><i class="fa-solid fa-building"></i></a></span>{{/if}}
    </div>{{/if}}
  </div>
  {{/unless}}
  {{#if lykeian}}
  {{!-- Ликиец (C20 Players Guide, гл. 7): Облик и Форма, Благословения и Недуг, Реды вместо Искусств (apps/lykeian.mjs) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Lykeian.GuiseHead"}}</span>
    {{#if editable}}<span class="r-h2-tools">
      <a class="r-h2-btn" data-action="lyAct" data-op="legacy" data-tooltip="{{localize 'VTM20.Lykeian.LegacyHint'}}"><i class="fa-solid fa-star"></i> <span class="r-h2-lbl">{{localize "VTM20.Lykeian.LegacyShort"}}</span></a>
      <a class="r-h2-btn" data-action="lyAct" data-op="shed" data-tooltip="{{localize 'VTM20.Lykeian.ShedHint'}}"><i class="fa-solid fa-snowflake"></i></a>
      <a class="r-h2-btn" data-action="lyAct" data-op="cure" data-tooltip="{{localize 'VTM20.Lykeian.CureHint'}}"><i class="fa-solid fa-scale-balanced"></i></a>
      <a class="r-h2-btn" data-action="lyAct" data-op="reap" data-tooltip="{{localize 'VTM20.Lykeian.ReapHint'}}"><i class="fa-solid fa-skull"></i></a>
    </span>{{/if}}</h2>
  <div class="r-cl-arts r-ly-guise">
    {{#if lykeian.guise}}<article class="r-vcard r-cl-art">
      <header class="r-cl-art-head"><div class="r-cl-art-title"><b class="r-cl-art-name">{{lykeian.guise.name}}</b><span class="r-cl-art-en">{{lykeian.guise.en}} · {{lykeian.guise.theme}}</span></div></header>
      <p class="r-note">{{lykeian.guise.text}}</p>
      {{#each lykeian.guise.blessings}}<p class="r-note"><b>{{name}}</b> <em>{{en}}</em> — {{text}}</p>{{/each}}
      {{#if lykeian.guise.frailty}}<div class="r-weakness-text"><b>{{localize "VTM20.Lykeian.Frailty"}}: {{lykeian.guise.frailty.name}}</b> — {{lykeian.guise.frailty.text}}</div>{{/if}}
      {{#if lykeian.maieutic}}<label class="r-check" data-tooltip="{{localize 'VTM20.Lykeian.RivalHint'}}"><input type="checkbox" name="system.changeling.lykeian.rival" {{#if lykeian.rival}}checked{{/if}}> {{localize "VTM20.Lykeian.Rival"}}</label>{{/if}}
      {{#if lykeian.panic}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "VTM20.Lykeian.PanicNote"}}</p>{{/if}}
    </article>{{else}}<p class="r-gs-empty">{{localize "VTM20.Lykeian.NoGuise"}}</p>{{/if}}
    {{#if lykeian.shape}}<article class="r-vcard r-cl-art">
      <header class="r-cl-art-head"><div class="r-cl-art-title"><b class="r-cl-art-name">{{lykeian.shape.name}}</b><span class="r-cl-art-en">{{lykeian.shape.en}}</span></div></header>
      <p class="r-note">{{lykeian.shape.text}}</p>
      {{#if lykeian.nightmareLegacy}}<p class="r-note"><b>{{localize "VTM20.Lykeian.NightmareLegacy"}}:</b> {{lykeian.nightmareLegacy.name}}{{#if lykeian.nightmareLegacy.ban}} — {{lykeian.nightmareLegacy.ban}}{{/if}}</p>{{/if}}
      <p class="r-note {{#if lykeian.lost}}is-warn{{/if}}" data-tooltip="{{localize 'VTM20.Lykeian.ImbalanceHint'}}"><i class="fa-solid fa-masks-theater"></i> {{localize "VTM20.Lykeian.ImbalanceGlamour" n=lykeian.imbalance g=lykeian.glamourPerm}}</p>
    </article>{{/if}}
  </div>
  <h2 class="r-h2"><span>{{localize "VTM20.Lykeian.Redes"}}</span>
    <span class="r-h2-tools"><span class="r-gs-pool {{#if lykeian.over}}is-warn{{/if}}" data-tooltip="{{localize 'VTM20.Lykeian.RedesHint'}}"><i class="fa-solid fa-dragon"></i> {{lykeian.pts}} / {{lykeian.budget}}</span></span></h2>
  {{#if editable}}<div class="r-toolbar r-cl-add">
    <a class="r-btn is-lib" data-action="library" data-kind="rede" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Lykeian.AddRede"}}</a>
  </div>{{/if}}
  <div class="r-cl-oaths">
    {{#each lykeian.redes}}<article class="r-vcard r-cl-oath">
      <header><b>{{name}}</b> <em>{{en}}</em>
        <span class="r-cl-oath-tools"><input class="r-ly-pts" type="number" min="0" max="30" name="system.changeling.lykeian.redes.{{i}}.pts" value="{{pts}}" {{#unless @root.editable}}disabled{{/unless}} data-tooltip="{{localize 'VTM20.Lykeian.Pts'}}">
        {{#if @root.editable}}<a data-action="lyAct" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span></header>
      <p class="r-note">{{text}}</p>
    </article>{{/each}}
  </div>
  {{else if hsien}}
  {{!-- Хсиен (C20, гл. 39): Чи Инь и Ян, Дао, Ранг, Югэн; школы Ву Тань и Ней Тань (module/apps/fae-variants.mjs) --}}
  <div class="r-cl-dream r-hs-panel">
    <div class="r-cl-temper"><div class="r-cl-temper-head"><h4 class="r-banner">{{localize "VTM20.Fae.Hsien.Yin"}}</h4></div>{{> rDots dots=hsien.yinDots}}</div>
    <div class="r-cl-temper"><div class="r-cl-temper-head"><h4 class="r-banner">{{localize "VTM20.Fae.Hsien.Yang"}}</h4></div>{{> rDots dots=hsien.yangDots}}</div>
    <div class="r-cl-temper"><div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Fae.Hsien.YugenHint'}}">{{localize "VTM20.Fae.Hsien.Yugen"}}</h4></div>
      <div class="r-boxes is-glamour">{{#each hsien.yugenBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div></div>
    <p class="r-note r-hs-derived">{{localize "VTM20.Fae.Hsien.Derived" rank=hsien.rank tao=hsien.tao dom=hsien.dominant}}</p>
    {{#if editable}}<div class="r-cl-dream-bar">
      <a class="r-btn" data-action="clFae" data-op="wutan"><i class="fa-solid fa-yin-yang"></i> {{localize "VTM20.Fae.Hsien.WuTan"}}</a>
      <a class="r-btn" data-action="clFae" data-op="neitan"><i class="fa-solid fa-circle-half-stroke"></i> {{localize "VTM20.Fae.Hsien.School.neitan"}}</a>
      <a class="r-btn" data-action="clFae" data-op="mask" data-tooltip="{{localize 'VTM20.Fae.Hsien.MaskHint'}}"><i class="fa-solid fa-dragon"></i> {{localize "VTM20.Fae.Hsien.MaskTitle"}}</a>
      <a class="r-btn" data-action="clFae" data-op="chi" data-tooltip="{{localize 'VTM20.Fae.Hsien.SacrificeHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Fae.Hsien.Sacrifice"}}</a>
    </div>{{/if}}
  </div>
  <h2 class="r-h2"><span>{{localize "VTM20.Fae.Hsien.WuTan"}}</span></h2>
  <div class="r-cl-realms">
    {{#each hsien.schools}}<div class="r-vcard r-cl-realm {{#if capped}}is-mod{{/if}}">
      <div class="r-vc-head">{{#if sym}}<span class="r-clr-glyph r-hs-glyph">{{rSym sym}}</span>{{/if}}<h4 class="r-banner">{{#if @root.editable}}<a data-action="clFae" data-op="{{#if (eq key 'neitan')}}neitan{{else}}wutan{{/if}}" data-key="{{key}}">{{name}}</a>{{else}}{{name}}{{/if}}</h4>{{> rDots dots=dots cls="is-small"}}</div>
      <p class="r-note">{{element}}{{#if capped}} · <span class="is-warn">{{localize "VTM20.Fae.Hsien.NeiCapped" cap=../hsien.neiCap}}</span>{{/if}}</p>
    </div>{{/each}}
  </div>
  <p class="r-hint">{{localize "VTM20.Fae.Hsien.Hint"}}</p>
  {{else if daf}}
  {{!-- Dark Ages: Fae: Мгла и Плетение вместо Грёзы, Эхо; четыре Домена с кантрипами книги (module/apps/dark-fae.mjs) --}}
  <div class="r-cl-dream r-daf-panel">
    <div class="r-cl-temper is-glamour"><div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Fae.Daf.MistsHint'}}">{{localize "VTM20.Fae.Daf.Mists"}}</h4></div>
      {{> rDots dots=daf.mistsDots cls="is-ten is-glamour"}}
      <div class="r-boxes is-glamour">{{#each daf.mistsBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div></div>
    <div class="r-cl-temper is-banality"><div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Fae.Daf.WeavingHint'}}">{{localize "VTM20.Fae.Daf.Weaving"}}</h4></div>
      {{> rDots dots=daf.weavingDots cls="is-ten is-banality"}}
      <div class="r-boxes is-banality">{{#each daf.weavingBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div></div>
    <div class="r-cl-temper is-nightmare"><div class="r-cl-temper-head"><h4 class="r-banner" data-tooltip="{{localize 'VTM20.Fae.Daf.EchoesHint'}}">{{localize "VTM20.Fae.Daf.Echoes"}}</h4>
      <span class="r-cl-temper-num">{{#if editable}}<input class="r-ly-pts" type="number" min="0" max="20" name="system.changeling.daf.echoes" value="{{daf.echoes}}">{{else}}<b>{{daf.echoes}}</b>{{/if}}</span></div>
      {{#if daf.imbalance}}<p class="r-note is-warn">{{localize (concat "VTM20.Fae.Daf.Imbalance." daf.imbalance)}}</p>{{/if}}
      {{#if daf.origin}}<p class="r-note">{{daf.origin.name}}: {{localize "VTM20.Fae.Daf.UnleashDice" n=daf.unleashDice}}</p>{{/if}}
    </div>
    {{#if editable}}<div class="r-cl-dream-bar">
      <a class="r-btn" data-action="clDaf" data-op="origin" data-tooltip="{{localize 'VTM20.Fae.Daf.OriginHint'}}"><i class="fa-solid fa-seedling"></i> {{localize "VTM20.Fae.Daf.OriginStart"}}</a>
      <a class="r-btn" data-action="clDaf" data-op="iron" data-tooltip="{{localize 'VTM20.Fae.Daf.IronHint'}}"><i class="fa-solid fa-khanda"></i> {{localize "VTM20.Changeling.ColdIronShort"}}</a>
      {{#if isGM}}<span class="r-cl-gm"><a class="r-btn" data-action="clDaf" data-op="echo" data-tooltip="{{localize 'VTM20.Fae.Daf.EchoHint'}}"><i class="fa-solid fa-bell"></i> {{localize "VTM20.Fae.Daf.EchoTitle"}}</a></span>{{/if}}
    </div>{{/if}}
  </div>
  <h2 class="r-h2"><span>{{localize "VTM20.Fae.Daf.Dominions"}}</span></h2>
  <div class="r-daf-doms">
    {{#each daf.dominions}}<article class="r-vcard r-daf-dom is-{{key}} {{#if favorite}}is-favorite{{/if}}">
      <header class="r-cl-art-head">
        <div class="r-cl-art-title"><b class="r-cl-art-name">{{name}}</b><span class="r-cl-art-en">{{#if favorite}}{{localize "VTM20.Fae.Daf.Favorite"}} · {{/if}}{{localize "VTM20.Fae.Daf.Known" n=count max=limit}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}{{#if value}}<a class="r-icon-btn" data-action="clDaf" data-op="unleash" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Fae.Daf.UnleashHint'}}"><i class="fa-solid fa-burst"></i></a>{{/if}}{{/if}}
      </header>
      <ul class="r-cl-levels">
        {{#each cantrips}}<li><span class="r-cl-rank">{{level}}</span><a class="r-cl-lvl-name" {{#if @root.editable}}data-action="clDaf" data-op="cast" data-key="{{id}}"{{/if}} data-tooltip="{{params}} — {{text}}"><b>{{name}}</b> <em>{{trait}}</em></a>
          {{#if @root.editable}}<a class="r-cl-forget" data-action="clDaf" data-op="forget" data-key="{{id}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
        {{/each}}
      </ul>
      {{#if @root.editable}}{{#if avail.length}}<div class="r-toolbar r-cl-add"><a class="r-btn is-lib" data-action="library" data-kind="cantrip" data-discipline="{{key}}" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Fae.Daf.Learn"}}</a></div>{{/if}}{{/if}}
    </article>{{/each}}
  </div>
  <p class="r-hint">{{localize "VTM20.Fae.Daf.Hint"}}</p>
  {{else if inan}}
  {{!-- Инанимае (C20, гл. 40): Слайверы вместо Искусств — только Высвобождение; Сбор, Жатва, Оболочка, Якорь --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Fae.Inan.Slivers"}}</span>{{#if editable}}<span class="r-h2-tools">
    <a class="r-h2-btn" data-action="clFae" data-op="harvest" data-tooltip="{{localize 'VTM20.Fae.Inan.HarvestHint'}}"><i class="fa-solid fa-seedling"></i> <span class="r-h2-lbl">{{localize "VTM20.Fae.Inan.HarvestTitle"}}</span></a>
    <a class="r-h2-btn" data-action="clFae" data-op="reap" data-tooltip="{{localize 'VTM20.Fae.Inan.ReapHint'}}"><i class="fa-solid fa-hand-fist"></i></a>
    <a class="r-h2-btn" data-action="clFae" data-op="husk" data-tooltip="{{localize 'VTM20.Fae.Inan.HuskHint'}}"><i class="fa-solid fa-person"></i></a>
    <a class="r-h2-btn" data-action="clFae" data-op="rebind" data-tooltip="{{localize 'VTM20.Fae.Inan.RebindHint'}}"><i class="fa-solid fa-anchor"></i></a>
  </span>{{/if}}</h2>
  {{#if editable}}<label class="r-check r-in-lost"><input type="checkbox" name="system.changeling.inanimae.anchorLost" {{#if inan.anchorLost}}checked{{/if}}> {{localize "VTM20.Fae.Inan.AnchorLost"}}</label>{{/if}}
  {{#if inan.anchorLost}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "VTM20.Fae.Inan.AnchorLostNote"}}</p>{{/if}}
  <div class="r-cl-arts">
    {{#each inan.slivers}}<article class="r-vcard r-cl-art {{#if affinity}}is-affinity{{/if}}">
      <header class="r-cl-art-head">
        <div class="r-cl-art-title"><b class="r-cl-art-name">{{name}}</b><span class="r-cl-art-en">{{en}}{{#if affinity}} · {{localize "VTM20.Fae.Inan.Affinity"}}{{/if}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}{{#if value}}<a class="r-icon-btn" data-action="clFae" data-op="sliver" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Changeling.UnleashHint'}}"><i class="fa-solid fa-burst"></i></a>{{/if}}{{/if}}
      </header>
      <p class="r-note">{{text}}</p>
      {{#if perk}}<p class="r-note"><b>{{localize "VTM20.Fae.Inan.Perk"}}:</b> {{perk}}</p>{{/if}}
    </article>{{/each}}
  </div>
  <p class="r-hint">{{localize "VTM20.Fae.Inan.Hint"}}</p>
  {{else}}
  {{!-- Искусства (C20, гл. 4): «витражи» — знак Искусства медальоном (щелчок — кантрип), имя и точки; карточка сворачивается,
       как Дисциплина. Лестница из пяти кантрипов: щелчок по имени раскрывает правила, кубик — бросок (только известные);
       Высвобождение и обряды-условия — разделами внизу раскрытой карточки --}}
  <div class="r-cla-head">
    <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Arts"}}</span></h2>
    <span class="r-cla-pool" data-tooltip="{{localize 'VTM20.Changeling.CantripRule' nm=cl.nightmare}}"><i class="fa-solid fa-star"></i> <b>{{cl.glamour}}</b> <i class="fa-solid fa-moon"></i> <b>{{cl.nightmare}}</b></span>
    {{#if cl.own.length}}<a class="r-h2-btn is-plain" data-action="toggleAll"><i class="fa-solid {{#if cl.allOpen}}fa-angles-up{{else}}fa-angles-down{{/if}}"></i> <span class="r-h2-lbl">{{#if cl.allOpen}}{{localize "VTM20.Sheet.CollapseAll"}}{{else}}{{localize "VTM20.Sheet.ExpandAll"}}{{/if}}</span></a>{{/if}}
    {{#if editable}}<a class="r-cla-btn is-main" data-action="clCast"><i class="fa-solid fa-wand-sparkles"></i> {{localize "VTM20.Changeling.Cantrip"}}</a>
    <a class="r-cla-btn" data-action="library" data-kind="art"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Changeling.AddArt"}}</a>{{/if}}
  </div>
  <div class="r-cla-grid">
    {{#each cl.own}}
    <article class="r-row-wrap r-cla-art {{#if open}}is-open{{/if}}">
      <a class="r-cla-glyph" data-action="clCast" data-art="{{key}}" data-tooltip="{{localize 'VTM20.Changeling.CastArt'}}">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</a>
      <header class="r-cla-title">
        <a class="r-cla-name" data-action="toggleRow" data-row-id="{{rowId}}">{{name}}</a>
        <span class="r-cla-en">{{en}}</span>
        <span class="r-cla-dots">{{> rDots dots=dots cls="is-small"}}</span>
        <span class="r-cla-tools">
          {{#if @root.editable}}<a data-action="clUnleash" data-art="{{key}}" data-tooltip="{{localize 'VTM20.Changeling.UnleashHint'}}"><i class="fa-solid fa-burst"></i></a>
          <a class="is-danger" data-action="clArtDel" data-art="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
          <a class="r-chevron" data-action="toggleRow" data-row-id="{{rowId}}"><i class="fa-solid fa-chevron-down"></i></a>
        </span>
      </header>
      <div class="r-cla-body">
        <ol class="r-cla-ladder">
          {{#each levels}}
          <li class="r-row-wrap {{#if known}}is-known{{else}}is-beyond{{/if}} {{#if open}}is-open{{/if}}">
            <span class="r-cla-step"><b>{{rRoman level}}</b></span>
            <a class="r-cla-cantrip" data-action="toggleRow" data-row-id="{{rowId}}">{{name}}</a>
            {{#if type}}<i class="r-cla-type is-{{type}} fa-solid {{#if (eq type 'wyrd')}}fa-sun{{else if (eq type 'chimerical')}}fa-cloud{{else}}fa-circle-half-stroke{{/if}}" data-tooltip="{{typeLabel}}"></i>{{else}}<span></span>{{/if}}
            {{#if known}}{{#if @root.editable}}<a class="r-cla-cast" data-action="clCast" data-art="{{../key}}" data-level="{{level}}" data-tooltip="{{localize 'VTM20.Changeling.CastArt'}}"><i class="fa-solid fa-dice-d10"></i></a>{{else}}<span></span>{{/if}}{{else}}<span></span>{{/if}}
            <div class="r-cla-text">{{#if en}}<p class="r-cla-text-en">{{en}}{{#if typeLabel}} · {{typeLabel}}{{/if}}</p>{{/if}}{{{html}}}</div>
          </li>
          {{/each}}
        </ol>
        {{#if unleashing}}<details class="r-cla-bunks"><summary><i class="fa-solid fa-burst"></i> {{localize "VTM20.Changeling.Unleash"}}</summary><p>{{unleashing}}</p></details>{{/if}}
        {{#if bunks}}<details class="r-cla-bunks"><summary><i class="fa-solid fa-masks-theater"></i> {{localize "VTM20.Changeling.Bunk"}}</summary><p>{{bunks}}</p></details>{{/if}}
      </div>
    </article>
    {{/each}}
  </div>

  {{!-- Царства (C20, гл. 4): на что направлен кантрип — шесть строк; цели ступенями, открытые светятся, текст — в подсказке --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Realms"}}</span></h2>
  <div class="r-clr-grid">
    {{#each cl.realms}}
    <div class="r-clr {{#if modifier}}is-mod{{/if}} {{#if affinity}}is-affinity{{/if}} {{#unless value}}is-zero{{/unless}}">
      <span class="r-clr-glyph">{{#if sym}}{{rSym sym}}{{/if}}</span>
      <span class="r-clr-name">{{name}}{{#if affinity}} <i class="fa-solid fa-leaf" data-tooltip="{{localize 'VTM20.Changeling.AffinityHint'}}"></i>{{/if}}<small>{{en}}</small></span>
      <span class="r-clr-dots">{{> rDots dots=dots cls="is-small"}}</span>
      <ol class="r-clr-steps">{{#each levels}}<li class="{{#if known}}is-known{{/if}}" data-tooltip="<b>{{level}}. {{name}}</b><br>{{text}}">{{name}}</li>{{/each}}</ol>
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{!-- Спутники Грёзы — четыре панели сеткой: сокровища, химеры, ремесло, клятвы --}}
  <div class="r-cla-annex">
    <section class="r-cla-panel is-treasure">
    {{!-- Сокровища (C20, гл. 8): сила Искусства без Царств, свой запас Гламура; разрушение — Гламур и триггер Банальности --}}
    <h2 class="r-h2 r-cla-ph"><i class="fa-solid fa-gem"></i><span>{{localize "VTM20.Changeling.Treasure.Head"}}</span>
      {{#if editable}}<span class="r-h2-tools"><a class="r-btn is-sq" data-action="clTreasure" data-op="add" data-tooltip="{{localize 'VTM20.Changeling.Treasure.Add'}}"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</h2>
    {{#if cl.treasures.length}}<div class="r-cl-oaths">
      {{#each cl.treasures}}<article class="r-vcard r-cl-oath r-cl-treasure">
        <header><b>{{name}}</b> <em>{{art}} {{dots}}</em>
          {{#if @root.editable}}<span class="r-cl-oath-tools"><a data-action="clTreasure" data-op="use" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.UseHint'}}"><i class="fa-solid fa-wand-sparkles"></i></a>
            <a data-action="clTreasure" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.Destroy'}}"><i class="fa-solid fa-hammer"></i></a></span>{{/if}}</header>
        <p class="r-cl-oath-fx" data-tooltip="{{tip}}"><i class="fa-solid fa-{{#if (eq type 'wyrd')}}sun{{else}}cloud{{/if}}"></i> {{power}}</p>
        {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
        <p class="r-cl-oath-fx"><i class="fa-solid fa-star"></i> {{localize "VTM20.Changeling.Treasure.Store"}}: <b>{{store}}</b>
          {{#if @root.editable}}<a data-action="clTreasure" data-op="store" data-d="-1" data-i="{{i}}"><i class="fa-solid fa-minus"></i></a> <a data-action="clTreasure" data-op="store" data-d="1" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.StoreHint'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</p>
      </article>{{/each}}
    </div>{{/if}}
    </section>
    <section class="r-cla-panel is-chimera">
    {{!-- Химеры-спутники (C20, гл. 8): черты по очкам химеры против бюджета Фона «Химера», Реды; лист существа для боя --}}
    <h2 class="r-h2 r-cla-ph"><i class="fa-solid fa-dragon"></i><span>{{localize "VTM20.Changeling.Chimera.Head"}}</span>
      {{#if editable}}<span class="r-h2-tools"><a class="r-btn is-sq" data-action="clChimera" data-op="add" data-tooltip="{{localize 'VTM20.Changeling.Chimera.Add'}}"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</h2>
    {{#if cl.chimeras.length}}<div class="r-cl-oaths">
      {{#each cl.chimeras}}<article class="r-vcard r-cl-oath r-cl-chimera {{#if over}}is-over{{/if}}">
        <header><b>{{name}}</b> <em>{{dots}}</em> <span class="r-cl-state {{#if over}}is-bedlam{{/if}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.PtsHint'}}">{{pts}} / {{budget}}</span>
          {{#if @root.editable}}<span class="r-cl-oath-tools"><a data-action="clChimera" data-op="actor" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.ActorHint'}}"><i class="fa-solid {{#if hasActor}}fa-id-card{{else}}fa-user-plus{{/if}}"></i></a>
            <a data-action="clChimera" data-op="edit" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.Edit'}}"><i class="fa-solid fa-pen"></i></a>
            <a data-action="clChimera" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
        <p class="r-cl-oath-fx"><i class="fa-solid fa-star"></i> {{glamour}} · <i class="fa-solid fa-shield-heart"></i> {{will}} · <i class="fa-solid fa-heart"></i> {{health}}</p>
        {{#if attrs}}<p class="r-cl-oath-fx">{{attrs}}</p>{{/if}}{{#if abils}}<p class="r-cl-oath-fx">{{abils}}</p>{{/if}}
        {{#if redes.length}}<div class="r-cl-states">{{#each redes}}<span class="r-cl-state" data-tooltip="{{tip}}">{{name}}</span>{{/each}}</div>{{/if}}
        {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
      </article>{{/each}}
    </div>{{/if}}
    </section>
    <section class="r-cla-panel is-craft">
    {{!-- Химерическое ремесло (C20, гл. 8): проект — бросок за неделю, план — за день; прогресс к порогу успехов --}}
    <h2 class="r-h2 r-cla-ph"><i class="fa-solid fa-hammer"></i><span>{{localize "VTM20.Changeling.Craft.Head"}}</span>
      {{#if editable}}<span class="r-h2-tools"><a class="r-btn is-sq" data-action="clCraft" data-op="add" data-tooltip="{{localize 'VTM20.Changeling.Craft.Add'}}"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</h2>
    {{#if cl.crafts.length}}<div class="r-cl-oaths">
      {{#each cl.crafts}}<article class="r-vcard r-cl-oath r-cl-craft {{#if done}}is-done{{/if}}">
        <header><b>{{name}}</b> <em>{{tier}}</em>
          {{#if @root.editable}}<span class="r-cl-oath-tools">{{#unless done}}<a data-action="clCraft" data-op="plan" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Craft.PlanHint'}}"><i class="fa-solid fa-compass-drafting"></i></a>
            <a data-action="clCraft" data-op="work" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Craft.WorkHint'}}"><i class="fa-solid fa-hammer"></i></a>{{/unless}}
            <a data-action="clCraft" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
        <div class="r-cl-craft-bar"><i style="width: {{pct}}%"></i></div>
        <p class="r-cl-oath-fx">{{got}} / {{need}} · {{localize "VTM20.Changeling.Craft.DiffShort"}} {{diff}}{{#if plan}} · {{localize "VTM20.Changeling.Craft.PlanShort"}} {{plan}}{{/if}}{{#if helpers}} · {{localize "VTM20.Changeling.Craft.Helpers"}} {{helpers}}{{/if}}</p>
      </article>{{/each}}
    </div>{{/if}}
    </section>
    <section class="r-cla-panel is-oath">
    {{!-- Клятвы (C20, гл. 6): примеры книги с ценой и расплатой; нарушение — расплата, «клятвопреступник» и триггер Банальности --}}
    <h2 class="r-h2 r-cla-ph"><i class="fa-solid fa-handshake-angle"></i><span>{{localize "VTM20.Changeling.Oath.Head"}}</span>
      {{#if editable}}<span class="r-h2-tools"><a class="r-btn is-sq" data-action="clOath" data-op="take" data-tooltip="{{localize 'VTM20.Changeling.Oath.Swear'}}"><i class="fa-solid fa-plus"></i></a></span>{{/if}}</h2>
    {{#if cl.oaths.length}}<div class="r-cl-oaths">
      {{#each cl.oaths}}<article class="r-vcard r-cl-oath {{#if broken}}is-broken{{/if}}">
        <header><b>{{name}}</b>{{#if who}} <em>— {{who}}</em>{{/if}}{{#if broken}} <span class="r-cl-state is-bedlam">{{localize "VTM20.Changeling.Oath.Forsworn"}}</span>{{/if}}
          {{#if @root.editable}}<span class="r-cl-oath-tools">{{#unless broken}}<a data-action="clOath" data-op="break" data-i="{{i}}" data-tooltip="{{brk}}"><i class="fa-solid fa-heart-crack"></i></a>{{/unless}}
            <a data-action="clOath" data-op="drop" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Oath.Drop'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
        {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
        <p class="r-cl-oath-fx"><i class="fa-solid fa-scale-balanced"></i> {{take}} · <i class="fa-solid fa-heart-crack"></i> {{brk}}</p>
      </article>{{/each}}
    </div>{{/if}}
    </section>
  </div>
</section>
