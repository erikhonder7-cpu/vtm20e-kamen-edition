{{!-- Подменыш (C20, гл. 4): Искусства с уровнями (химерический / Вирд), Царства — на что направлен кантрип (module/apps/changeling.mjs) --}}
<section class="tab r-pane r-edges r-cl-pane {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Arts"}}</span>
    <span class="r-h2-tools">
      <span class="r-gs-pool" data-tooltip="{{localize 'VTM20.Changeling.CantripRule' nm=cl.nightmare}}"><i class="fa-solid fa-star"></i> {{cl.glamour}} · <i class="fa-solid fa-moon"></i> {{cl.nightmare}}</span>
      {{#if editable}}<a class="r-h2-btn" data-action="clCast"><i class="fa-solid fa-wand-sparkles"></i> <span class="r-h2-lbl">{{localize "VTM20.Changeling.Cantrip"}}</span></a>{{/if}}
    </span>
  </h2>
  {{#if editable}}{{#if cl.avail.length}}<div class="r-toolbar r-cl-add">
    <select><option value="">{{localize "VTM20.Changeling.AddArt"}}</option>{{#each cl.avail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-btn" data-action="clArtAdd"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}{{/if}}
  <div class="r-cl-arts">
    {{#each cl.own}}
    <article class="r-vcard r-cl-art">
      <header class="r-cl-art-head">
        <div class="r-cl-art-title"><a class="r-cl-art-name" data-action="clCast" data-art="{{key}}">{{name}}</a><span class="r-cl-art-en">{{en}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}<a class="r-icon-btn" data-action="clUnleash" data-art="{{key}}" data-tooltip="{{localize 'VTM20.Changeling.UnleashHint'}}{{#if unleashing}}<br>{{unleashing}}{{/if}}"><i class="fa-solid fa-burst"></i></a>
        <a class="r-icon-btn is-danger" data-action="clArtDel" data-art="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </header>
      <ul class="r-cl-levels">
        {{#each levels}}
        <li class="{{#unless known}}is-beyond{{/unless}}">
          <span class="r-cl-rank">{{level}}</span>
          <a class="r-cl-lvl-name" {{#if known}}data-action="clCast" data-art="{{../key}}" data-level="{{level}}"{{/if}} data-tooltip="{{html}}"><b>{{name}}</b> <em>{{en}}</em></a>
          {{#if typeLabel}}<span class="r-cl-chip is-{{type}}">{{typeLabel}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{#if bunks}}<p class="r-note r-cl-bunks"><i class="fa-solid fa-masks-theater"></i> {{bunks}}</p>{{/if}}
    </article>
    {{else}}
    <p class="r-gs-empty">{{localize "VTM20.Changeling.NoArts"}}</p>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Realms"}}</span></h2>
  <div class="r-cl-realms">
    {{#each cl.realms}}
    <div class="r-vcard r-cl-realm {{#if modifier}}is-mod{{/if}} {{#if affinity}}is-affinity{{/if}}">
      <div class="r-vc-head"><h4 class="r-banner">{{name}}{{#if affinity}} <i class="fa-solid fa-leaf" data-tooltip="{{localize 'VTM20.Changeling.AffinityHint'}}"></i>{{/if}}</h4>{{> rDots dots=dots cls="is-small"}}</div>
      <ol class="r-cl-rlevels">{{#each levels}}<li class="{{#if known}}is-known{{/if}}" data-tooltip="{{text}}">{{name}}</li>{{/each}}</ol>
    </div>
    {{/each}}
  </div>
  {{!-- Сокровища (C20, гл. 8): сила Искусства без Царств, свой запас Гламура; разрушение — Гламур и триггер Банальности --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Treasure.Head"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-btn" data-action="clTreasure" data-op="add"><i class="fa-solid fa-gem"></i> {{localize "VTM20.Changeling.Treasure.Add"}}</a></span>{{/if}}</h2>
  {{#if cl.treasures.length}}<div class="r-cl-oaths">
    {{#each cl.treasures}}<article class="r-vcard r-cl-oath r-cl-treasure">
      <header><b>{{name}}</b> <em>{{art}} {{dots}}</em>
        {{#if @root.editable}}<span class="r-cl-oath-tools"><a data-action="clTreasure" data-op="use" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.UseHint'}}"><i class="fa-solid fa-wand-sparkles"></i></a>
          <a data-action="clTreasure" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.Destroy'}}"><i class="fa-solid fa-hammer"></i></a></span>{{/if}}</header>
      <p class="r-cl-oath-fx" data-tooltip="{{tip}}"><i class="fa-solid fa-{{#if (eq type 'wyrd')}}sun{{else}}cloud{{/if}}"></i> {{power}}</p>
      {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
      <p class="r-cl-oath-fx"><i class="fa-solid fa-star"></i> {{localize "VTM20.Changeling.Treasure.Store"}}: <b>{{store}}</b>
        {{#if @root.editable}}<a data-action="clTreasure" data-op="store" data-d="-1" data-i="{{i}}"><i class="fa-solid fa-minus"></i></a> <a data-action="clTreasure" data-op="store" data-d="1" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Treasure.StoreHint'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</p>
    </article>{{/each}}
  </div>{{else}}<p class="r-note">{{localize "VTM20.Changeling.Treasure.None"}}</p>{{/if}}
  {{!-- Химеры-спутники (C20, гл. 8): черты по очкам химеры против бюджета Фона «Химера», Реды; лист существа для боя --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Chimera.Head"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-btn" data-action="clChimera" data-op="add"><i class="fa-solid fa-dragon"></i> {{localize "VTM20.Changeling.Chimera.Add"}}</a></span>{{/if}}</h2>
  {{#if cl.chimeras.length}}<div class="r-cl-oaths">
    {{#each cl.chimeras}}<article class="r-vcard r-cl-oath r-cl-chimera {{#if over}}is-over{{/if}}">
      <header><b>{{name}}</b> <em>{{dots}}</em> <span class="r-cl-state {{#if over}}is-bedlam{{/if}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.PtsHint'}}">{{pts}} / {{budget}}</span>
        {{#if @root.editable}}<span class="r-cl-oath-tools"><a data-action="clChimera" data-op="actor" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.ActorHint'}}"><i class="fa-solid {{#if hasActor}}fa-id-card{{else}}fa-user-plus{{/if}}"></i></a>
          <a data-action="clChimera" data-op="edit" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Chimera.Edit'}}"><i class="fa-solid fa-pen"></i></a>
          <a data-action="clChimera" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
      <p class="r-cl-oath-fx"><i class="fa-solid fa-star"></i> {{glamour}} · <i class="fa-solid fa-shield-heart"></i> {{will}} · <i class="fa-solid fa-heart"></i> {{health}}</p>
      {{#if attrs}}<p class="r-cl-oath-fx">{{attrs}}</p>{{/if}}{{#if abils}}<p class="r-cl-oath-fx">{{abils}}</p>{{/if}}
      {{#if redes.length}}<div class="r-cl-states">{{#each redes}}<span class="r-cl-state" data-tooltip="{{tip}}">{{name}}</span>{{/each}}</div>{{/if}}
      {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
    </article>{{/each}}
  </div>{{else}}<p class="r-note">{{localize "VTM20.Changeling.Chimera.None"}}</p>{{/if}}
  {{!-- Химерическое ремесло (C20, гл. 8): проект — бросок за неделю, план — за день; прогресс к порогу успехов --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Craft.Head"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-btn" data-action="clCraft" data-op="add"><i class="fa-solid fa-hammer"></i> {{localize "VTM20.Changeling.Craft.Add"}}</a></span>{{/if}}</h2>
  {{#if cl.crafts.length}}<div class="r-cl-oaths">
    {{#each cl.crafts}}<article class="r-vcard r-cl-oath r-cl-craft {{#if done}}is-done{{/if}}">
      <header><b>{{name}}</b> <em>{{tier}}</em>
        {{#if @root.editable}}<span class="r-cl-oath-tools">{{#unless done}}<a data-action="clCraft" data-op="plan" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Craft.PlanHint'}}"><i class="fa-solid fa-compass-drafting"></i></a>
          <a data-action="clCraft" data-op="work" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Craft.WorkHint'}}"><i class="fa-solid fa-hammer"></i></a>{{/unless}}
          <a data-action="clCraft" data-op="del" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
      <div class="r-cl-craft-bar"><i style="width: {{pct}}%"></i></div>
      <p class="r-cl-oath-fx">{{got}} / {{need}} · {{localize "VTM20.Changeling.Craft.DiffShort"}} {{diff}}{{#if plan}} · {{localize "VTM20.Changeling.Craft.PlanShort"}} {{plan}}{{/if}}{{#if helpers}} · {{localize "VTM20.Changeling.Craft.Helpers"}} {{helpers}}{{/if}}</p>
    </article>{{/each}}
  </div>{{else}}<p class="r-note">{{localize "VTM20.Changeling.Craft.None"}}</p>{{/if}}
  {{!-- Клятвы (C20, гл. 6): примеры книги с ценой и расплатой; нарушение — расплата, «клятвопреступник» и триггер Банальности --}}
  <h2 class="r-h2 r-cl-oaths-head"><span>{{localize "VTM20.Changeling.Oath.Head"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-btn" data-action="clOath" data-op="take"><i class="fa-solid fa-handshake-angle"></i> {{localize "VTM20.Changeling.Oath.Swear"}}</a></span>{{/if}}</h2>
  {{#if cl.oaths.length}}<div class="r-cl-oaths">
    {{#each cl.oaths}}<article class="r-vcard r-cl-oath {{#if broken}}is-broken{{/if}}">
      <header><b>{{name}}</b>{{#if who}} <em>— {{who}}</em>{{/if}}{{#if broken}} <span class="r-cl-state is-bedlam">{{localize "VTM20.Changeling.Oath.Forsworn"}}</span>{{/if}}
        {{#if @root.editable}}<span class="r-cl-oath-tools">{{#unless broken}}<a data-action="clOath" data-op="break" data-i="{{i}}" data-tooltip="{{brk}}"><i class="fa-solid fa-heart-crack"></i></a>{{/unless}}
          <a data-action="clOath" data-op="drop" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Changeling.Oath.Drop'}}"><i class="fa-solid fa-xmark"></i></a></span>{{/if}}</header>
      {{#if text}}<p class="r-note">{{text}}</p>{{/if}}
      <p class="r-cl-oath-fx"><i class="fa-solid fa-scale-balanced"></i> {{take}} · <i class="fa-solid fa-heart-crack"></i> {{brk}}</p>
    </article>{{/each}}
  </div>{{else}}<p class="r-note">{{localize "VTM20.Changeling.Oath.None"}}</p>{{/if}}
</section>
