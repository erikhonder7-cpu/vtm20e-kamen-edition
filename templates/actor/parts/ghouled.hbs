{{!-- Гуль или ревенант среди смертных (module/apps/ghouled.mjs): gh — ghouledView; editable — можно править.
     Три карточки шкал, как Здоровье и Воля: кто дал кровь (домитор и его клан — или род ревенанта), витэ каплями,
     узы крови ступенями (у ревенанта — изъян рода). Ниже на вкладке — Дисциплины целиком (rDiscBody). --}}
{{#if gh.on}}
<h2 class="r-h2"><span>{{gh.title}}</span>
  <span class="r-h2-tools">{{#if editable}}
    <a class="r-h2-btn is-ghost is-on" data-action="ghToggle" data-kind="{{gh.kind}}" data-tooltip="{{localize 'VTM20.Ghouled.OffHint'}}"><i class="fa-solid {{#if gh.revenant}}fa-people-roof{{else}}fa-hand-holding-droplet{{/if}}"></i> <span class="r-h2-lbl">{{localize "VTM20.Ghouled.Off"}}</span></a>{{/if}}</span>
</h2>
<div class="r-gh">
  {{!-- кто дал кровь --}}
  <div class="r-vcard r-gh-who" {{#unless gh.revenant}}data-gh-domitor data-tooltip="{{localize 'VTM20.Ghouled.DomitorDrop'}}"{{/unless}}>
    {{#if gh.revenant}}
    <div class="r-vc-head"><h4 class="r-banner"><span>{{localize "VTM20.Ghouled.Family"}}</span></h4></div>
    <div class="r-gh-id">
      <i class="r-gh-crest fa-solid fa-people-roof"></i>
      <select class="r-gh-name" name="system.ghouled.family" {{#unless editable}}disabled{{/unless}}><option value="">—</option>{{#each gh.families}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </div>
    <div class="r-vc-tools">
      {{#if gh.family}}<span class="r-vc-hint is-left" data-tooltip="{{gh.family.discs}}"><i class="fa-solid fa-droplet"></i> {{gh.family.discs}}</span>
      {{#if editable}}<a class="r-vc-btn" data-action="ghFamilyDiscs" data-tooltip="{{localize 'VTM20.Ghouled.FamilyDiscsHint'}}"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Sheet.Add"}}</a>{{/if}}
      {{else}}<span class="r-vc-hint is-left">{{localize "VTM20.Ghouled.NoFamily"}}</span>{{/if}}
    </div>
    {{else}}
    <div class="r-vc-head"><h4 class="r-banner"><span>{{localize "VTM20.Ghouled.Who"}}</span></h4></div>
    <div class="r-gh-id">
      {{#if gh.sym}}{{rSym gh.sym "r-gh-crest"}}{{else}}<i class="r-gh-crest fa-solid fa-user-secret"></i>{{/if}}
      <input class="r-gh-name" type="text" name="system.ghouled.domitor" value="{{gh.domitor}}" placeholder="{{localize 'VTM20.Ghouled.NoDomitor'}}" {{#unless editable}}disabled{{/unless}}>
    </div>
    <div class="r-vc-tools">
      <span class="r-vc-btnlabel">{{localize "VTM20.Details.clan"}}</span>
      <select class="r-gh-clan" name="system.ghouled.clan" {{#unless editable}}disabled{{/unless}}>
        <option value="{{gh.clanRaw}}">{{#if gh.clanRaw}}{{gh.clanRaw}}{{else}}{{localize "VTM20.Ghouled.Unknown"}}{{/if}}</option>
        {{#each gh.clans}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    {{/if}}
  </div>

  {{!-- витэ в теле --}}
  <div class="r-vcard r-gh-blood">
    <div class="r-vc-head">
      <h4 class="r-banner"><span data-tooltip="{{#if gh.revenant}}{{localize 'VTM20.Ghouled.RevenantVitaeHint'}}{{else}}{{localize 'VTM20.Mage.Ghoul.VitaeHint'}}{{/if}}">{{localize "VTM20.Mage.Ghoul.Vitae"}}</span></h4>
      <div class="r-vc-status"><b>{{gh.vitae}}</b>/{{gh.max}}</div>
    </div>
    <div class="r-drops r-gh-drops {{#if gh.many}}is-many{{/if}}">{{#each gh.boxes}}<a class="r-drop {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="ghVitae" data-n="{{n}}"{{/if}}><svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 2C12 2 4 12 4 18a8 8 0 0 0 16 0C20 12 12 2 12 2z"/></svg></a>{{/each}}</div>
    <div class="r-vc-tools">
      {{#if editable}}
      {{#unless gh.revenant}}<a class="r-vc-btn" data-action="feedFrom" data-tooltip="{{localize 'VTM20.Ghouled.DrinkHintBtn'}}"><i class="fa-solid fa-hand-holding-droplet"></i> {{localize "VTM20.Ghouled.Drink"}}</a>{{/unless}}
      <a class="r-vc-btn" data-action="spendBlood" data-tooltip="{{localize 'VTM20.Ghouled.SpendHint'}}"><i class="fa-solid fa-minus"></i> {{localize "VTM20.Ghouled.Spend"}}</a>
      <a class="r-vc-btn" data-action="ghHeal" data-tooltip="{{localize 'VTM20.Ghouled.HealHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Ghouled.Heal"}}</a>
      {{/if}}
      <span class="r-vc-hint">{{localize "VTM20.Ghouled.PerTurn"}} <b>1</b></span>
    </div>
  </div>

  {{!-- узы крови (гуль) или изъян рода (ревенант) --}}
  {{#if gh.revenant}}
  <div class="r-vcard r-gh-flaw">
    <div class="r-vc-head"><h4 class="r-banner"><span>{{localize "VTM20.Ghouled.Flaw"}}</span></h4></div>
    <p class="r-gh-flaw-text">{{#if gh.family}}{{gh.family.flaw}}{{else}}—{{/if}}</p>
    {{#if gh.family.rules.length}}<div class="r-ghl">{{#each gh.family.rules}}<span class="r-chip" data-tooltip="{{localize 'VTM20.RevFlaw.AutoTip'}}"><i class="fa-solid fa-gears"></i> {{this}}</span>{{/each}}</div>{{/if}}
    {{#if gh.family.pride}}{{#if editable}}<div class="r-vc-tools"><a class="r-vc-btn" data-action="ghPride" data-tooltip="{{localize 'VTM20.RevFlaw.PrideTip'}}"><i class="fa-solid fa-crown"></i> {{localize "VTM20.RevFlaw.Pride"}}</a></div>{{/if}}{{/if}}
  </div>
  {{else}}
  <div class="r-vcard r-gh-bond">
    <div class="r-vc-head">
      <h4 class="r-banner"><span data-tooltip="{{localize 'VTM20.Mage.Ghoul.BondHint'}}">{{localize "VTM20.Mage.Ghoul.Bond"}}</span></h4>
      <div class="r-vc-status"><b>{{gh.bond}}</b>/3</div>
    </div>
    <div class="r-gh-steps">{{#each gh.steps}}
      <a class="r-gh-step {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="system.ghouled.bond" data-n="{{n}}"{{/if}} data-tooltip="{{tip}}">
        <span class="r-drop {{#if filled}}is-filled{{/if}}"><svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 2C12 2 4 12 4 18a8 8 0 0 0 16 0C20 12 12 2 12 2z"/></svg></span>
        <span class="r-gh-step-k">{{label}}</span>
      </a>{{/each}}
    </div>
    <div class="r-vc-tools"><span class="r-vc-hint is-left">{{#if gh.bondText}}{{gh.bondText}}{{else}}{{localize "VTM20.Ghouled.NoBond"}}{{/if}}</span></div>
  </div>
  {{/if}}
</div>
{{!-- без витэ (apps/ghoul-life.mjs): сколько ночей, ломка, Дисциплины к потере, старение — плашками; кнопки проверок --}}
{{#if gh.life.chips.length}}
<div class="r-gh-life">
  <div class="r-ghl">{{#each gh.life.chips}}<span class="r-chip {{#if warn}}is-warn{{/if}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i> {{label}}</span>{{/each}}</div>
  {{#if editable}}<span class="r-gh-life-tools">
    {{#if gh.life.withdrawal}}<a class="r-vc-btn" data-action="ghoulLife" data-op="week" data-tooltip="{{localize 'VTM20.GhoulLife.WeekTip'}}"><i class="fa-solid fa-hourglass-half"></i> {{localize "VTM20.GhoulLife.Week"}}</a>
    <a class="r-vc-btn is-sq" data-action="ghoulLife" data-op="refuse" data-tooltip="{{localize 'VTM20.GhoulLife.RefuseTip'}}"><i class="fa-solid fa-hand"></i></a>{{/if}}
    {{#if gh.life.discDue}}<a class="r-vc-btn" data-action="ghoulLife" data-op="lose" data-tooltip="{{localize 'VTM20.GhoulLife.LoseTip'}}"><i class="fa-solid fa-arrow-trend-down"></i> {{localize "VTM20.Ghouled.LoseDisc"}}</a>{{/if}}
  </span>{{/if}}
</div>
<p class="r-hint r-gh-life-hint">{{localize "VTM20.Ghouled.LifeHint"}}</p>
{{/if}}
{{/if}}
