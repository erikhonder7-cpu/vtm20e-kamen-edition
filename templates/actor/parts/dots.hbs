{{!-- Ряд точек-кокард. dots: [{n, filled, path, itemId}]; у Гару в форме — gain (прибавлено формой) и loss (отнято). --}}
<span class="r-dots {{cls}}">{{#each dots}}{{#if gain}}<span class="r-dot is-gain {{#if (gt n 5)}}is-over{{/if}}"></span>{{else}}<a class="r-dot {{#if filled}}is-filled{{/if}} {{#if loss}}is-loss{{/if}} {{#if (gt n 5)}}is-over{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}" {{#if itemId}}data-item-id="{{itemId}}"{{/if}}></a>{{/if}}{{/each}}</span>
