{{!-- Корешок слева: герб клана в медальоне, главы I–V монетами, мастер и свободная проверка. --}}
<nav class="r-rail tabs" data-group="primary" role="tablist">
  <div class="r-rail-sigil {{#if (or sigil.clan isDemon)}}is-link{{/if}}" {{#if sigil.clan}}data-action="clanAtlas"{{else if isDemon}}data-action="houseAtlas"{{/if}} {{#if sigil.label}}data-tooltip="{{sigil.label}}{{#if sigil.clan}} — {{localize 'VTM20.Clans.Open'}}{{/if}}" data-tooltip-direction="RIGHT"{{/if}}>
    {{#if sigil.sym}}{{rSym sigil.sym}}
    {{else}}<img src="{{sigil.img}}" alt="">{{/if}}
  </div>
  {{#each tabs}}
  <a class="r-rtab {{cssClass}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" role="tab" data-tooltip="{{localize label}}" data-tooltip-direction="RIGHT">
    <span class="r-rtab-coin"><i class="{{icon}}"></i></span>
    <span class="r-rtab-num">{{roman}}</span>
    <span class="r-rtab-label">{{localize label}}</span>
  </a>
  {{/each}}
  <span class="r-rail-spacer"></span>
  <div class="r-rail-tools">
  {{#unless isCreature}}<a class="r-rail-tool" data-action="openCreator" data-tooltip="{{localize 'VTM20.Creator.Open'}}" data-tooltip-direction="RIGHT"><i class="fa-solid fa-wand-magic-sparkles"></i></a>{{/unless}}
  <a class="r-rail-tool" data-action="openRules" data-tooltip="{{localize 'VTM20.Sheet.Rules'}}" data-tooltip-direction="RIGHT"><i class="fa-solid fa-book-open-reader"></i></a>
  <a class="r-rail-tool" data-action="rollFree" data-tooltip="{{localize 'VTM20.Sheet.FreeRoll'}}" data-tooltip-direction="RIGHT"><i class="fa-solid fa-dice-d10"></i></a>
  </div>
</nav>
