{{!-- II. Сферы мага (M20, гл. 10): девять Сфер с рангами, фокус (парадигма, практика, инструменты) и ротэ. --}}
<section class="tab r-pane r-disciplines r-edges r-spheres {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h2 class="r-h2"><span>{{@root.mageView.L.Spheres}}</span>
    <span class="r-h2-tools">
      {{#if editable}}<a class="r-h2-btn" data-action="mageCast" data-tooltip="{{localize 'VTM20.Mage.CastHintBtn'}}"><i class="fa-solid fa-hat-wizard"></i> <span class="r-h2-lbl">{{@root.mageView.L.Cast}}</span></a>{{/if}}
      {{#if editable}}<a class="r-h2-btn is-ghost" data-action="mageCounter" data-tooltip="{{localize 'VTM20.Mage.CounterTip'}}"><i class="fa-solid fa-shield-halved"></i></a>
      <a class="r-h2-btn is-ghost" data-action="mageCertamen" data-tooltip="{{localize 'VTM20.Mage.CertamenTip'}}"><i class="fa-solid fa-khanda"></i></a>
      <a class="r-h2-btn is-ghost {{#if mageView.inUmbra}}is-on{{/if}}" data-action="mageStep" data-tooltip="{{#if mageView.inUmbra}}{{localize 'VTM20.Mage.StepBackTip'}}{{else}}{{localize 'VTM20.Mage.StepTip'}}{{/if}}"><i class="fa-solid fa-circle-half-stroke"></i></a>{{/if}}
      <a class="r-h2-btn is-plain" data-action="mageFold" data-to="{{#if mageView.allFolded}}0{{else}}1{{/if}}" data-tooltip="{{#if mageView.allFolded}}{{localize 'VTM20.Mage.UnfoldAll'}}{{else}}{{localize 'VTM20.Mage.FoldAll'}}{{/if}}"><i class="fa-solid {{#if mageView.allFolded}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i></a>
      <a class="r-h2-btn is-plain" data-action="openRules" data-tooltip="{{localize 'VTM20.Mage.RulesHint'}}"><i class="fa-solid fa-book-open-reader"></i></a>
    </span>
  </h2>
  <p class="r-note r-edge-budget"><span>{{@root.mageView.L.Arete}} <b>{{mageView.arete}}</b></span><span class="{{#if mageView.capped}}is-over{{/if}}">{{@root.mageView.L.Pool}} <b>{{mageView.cap}}</b></span><span>{{localize "VTM20.Mage.SphereDots"}} <b>{{mageView.total}}</b></span>
    <em class="r-explain">{{#if mageView.capped}}{{localize "VTM20.Mage.CappedHint"}}{{else}}{{localize "VTM20.Mage.CapHint"}}{{/if}}</em></p>

  {{!-- Сферы карточками; сворачиваются как Дисциплины: щелчок по шапке раскрывает ранги, лист не перерисовывается --}}
  <div class="r-sphere-grid">
    {{#each mageView.spheres}}
    <article class="r-edge-path r-sphere {{#if affinity}}is-primary{{/if}} {{#unless value}}is-zero{{/unless}} {{#if over}}is-over{{/if}} {{#if folded}}is-shut{{else}}is-open{{/if}}">
      <header class="r-edge-head r-sphere-head" data-sphere-fold="{{key}}">
        <span class="r-edge-sigil r-sphere-sigil">{{rSym sym "r-mg"}}</span>
        <a class="r-sphere-fold r-chevron" data-action="mageFold" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Details'}}"><i class="fa-solid fa-chevron-down"></i></a>
        <span class="r-edge-title" {{#if altTip}}data-tooltip="{{altTip}}"{{/if}}><b>{{name}}</b> <small>{{en}}{{#if affinity}} · {{localize "VTM20.Mage.AffinityShort"}}{{/if}}</small>{{#if qliph}}<em class="r-qliph" data-tooltip="«{{qliph.title}}». {{localize 'VTM20.Mage.QliphHint'}}">{{qliph.name}}</em>{{/if}}</span>
        <span class="r-dots">{{#each dots}}<a class="r-dot {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</span>
        {{#if @root.editable}}{{#if value}}<a class="r-vc-btn" data-action="mageCast" data-sphere="{{key}}" data-tooltip="{{localize 'VTM20.Mage.CastWith'}}"><i class="fa-solid fa-hat-wizard"></i></a>{{/if}}{{/if}}
      </header>
      {{#if over}}<p class="r-note r-edge-fifth"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "VTM20.Mage.OverCap"}}</p>{{/if}}
      <div class="r-sphere-body">
        <ul class="r-edge-list">
          {{#each ranks}}
          <li class="r-edge {{#unless owned}}is-foreign{{/unless}}">
            <span class="r-edge-lvl">{{rRoman n}}</span>
            <span class="r-edge-main"><b>{{name}}</b><div class="r-edge-text">{{{text}}}</div></span>
          </li>
          {{/each}}
        </ul>
        {{#if specialties}}<p class="r-sphere-spec"><em>{{localize "VTM20.Mage.Specialties"}}:</em> {{specialties}}</p>{{/if}}
      </div>
    </article>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{@root.mageView.L.Focus}}</span></h2>
  <div class="r-focus">
    <label class="r-df is-wide"><span>{{localize "VTM20.Mage.Paradigm"}}</span>
      <input type="text" name="system.mage.paradigm" value="{{system.mage.paradigm}}" data-combo="r-mpar-{{actor.id}}" placeholder="{{localize 'VTM20.Mage.ParadigmHint'}}" {{#unless editable}}disabled{{/unless}}></label>
    <datalist id="r-mpar-{{actor.id}}">{{#each mageView.paradigms}}<option value="{{this}}"></option>{{/each}}</datalist>
    <label class="r-df is-wide" {{#if mageView.practiceTip}}data-tooltip="{{localize 'VTM20.Mage.PracticeTools'}}: {{mageView.practiceTip}}"{{/if}}><span>{{localize "VTM20.Mage.Practice"}}</span>
      <input type="text" name="system.mage.practice" value="{{system.mage.practice}}" data-combo="r-mpra-{{actor.id}}" placeholder="{{localize 'VTM20.Mage.PracticeHint'}}" {{#unless editable}}disabled{{/unless}}></label>
    <datalist id="r-mpra-{{actor.id}}">{{#each mageView.practices}}<option value="{{this}}"></option>{{/each}}</datalist>
  </div>
  <div class="r-tools">
    <span class="r-tools-lbl">{{@root.mageView.L.Instruments}}{{#if mageView.toolsNeed}} <em class="is-warn">{{localize "VTM20.Mage.ToolsNeed" n=mageView.toolsNeed}}</em>{{/if}}</span>
    {{#each mageView.tools}}<span class="r-tag r-tool">{{name}}{{#if @root.editable}} <a data-action="mageToolDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>{{/each}}
    {{#if editable}}<input type="text" class="r-ww-find r-tool-find" data-mage-tool data-combo="r-mtool-{{actor.id}}" placeholder="{{localize 'VTM20.Mage.ToolAdd'}}">
    <datalist id="r-mtool-{{actor.id}}">{{#each mageView.toolList}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
  </div>

  <h2 class="r-h2"><span>{{@root.mageView.L.Rotes}}</span>
    <span class="r-h2-tools">{{#if editable}}<a class="r-h2-btn is-ghost" data-action="mageRoteAdd" data-tooltip="{{localize 'VTM20.Mage.RoteAdd'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{@root.mageView.L.RoteAdd}}</span></a>{{/if}}</span>
  </h2>
  <ul class="r-edge-list r-rotes">
    {{#each mageView.rotes}}
    <li class="r-edge r-rote">
      <span class="r-edge-lvl"><i class="fa-solid fa-scroll"></i></span>
      <span class="r-edge-main"><b>{{name}}</b>
        <span class="r-rote-chips">{{#each chips}}<span class="r-cast-chip">{{rSym sym "r-mg"}}{{name}} <b>{{rank}}</b></span>{{else}}<small>{{spheres}}</small>{{/each}}
          <span class="r-cast-chip is-kind is-{{kind}}"><i class="fa-solid {{kindIcon}}"></i> {{kindLabel}}</span>{{#if difficulty}}<span class="r-cast-chip is-diff" data-tooltip="{{localize 'VTM20.Mage.RoteDiff'}}">{{localize "VTM20.Mage.DiffShort"}} <b>{{difficulty}}</b></span>{{/if}}</span>
        {{#if text}}<div class="r-edge-text">{{text}}</div>{{/if}}</span>
      {{#if @root.editable}}<a class="r-vc-btn" data-action="mageRoteCast" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Mage.RoteCastHint'}}"><i class="fa-solid fa-hat-wizard"></i></a>
      <a class="r-icon-btn" data-action="mageRoteEdit" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Edit'}}"><i class="fa-solid fa-pen-nib"></i></a>
      <a class="r-icon-btn is-danger" data-action="mageRoteDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{@root.mageView.L.NoRotes}}</li>
    {{/each}}
  </ul>

  {{!-- Чудеса: Талисманы, Устройства, Периапты — предметы со своим Арете и запасом Квинтэссенции --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Mage.Wonders"}}</span>
    <span class="r-h2-tools">{{#if editable}}<a class="r-h2-btn" data-action="openPack" data-pack="mage-wonders" data-tooltip="{{localize 'VTM20.Sheet.PackHint'}}"><i class="fa-solid fa-book-open-reader"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a><a class="r-h2-btn is-ghost" data-action="mageWonderCraft" data-tooltip="{{localize 'VTM20.Mage.Craft.Hint'}}"><i class="fa-solid fa-hammer"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.Craft.Short"}}</span></a><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="wonder" data-tooltip="{{localize 'VTM20.Mage.WonderAdd'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Own"}}</span></a>{{/if}}</span>
  </h2>
  <ul class="r-edge-list r-rotes r-wonders">
    {{#each mageState.wonders}}
    <li class="r-edge r-rote r-wonder" data-item-id="{{id}}">
      <span class="r-edge-lvl"><img src="{{img}}" alt=""></span>
      <span class="r-edge-main"><a data-action="itemEdit"><b>{{name}}</b></a>
        <span class="r-rote-chips"><span class="r-cast-chip is-kind">{{kindLabel}}{{#if value}} <b>{{value}}</b>{{/if}}</span>{{#if arete}}<span class="r-cast-chip">{{@root.mageView.L.Arete}} <b>{{arete}}</b></span>{{/if}}{{#each chips}}<span class="r-cast-chip">{{rSym sym "r-mg"}}{{name}} <b>{{rank}}</b></span>{{/each}}{{#if perm}}<span class="r-cast-chip is-witnessed" data-tooltip="{{localize 'VTM20.Wonder.ParadoxHint'}}"><i class="fa-solid fa-burst"></i> {{perm}}</span>{{/if}}</span></span>
      {{#if holds}}<span class="r-wonder-q" data-tooltip="{{localize 'VTM20.Wonder.QuintHint'}}">{{#if @root.editable}}<a data-action="mageWonderQuint" data-d="-1" data-tooltip="{{localize 'VTM20.Mage.WonderCharge'}}"><i class="fa-solid fa-angle-up"></i></a>{{/if}}<i class="fa-solid fa-sun"></i> <b>{{quint}}</b>/{{quintMax}}{{#if @root.editable}}<a data-action="mageWonderQuint" data-d="1" data-tooltip="{{localize 'VTM20.Mage.WonderDrain'}}"><i class="fa-solid fa-angle-down"></i></a>{{/if}}</span>{{/if}}
      {{#if @root.editable}}<a class="r-icon-btn {{#if armed}}is-on{{/if}}" data-action="mageWonderArm" data-tooltip="{{#if armed}}{{localize 'VTM20.Mage.Arm.Off'}}{{else}}{{localize 'VTM20.Mage.Arm.Hint'}}{{/if}}"><i class="fa-solid fa-shield-halved"></i></a>{{/if}}
      {{#if @root.editable}}{{#if canUse}}<a class="r-vc-btn" data-action="mageWonderUse" data-tooltip="{{localize 'VTM20.Mage.WonderUse'}}"><i class="fa-solid fa-hat-wizard"></i></a>{{/if}}
      <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a>
      <a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Mage.NoWonders"}}</li>
    {{/each}}
  </ul>

  {{!-- Инфернальные Инвестиции Падшего (Book of the Fallen): дары Патрона; у Адского пламени и Регенерации — кнопка --}}
  {{#if mageState.fallen}}
  <h2 class="r-h2"><span>{{localize "VTM20.Mage.Invest.Title"}}</span>
    <span class="r-h2-tools"><span class="r-gs-pool {{#if mageState.pacts.over}}is-diff{{/if}}" data-tooltip="{{localize 'VTM20.Mage.Pact.Rule'}}">{{localize "VTM20.Mage.Pact.Budget" spent=mageState.pacts.spent n=mageState.pacts.total}}</span>
      {{#if editable}}<a class="r-h2-btn" data-action="openPack" data-pack="mage-merits" data-tooltip="{{localize 'VTM20.Sheet.PackHint'}}"><i class="fa-solid fa-book-open-reader"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a><a class="r-h2-btn is-ghost" data-action="magePactAdd" data-tooltip="{{localize 'VTM20.Mage.Pact.Add'}}"><i class="fa-solid fa-file-signature"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.Pact.Short"}}</span></a>{{/if}}</span></h2>
  <ul class="r-edge-list r-rotes">
    {{#each mageState.pacts.list}}
    <li class="r-edge r-rote"><span class="r-edge-lvl"><i class="fa-solid fa-file-signature"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <span class="r-cast-chip is-kind is-vulgar">{{level}}</span>{{#if patron}} <small>{{patron}}</small>{{/if}}{{#if terms}}<div class="r-edge-text">{{terms}}</div>{{/if}}</span>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="magePactDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
    {{/each}}
    {{#each mageState.investments}}
    <li class="r-edge r-rote" data-item-id="{{id}}"><span class="r-edge-lvl"><i class="fa-solid fa-handshake-angle"></i></span>
      <span class="r-edge-main"><a data-action="itemEdit"><b>{{name}}</b></a> <span class="r-cast-chip is-kind is-vulgar">{{cost}}</span></span>
      {{#if @root.editable}}{{#if act}}<a class="r-vc-btn" data-action="mageInvest" data-act="{{act}}" data-tooltip="{{tip}}"><i class="fa-solid {{icon}}"></i></a>{{/if}}{{/if}}
      <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a></li>
    {{/each}}
  </ul>
  {{/if}}

  {{!-- Маг-гуль: кровь домитора в теле, узы, Дисциплины (V20, гл. 9) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Mage.Ghoul.Title"}}</span>
    <span class="r-h2-tools">{{#if editable}}{{#if mageState.ghoul.on}}{{#if mageState.ghoul.wounded}}<a class="r-h2-btn" data-action="mageGhoulHeal" data-tooltip="{{localize 'VTM20.Mage.Ghoul.HealHint'}}"><i class="fa-solid fa-droplet"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.Ghoul.Heal"}}</span></a>{{/if}}
      <a class="r-h2-btn" data-action="openPack" data-pack="disciplines" data-tooltip="{{localize 'VTM20.Sheet.PackHint'}}"><i class="fa-solid fa-book-open-reader"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Disciplines"}}</span></a>{{/if}}
      <a class="r-h2-btn is-ghost {{#if mageState.ghoul.on}}is-on{{/if}}" data-action="mageGhoul" data-tooltip="{{localize 'VTM20.Mage.Ghoul.ToggleHint'}}"><i class="fa-solid fa-hand-holding-droplet"></i> <span class="r-h2-lbl">{{#if mageState.ghoul.on}}{{localize "VTM20.Mage.Ghoul.Off"}}{{else}}{{localize "VTM20.Mage.Ghoul.On"}}{{/if}}</span></a>{{/if}}</span>
  </h2>
  {{#if mageState.ghoul.on}}
  <div class="r-focus">
    <label class="r-df is-wide"><span>{{localize "VTM20.Mage.Ghoul.Domitor"}}</span><input type="text" name="system.mage.ghoul.domitor" value="{{mageState.ghoul.domitor}}" {{#unless editable}}disabled{{/unless}}></label>
    <label class="r-df is-wide"><span>{{localize "VTM20.Mage.Ghoul.Clan"}}</span><input type="text" name="system.mage.ghoul.clan" value="{{mageState.ghoul.clan}}" {{#unless editable}}disabled{{/unless}}></label>
  </div>
  <div class="r-mstate">
    <div class="r-mstate-row is-quiet"><b>{{localize "VTM20.Mage.Ghoul.Vitae"}}</b>
      <span class="r-boxes">{{#each mageState.ghoul.boxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="mageGhoulVitae" data-n="{{n}}"{{/if}}></a>{{/each}}</span>
      <em>{{localize "VTM20.Mage.Ghoul.VitaeHint"}}</em></div>
    <div class="r-mstate-row is-quiet" data-tooltip="{{localize 'VTM20.Mage.Ghoul.BondHint'}}"><b>{{localize "VTM20.Mage.Ghoul.Bond"}}</b>
      <span class="r-dots">{{#each mageState.ghoul.bondDots}}<a class="r-dot {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</span>
      {{#if mageState.ghoul.bondText}}<em>{{mageState.ghoul.bondText}}</em>{{/if}}</div>
    <ul class="r-edge-list r-rotes">
      {{#each mageState.ghoul.discs}}
      <li class="r-edge r-rote" data-item-id="{{id}}"><span class="r-edge-lvl"><i class="fa-solid fa-droplet"></i></span>
        <span class="r-edge-main"><a data-action="itemEdit"><b>{{name}}</b></a></span>
        <span class="r-dots">{{#each dots}}<i class="r-dot {{#if filled}}is-filled{{/if}}"></i>{{/each}}</span>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{!-- Резонанс и Синергия (Book of Secrets) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Mage.ResTitle"}}</span>
    <span class="r-h2-tools">{{#if editable}}<a class="r-h2-btn is-plain" data-action="mageResCloak" data-tooltip="{{localize 'VTM20.Mage.ResCloakHint'}}"><i class="fa-solid fa-user-secret"></i></a><a class="r-h2-btn is-ghost" data-action="mageResAdd" data-tooltip="{{localize 'VTM20.Mage.ResAdd'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.ResAddShort"}}</span></a>{{/if}}</span>
  </h2>
  <div class="r-mstate">
    <ul class="r-mstate-list">
      {{#each mageState.resonances}}
      <li class="r-mstate-row {{#if top}}is-top{{/if}}"><b>{{name}}</b>{{#if flavor}} <small>{{flavor}}</small>{{/if}}
        <span class="r-dots">{{#each dots}}<a class="r-dot {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="mageResDot" data-i="{{../i}}" data-n="{{n}}"{{/if}}></a>{{/each}}</span>
        <em>{{degree}}</em>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="mageResDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
      {{else}}<li class="r-note">{{localize "VTM20.Mage.ResEmpty"}}</li>
      {{/each}}
    </ul>
    <ul class="r-mstate-list is-synergy" data-tooltip="{{localize 'VTM20.Mage.SynergyHint'}}">
      {{#each mageState.synergy}}
      <li class="r-mstate-row" data-tooltip="{{text}}"><b>{{name}}</b>
        <span class="r-dots">{{#each dots}}<a class="r-dot {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</span></li>
      {{/each}}
    </ul>
    {{#if mageState.resBonus}}<p class="r-note r-mstate-bonus {{#if mageState.resUsed}}is-spent{{/if}}"><i class="fa-solid fa-wave-square"></i>
      {{#if mageState.resUsed}}{{localize "VTM20.Mage.ResSpent"}}{{else}}{{localize "VTM20.Mage.ResReady" name=mageState.resTop n=mageState.resBonus}}{{/if}}
      {{#if editable}}<a class="r-vc-btn" data-action="mageResUsed" data-tooltip="{{localize 'VTM20.Mage.ResToggle'}}"><i class="fa-solid fa-rotate"></i></a>{{/if}}</p>{{/if}}
  </div>

  {{!-- Безмолвие и Изъяны Парадокса (M20, гл. 10) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Mage.QuietTitle"}}</span>
    <span class="r-h2-tools">{{#if editable}}{{#if mageState.quiet.level}}<a class="r-h2-btn" data-action="mageQuietExit" data-tooltip="{{localize 'VTM20.Mage.QuietExitHint'}}"><i class="fa-solid fa-eye"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.QuietExit"}}</span></a>{{/if}}<a class="r-h2-btn is-ghost" data-action="mageFlawAdd" data-tooltip="{{localize 'VTM20.Mage.FlawAdd'}}"><i class="fa-solid fa-burst"></i> <span class="r-h2-lbl">{{localize "VTM20.Mage.FlawShort"}}</span></a>{{/if}}</span>
  </h2>
  <div class="r-mstate">
    <div class="r-mstate-row is-quiet {{#if mageState.quiet.level}}is-on{{/if}}"><b>{{localize "VTM20.Mage.Quiet"}}</b>
      <span class="r-dots">{{#each mageState.quiet.dots}}<a class="r-dot {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</span>
      <select name="system.mage.quiet.kind" {{#unless editable}}disabled{{/unless}}>{{#each mageState.quiet.kinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
      {{#if mageState.quiet.text}}<em>{{mageState.quiet.text}}</em>{{/if}}</div>
    {{#if mageState.mind.inside}}
    <p class="r-note r-mind is-in"><i class="fa-solid fa-brain"></i> {{#if mageState.mind.ready}}{{localize "VTM20.Mage.MindReady"}}{{else}}{{localize "VTM20.Mage.MindLeft" n=mageState.mind.left}}{{/if}}
      {{#if editable}}{{#unless mageState.mind.ready}}<a class="r-vc-btn" data-action="mageMindShorten" data-tooltip="{{localize 'VTM20.Mage.MindShortenHint'}}"><i class="fa-solid fa-puzzle-piece"></i></a>{{/unless}}
      <a class="r-vc-btn" data-action="mageMindExit" data-tooltip="{{localize 'VTM20.Mage.MindExitHint'}}"><i class="fa-solid fa-door-open"></i></a>{{/if}}</p>
    {{else if mageState.quiet.level}}{{#if editable}}
    <p class="r-note r-mind"><i class="fa-solid fa-brain"></i> {{localize "VTM20.Mage.MindOffer" n=mageState.mind.days}}
      <a class="r-vc-btn" data-action="mageMindEnter" data-tooltip="{{localize 'VTM20.Mage.MindEnterHint'}}"><i class="fa-solid fa-person-walking-arrow-right"></i></a></p>
    {{/if}}{{/if}}
    {{#if mageState.quiet.insulate}}<p class="r-note"><i class="fa-solid fa-shield-halved"></i> {{localize "VTM20.Mage.BackInsulate" n=mageState.quiet.insulate}}</p>{{/if}}
    <ul class="r-edge-list r-rotes">
      {{#each mageState.flaws}}
      <li class="r-edge r-rote"><span class="r-edge-lvl"><i class="fa-solid fa-burst"></i></span>
        <span class="r-edge-main"><b>{{name}}</b> <span class="r-cast-chip is-kind is-vulgar">{{gradeName}}</span>{{#if text}}<div class="r-edge-text">{{text}}</div>{{/if}}</span>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="mageFlawDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
      {{/each}}
    </ul>
  </div>
</section>
