{{!-- I. Черты: характеристики и способности. Клик по названию — проверка. --}}
<section class="tab r-pane r-traits {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Attributes"}}</span></h2>
  <div class="r-cols3">
    {{#each attributeGroups}}
    <div class="r-col r-tcol">
      <h3 class="r-h3 r-colhead"><span>{{label}}</span></h3>
      {{#each list}}
      <div class="r-trait {{#if boost}}is-boosted{{/if}}">
        <div class="r-trait-main">
          <a class="r-trait-label {{#if ugly}}is-ugly{{/if}}" data-action="rollTrait" data-trait="attributes.{{key}}" {{#if ugly}}data-tooltip="{{localize 'VTM20.Weakness.ugly'}}"{{/if}}>{{label}}</a>
          {{#if canSpec}}<i class="r-spec-mark" aria-hidden="true"></i><input class="r-spec" type="text" name="system.attributes.{{key}}.specialty" value="{{specialty}}" placeholder="{{localize 'VTM20.Sheet.Specialty'}}" spellcheck="false" data-tooltip="{{specialty}}">{{/if}}
          <span class="r-leader"></span>
          {{> rDots dots=dots}}
          {{#if boost}}<span class="r-boost" data-tooltip="{{localize 'VTM20.Sheet.BloodBoost'}}">+{{boost}}</span>{{/if}}
          {{#if fx}}<span class="r-boost is-fx" data-tooltip="{{localize 'VTM20.Fx.Active'}}">{{fx}}</span>{{/if}}
          {{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.attributes.{{key}}.value" data-kind="attribute" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Abilities"}}</span></h2>
  <div class="r-cols3">
    {{#each abilityGroups}}
    <div class="r-col r-tcol">
      <h3 class="r-h3 r-colhead"><span>{{label}}</span></h3>
      {{#each list}}
      <div class="r-trait {{#unless value}}is-zero{{/unless}}">
        <div class="r-trait-main">
          <a class="r-trait-label" data-action="rollTrait" data-trait="abilities.{{key}}">{{label}}</a>
          {{#if canSpec}}<i class="r-spec-mark" aria-hidden="true"></i><input class="r-spec" type="text" name="system.abilities.{{key}}.specialty" value="{{specialty}}" placeholder="{{localize 'VTM20.Sheet.Specialty'}}" spellcheck="false" data-tooltip="{{specialty}}">{{/if}}
          <span class="r-leader"></span>
          {{> rDots dots=dots}}
          {{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.abilities.{{key}}.value" data-kind="ability" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
        </div>
      </div>
      {{/each}}

      {{#each secondary}}
      <div class="r-trait is-secondary {{#unless value}}is-zero{{/unless}}">
        <div class="r-trait-main">
          <a class="r-trait-roll" data-action="rollTrait" data-trait="secondary.{{index}}" data-tooltip="{{localize 'VTM20.Sheet.Roll'}}"><i class="fa-solid fa-dice-d10"></i></a>
          <input class="r-trait-input" type="text" name="system.secondary.{{index}}.name" value="{{name}}" placeholder="{{localize 'VTM20.Sheet.SecondaryName'}}" {{#if @root.extraAbilities.length}}data-combo="r-abil-{{@root.actor.id}}"{{/if}}>
          {{#if (gte value 4)}}<i class="r-spec-mark" aria-hidden="true"></i><input class="r-spec" type="text" name="system.secondary.{{index}}.specialty" value="{{specialty}}" placeholder="{{localize 'VTM20.Sheet.Specialty'}}" spellcheck="false" data-tooltip="{{specialty}}">{{/if}}
          {{> rDots dots=dots}}
          <a class="r-icon-btn is-danger" data-action="removeSecondary" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a>
        </div>
      </div>
      {{/each}}
      {{#if @root.editable}}<a class="r-add-line" data-action="addSecondary" data-group="{{key}}"><i class="fa-solid fa-plus"></i> {{localize (concat "VTM20.Sheet.AddSecondary." key)}}</a>{{/if}}
    </div>
    {{/each}}
  </div>
  {{!-- подсказки для названий вторичных способностей (module/ui/combo.mjs) --}}
  <datalist id="r-abil-{{@root.actor.id}}">{{#each @root.extraAbilities}}<option value="{{this}}"></option>{{/each}}</datalist>
</section>
