{{!-- I. Чары духа: свои — карточками (цена в Сущности из текста, «Применить» списывает её и пишет Чару в чат),
     общие для всех духов — строкой значков; добавить Чару и взять образец духа — кнопками в заголовке. --}}
<section class="tab r-pane r-sp-pane {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#if system.spirit.ban}}<p class="r-sp-banline"><i class="fa-solid fa-ban"></i><b>{{localize "VTM20.Werewolf.Spirit.ban"}}.</b> {{system.spirit.ban}}</p>{{/if}}

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Spirit.charms"}}</span>
    <span class="r-h2-tools">{{#if editable}}
      <span class="r-sp-add"><a class="r-h2-btn is-lib" data-action="library" data-kind="charm" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Werewolf.Spirit.addCharm"}}</a></span>
      <a class="r-h2-btn is-ghost" data-action="library" data-kind="spiritTpl" data-tooltip="{{localize 'VTM20.Werewolf.Spirit.tplHint'}}"><i class="fa-solid fa-wand-magic-sparkles"></i> <span class="r-h2-lbl">{{localize "VTM20.Werewolf.Spirit.tplShort"}}</span></a>{{/if}}</span>
  </h2>

  <div class="r-sp-cards">
    {{#each spiritOwn}}
    <article class="r-vcard r-sp-card {{#if open}}is-open{{/if}}">
      <header class="r-sp-card-head">
        <span class="r-sp-card-sym"><i class="fa-solid {{#if special}}fa-star-of-life{{else}}fa-wind{{/if}}"></i></span>
        <a class="r-sp-card-name" data-action="spCharmOpen" data-key="{{key}}"><b>{{rName this}}</b>{{#if en}}<small>{{en}}</small>{{/if}}</a>
        {{#if cost}}<span class="r-sp-cost" data-tooltip="{{localize 'VTM20.Werewolf.Spirit.costHint'}}">{{cost}}<i class="fa-solid fa-droplet"></i></span>{{/if}}
      </header>
      <div class="r-sp-card-text {{#unless open}}is-clamp{{/unless}}">{{{text}}}</div>
      <footer class="r-sp-card-foot">
        <a class="r-sp-more" data-action="spCharmOpen" data-key="{{key}}">{{#if open}}{{localize "VTM20.Werewolf.Spirit.less"}}{{else}}{{localize "VTM20.Werewolf.Spirit.more"}}{{/if}}</a>
        {{#if @root.editable}}<a class="r-btn r-sp-use" data-action="spCharmUse" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Werewolf.Spirit.useHint'}}"><i class="fa-solid fa-bolt"></i> {{localize "VTM20.Werewolf.Spirit.use"}}</a>
        <a class="r-icon-btn is-danger" data-action="spCharmDel" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </footer>
    </article>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Spirit.generalTitle"}}</span></h2>
  <div class="r-sp-general">
    {{#each spiritGeneral}}<a class="r-sp-chip" data-action="spCharmUse" data-key="{{key}}" data-tooltip="{{plain}}"><i class="fa-solid fa-circle-nodes"></i>{{rName this}}{{#if cost}} <b>{{cost}}</b>{{/if}}</a>{{/each}}
  </div>
</section>
