{{!-- II. Дисциплины: точки, силы по уровню из справочника, пути и ритуалы магии крови. --}}
<section class="tab r-pane r-disciplines {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Disciplines"}}</span>
    <span class="r-h2-tools">
      {{#if disciplines.length}}<a class="r-h2-btn is-plain" data-action="toggleAll" data-tooltip="{{localize 'VTM20.Sheet.ToggleAllHint'}}"><i class="fa-solid {{#if allOpen}}fa-angles-up{{else}}fa-angles-down{{/if}}"></i> <span class="r-h2-lbl">{{#if allOpen}}{{localize "VTM20.Sheet.CollapseAll"}}{{else}}{{localize "VTM20.Sheet.ExpandAll"}}{{/if}}</span></a>{{/if}}
      {{#if editable}}
      <a class="r-h2-btn" data-action="library" data-kind="discipline" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a>
      <a class="r-h2-btn" data-action="library" data-kind="combo" data-tooltip="{{localize 'VTM20.Library.Kinds.combo'}}"><i class="fa-solid fa-link"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Kinds.combo"}}</span></a>
      {{/if}}
    </span>
  </h2>
  {{#if activeFx.length}}
  <div class="r-fx-strip">
    <span class="r-fx-label"><i class="fa-solid fa-wand-sparkles"></i> {{localize "VTM20.Fx.Active"}}</span>
    {{#each activeFx}}<span class="r-fx-chip"><img src="{{img}}" alt=""><b>{{name}}</b><em>{{mode}}</em>{{#if @root.editable}}<a data-action="endPower" data-effect-id="{{id}}" data-tooltip="{{localize 'VTM20.Fx.End'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>{{/each}}
  </div>
  {{/if}}

  {{#if editable}}{{#if (or missingClan isGhoul)}}
  <div class="r-toolbar">
    {{#if missingClan}}<a class="r-btn is-accent" data-action="addClanDisciplines"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Sheet.AddClanDisciplines"}}</a>{{/if}}
    {{#if isGhoul}}<span class="r-note">{{localize "VTM20.Sheet.GhoulCap" n=ghoulCap}}</span>{{/if}}
  </div>
  {{/if}}{{/if}}

  {{#each disciplines}}
  <article class="r-row-wrap r-disc {{#if open}}is-open{{/if}} {{#if inClan}}is-clan{{/if}}" data-item-id="{{id}}">
    <header class="r-disc-head">
      <span class="r-disc-sigil">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>
      <div class="r-disc-title">
        <a class="r-disc-name" data-action="toggleRow" data-row-id="{{id}}">{{rName this}}</a>
        <span class="r-disc-sub">{{rAlt this}}{{#if inClan}} · <b>{{localize "VTM20.Sheet.InClan"}}</b>{{/if}}{{#if physical}} · +{{value}} {{localize "VTM20.Sheet.DiceTo"}} {{physical}}{{/if}}</span>
      </div>
      {{> rDots dots=dots cls="is-disc"}}
      <div class="r-disc-tools">
        
        <a class="r-icon-btn" data-action="rollTrait" data-trait="disciplines.{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Roll'}}"><i class="fa-solid fa-dice-d10"></i></a>
        <a class="r-icon-btn" data-action="itemEdit" data-tooltip="{{localize 'VTM20.Sheet.Edit'}}"><i class="fa-solid fa-pen-nib"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        <a class="r-icon-btn r-chevron" data-action="toggleRow" data-row-id="{{id}}" data-tooltip="{{localize 'VTM20.Sheet.Details'}}"><i class="fa-solid fa-chevron-down"></i></a>
      </div>
    </header>

    <div class="r-disc-body"><div class="r-disc-inner">
      {{!-- Лестница сил: уровни в медальонах на общей линии, следующая сила — бледной ступенькой --}}
      <div class="r-ladder">
        {{#each powers}}{{> rPower disc=../key}}{{/each}}
        {{#if nextPower}}<div class="r-next"><span class="r-power-lvl">{{rRoman nextPower.level}}</span><span class="r-next-text">{{localize "VTM20.Sheet.NextPower"}}: <b>{{rName nextPower}}</b></span></div>{{/if}}
      </div>
      {{#if ownPowers.length}}<h4 class="r-h4">{{localize "VTM20.Sheet.OwnPowers"}}</h4>{{#each ownPowers}}{{> rPower cls="is-own"}}{{/each}}{{/if}}

      {{#if isPathed}}
      {{#each paths}}
      <div class="r-path {{#if primary}}is-primary{{/if}}" data-item-id="{{id}}">
        <div class="r-path-head">
          <a class="r-icon-btn r-star" data-action="itemToggle" data-field="system.primary" data-tooltip="{{localize 'VTM20.Sheet.PrimaryPath'}}"><i class="fa-{{#if primary}}solid{{else}}regular{{/if}} fa-star"></i></a>
          <span class="r-path-name">{{rName this}}</span>
          {{> rDots dots=dots}}
          {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </div>
        {{#each powers}}{{> rPower pathId=../id disc=../../key}}{{/each}}
        {{#each ownPowers}}{{> rPower cls="is-own"}}{{/each}}
        {{#unless powers.length}}{{#unless ownPowers.length}}{{#if html}}<div class="r-path-text">{{{html}}}</div>{{/if}}{{/unless}}{{/unless}}
      </div>
      {{/each}}
      {{#if @root.editable}}{{#if pathChoices.length}}
      <div class="r-toolbar is-inner">
        <a class="r-btn" data-action="library" data-kind="path" data-discipline="{{key}}"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Sheet.AddPath"}}</a>
      </div>
      {{/if}}{{/if}}
      {{/if}}

      {{#if hasRituals}}
      <h4 class="r-h4">{{localize "VTM20.Sheet.Rituals"}}</h4>
      {{#each rituals}}
      {{> rPower cls="is-ritual"}}
      {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoRituals"}}</div>
      {{/each}}
      {{#if @root.editable}}{{#if ritualChoices}}
      <div class="r-toolbar is-inner">
        <a class="r-btn" data-action="library" data-kind="ritual" data-discipline="{{key}}"><i class="fa-solid fa-book-skull"></i> {{localize "VTM20.Sheet.AddRitual"}}</a>
      </div>
      {{/if}}{{/if}}
      {{/if}}

      {{#each rules}}
      <div class="r-row-wrap r-rule-block {{#if open}}is-open{{/if}}">
        <a class="r-rule-title" data-action="toggleRow" data-row-id="{{id}}"><i class="fa-solid fa-book"></i> {{title}}</a>
        <div class="r-power-body">{{{html}}}</div>
      </div>
      {{/each}}
    </div></div>
  </article>
  {{else}}
  <div class="r-empty">{{localize "VTM20.Sheet.NoDisciplines"}}</div>
  {{/each}}

  {{!-- Пути, ритуалы и силы, чьей Дисциплины на листе нет (купили ритуал без Тауматургии, путь чужой школы…) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.OtherPowers"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="power" data-tooltip="{{localize 'VTM20.Sheet.OwnPower'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.OwnPower"}}</span></a></span>{{/if}}
  </h2>
  {{#each otherMagic}}
  <div class="r-other-school">
    <h4 class="r-h4">{{#if key}}<span class="r-other-sigil">{{#if sym}}{{rSym sym}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span>{{name}}
      <em class="r-other-note" data-tooltip="{{localize 'VTM20.Sheet.NoDisciplineHint'}}">{{localize "VTM20.Sheet.NoDiscipline"}}</em>{{else}}{{localize "VTM20.Sheet.NoSchool"}}{{/if}}</h4>
    {{#each paths}}
    <div class="r-path {{#if primary}}is-primary{{/if}}" data-item-id="{{id}}">
      <div class="r-path-head">
        <span class="r-path-name">{{rName this}}</span>
        {{> rDots dots=dots}}
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
      </div>
      {{#each powers}}{{> rPower pathId=../id disc=../../key}}{{/each}}
      {{#each ownPowers}}{{> rPower cls="is-own"}}{{/each}}
      {{#unless powers.length}}{{#unless ownPowers.length}}{{#if html}}<div class="r-path-text">{{{html}}}</div>{{/if}}{{/unless}}{{/unless}}
    </div>
    {{/each}}
    {{#each powers}}{{> rPower cls="is-own"}}{{/each}}
    {{#each rituals}}{{> rPower cls="is-ritual"}}{{/each}}
  </div>
  {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoOtherPowers"}}</div>
  {{/each}}

  {{#if dhampir}}
  {{!-- Кровные права дампира (Accursed Heirs: Dhampirs, гл. 4): до 3 точек, силы по уровню; ритуалы Дриримантии --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Dhampir.Bloodrights"}}</span>
    <span class="r-h2-tools"><a class="r-h2-btn is-plain" data-action="openRules" data-rules="dhampir" data-tooltip="{{localize 'VTM20.Dhampir.RulesHint'}}"><i class="fa-solid fa-book-open-reader"></i></a></span>
  </h2>
  {{#if editable}}{{#if dhampir.available.length}}
  <div class="r-toolbar">
    <select class="r-dh-add" data-tooltip="{{localize 'VTM20.Dhampir.AddHint'}}"><option value="">{{localize "VTM20.Dhampir.AddPick"}}</option>{{#each dhampir.available}}<option value="{{key}}">{{name}}{{#if req}} ({{req}}){{/if}}{{#if rare}} · {{localize "VTM20.Dhampir.Rare"}}{{/if}}</option>{{/each}}</select>
    <a class="r-btn" data-action="bloodrightAdd"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Dhampir.Add"}}</a>
  </div>
  {{/if}}{{/if}}
  {{#each dhampir.rights}}
  <article class="r-edge-path r-bloodright {{#if rare}}is-rare{{/if}}">
    <header class="r-edge-head">
      <span class="r-edge-sigil"><i class="fa-solid fa-droplet"></i></span>
      <span class="r-edge-title" data-tooltip="{{text}}"><b>{{rName this}}</b> <small>{{rAlt this}}{{#if req}} · {{req}}{{/if}}{{#if rare}} · {{localize "VTM20.Dhampir.Rare"}}{{/if}}</small></span>
      {{> rDots dots=dots cls="is-disc"}}
      
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="bloodrightRemove" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
    </header>
    <ul class="r-edge-list">
      {{#each powers}}
      <li class="r-edge {{#unless on}}is-off{{/unless}}">
        <span class="r-edge-lvl">{{rRoman level}}</span>
        <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}}{{#if pool}} · {{pool}}{{/if}}{{#if cost}} · {{cost}}{{/if}}</small>
          <span class="r-edge-text">{{text}}</span></span>
        {{#if roll}}{{#if on}}<a class="r-vc-btn" data-action="bloodrightRoll" data-key="{{../key}}" data-level="{{level}}" data-tooltip="{{localize 'VTM20.Sheet.Roll'}}"><i class="fa-solid fa-dice-d10"></i></a>{{/if}}{{/if}}
      </li>
      {{/each}}
    </ul>
  </article>
  {{else}}<div class="r-empty">{{localize "VTM20.Dhampir.NoRights"}}</div>
  {{/each}}
  {{#if dhampir.dririmancy}}
  <article class="r-edge-path r-bloodright">
    <header class="r-edge-head"><span class="r-edge-sigil"><i class="fa-solid fa-book-skull"></i></span>
      <span class="r-edge-title"><b>{{localize "VTM20.Dhampir.Rituals"}}</b> <small>{{localize "VTM20.Dhampir.RitualsHint"}}</small></span></header>
    <ul class="r-edge-list">
      {{#each dhampir.rituals}}
      <li class="r-edge {{#unless known}}is-off{{/unless}}">
        <span class="r-edge-lvl">{{rRoman level}}</span>
        <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}} · {{pool}}</small><span class="r-edge-text">{{text}}</span></span>
        {{#if @root.editable}}<a class="r-vc-btn is-sq {{#if known}}is-on{{/if}}" data-action="dririToggle" data-key="{{key}}" data-tooltip="{{#if known}}{{localize 'VTM20.Dhampir.Forget'}}{{else}}{{localize 'VTM20.Dhampir.Learn'}}{{/if}}"><i class="fa-solid {{#if known}}fa-check{{else}}fa-plus{{/if}}"></i></a>{{/if}}
        {{#if known}}<a class="r-vc-btn" data-action="dririRoll" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Roll'}}"><i class="fa-solid fa-dice-d10"></i></a>{{/if}}
      </li>
      {{/each}}
    </ul>
  </article>
  {{/if}}
  {{/if}}
</section>
