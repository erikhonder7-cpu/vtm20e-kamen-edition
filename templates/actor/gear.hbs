{{!-- IV. Снаряжение: оружие с атакой, броня, вещи. --}}
<section class="tab r-pane r-gear {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="r-purse">
    <i class="fa-solid fa-coins r-purse-icon"></i>
    <span class="r-purse-label">{{localize "VTM20.Money.Purse"}}</span>
    {{#if money.coins}}<span class="r-coins" data-tooltip="{{money.text}}">{{#each money.coins}}{{#if n}}<span class="r-coin is-{{metal}}"><i></i><b>{{n}}</b> {{unit}}</span>{{/if}}{{/each}}</span>
    {{else}}<b class="r-purse-sum">{{money.text}}</b>{{/if}}
    {{#if money.paper}}<span class="r-purse-paper" data-tooltip="{{localize 'VTM20.Money.RateNow' rate=money.rate}}"><i class="fa-solid fa-scroll"></i> {{money.paper}} <em>≈ {{money.paperCoin}}</em></span>{{/if}}
    <span class="r-leader"></span>
    {{#if resources}}<span class="r-purse-res" data-tooltip="{{resources.html}}">{{localize "VTM20.Money.Resources"}} <b>{{resources.dots}}</b></span>{{/if}}
    {{#if editable}}<a class="r-btn" data-action="money"><i class="fa-solid fa-pen-nib"></i> {{localize "VTM20.Money.Edit"}}</a>{{/if}}
  </div>

  {{#if wrRelics}}
  {{!-- Реликвии и Артефакты призрака (Wraith 20, гл. 12): пробуждение за Пафос (из кристалла мягкого огня, потом свой);
       душековка (Book of Oblivion): Оценка → Работа → Отделка (apps/relics.mjs) --}}
  <h2 class="r-h2"><span data-tooltip="{{localize 'VTM20.Wraith.Relic.SectionHint'}}">{{localize "VTM20.Wraith.Relic.Section"}}</span>
    {{#if editable}}<span class="r-h2-tools">{{#unless wrRelics.forge}}<a class="r-h2-btn" data-action="wrForge" data-tooltip="{{localize 'VTM20.Wraith.Forge.Hint'}}"><i class="fa-solid fa-hammer"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Forge.Title"}}</span></a>{{/unless}}</span>{{/if}}
  </h2>
  {{#with wrRelics.forge}}
  <div class="r-vcard r-wr-forge">
    <div class="r-vc-head"><h4 class="r-banner"><span><i class="fa-solid fa-hammer"></i> {{name}}</span></h4>
      <div class="r-vc-status">{{stageLabel}}{{#if needLabel}} · <b>{{needLabel}}</b>{{/if}}</div></div>
    <p class="r-wr-forge-line">{{attr}} + {{localize "VTM20.Wraith.Forge.Crafts"}}, {{localize "VTM20.Wraith.Forge.Diff"}} <b>{{diff}}</b> · {{localize "VTM20.Wraith.Forge.Hours" n=hours}}{{#if alloyLabel}} · {{alloyLabel}}{{/if}}{{#if rough}} · {{localize "VTM20.Wraith.Relic.Rough"}}{{/if}}</p>
    {{#if cracksText}}<p class="r-wr-forge-line is-warn"><i class="fa-solid fa-burst"></i> {{cracksText}}</p>{{/if}}
    {{#if isFinish}}<div class="r-wr-forge-fx">{{#each fx}}<a class="r-vc-btn {{#if taken}}is-on{{/if}}" data-action="wrForgeFx" data-key="{{key}}">{{label}} <small>({{n}})</small></a>{{/each}}</div>{{/if}}
    {{#if @root.editable}}<div class="r-vc-tools">
      <a class="r-vc-btn" data-action="wrForgeStep"><i class="fa-solid fa-hammer"></i> {{localize "VTM20.Wraith.Forge.Step"}}</a>
      {{#if isFinish}}<a class="r-vc-btn" data-action="wrForgeDone"><i class="fa-solid fa-check"></i> {{localize "VTM20.Wraith.Forge.Complete"}}</a>{{/if}}
      <a class="r-vc-btn is-right" data-action="wrForgeDrop" data-tooltip="{{localize 'VTM20.Wraith.Forge.Abandon'}}"><i class="fa-solid fa-xmark"></i></a>
    </div>{{/if}}
  </div>
  {{/with}}
  {{#with wrRelics.empower}}
  <div class="r-vcard r-wr-forge is-empower">
    <div class="r-vc-head"><h4 class="r-banner"><span><i class="fa-solid fa-wand-magic-sparkles"></i> {{itemName}}</span></h4>
      <div class="r-vc-status">{{localize "VTM20.Wraith.Empower.Label" r=rating}} · <b>{{progress}}</b></div></div>
    <p class="r-wr-forge-line">{{localize "VTM20.Wraith.Empower.Line"}}{{#if power}} · <i>{{power}}</i>{{/if}}</p>
    <p class="r-wr-forge-line {{#unless ready}}is-warn{{/unless}}">{{localize "VTM20.Wraith.Empower.Stock" p=collected pn=needPathos m=materials mn=rating}}</p>
    {{#if @root.editable}}<div class="r-vc-tools">
      {{#if needPathos}}<a class="r-vc-btn" data-action="wrEmpGather" data-what="pathos" data-tooltip="{{localize 'VTM20.Wraith.Empower.PathosHint'}}"><i class="fa-solid fa-droplet"></i> +1</a>{{/if}}
      <a class="r-vc-btn" data-action="wrEmpGather" data-what="mat" data-tooltip="{{localize 'VTM20.Wraith.Empower.MatHint'}}"><i class="fa-solid fa-flask"></i> +1</a>
      <a class="r-vc-btn" data-action="wrEmpStep"><i class="fa-solid fa-hammer"></i> {{localize "VTM20.Wraith.Empower.Step"}}</a>
      {{#if done}}<a class="r-vc-btn" data-action="wrEmpDone"><i class="fa-solid fa-check"></i> {{localize "VTM20.Wraith.Forge.Complete"}}</a>{{/if}}
      <a class="r-vc-btn is-right" data-action="wrEmpDrop" data-tooltip="{{localize 'VTM20.Wraith.Forge.Abandon'}}"><i class="fa-solid fa-xmark"></i></a>
    </div>{{/if}}
  </div>
  {{/with}}
  <ul class="r-edge-list r-wr-relics">
    {{#each wrRelics.list}}
    <li class="r-edge" data-item-id="{{id}}">
      <span class="r-edge-lvl"><i class="fa-solid fa-ghost"></i></span>
      <span class="r-edge-main"><a class="r-trait-label" data-action="itemEdit"><b>{{name}}</b></a>
        <small>{{kind}}{{#if dots}} {{dots}}{{/if}}{{#if alloy}} · <span data-tooltip="{{alloyTip}}">{{alloy}}</span>{{/if}}{{#if aggravated}} · {{localize "VTM20.Wraith.Relic.Aggravated"}}{{/if}}{{#if crystal}} · {{localize "VTM20.Wraith.Relic.CrystalN" n=crystal}}{{/if}}{{#if rough}} · {{localize "VTM20.Wraith.Relic.Rough"}}{{/if}}</small>
        {{#if crack}}<small class="r-wr-crack"><i class="fa-solid fa-burst"></i> {{crack}}</small>{{/if}}</span>
      {{#if @root.editable}}{{#if canEmpower}}<a class="r-vc-btn is-sq" data-action="wrEmpower" data-id="{{id}}" data-tooltip="{{localize 'VTM20.Wraith.Empower.Hint'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></a>{{/if}}{{/if}}
      {{#if @root.editable}}<a class="r-vc-btn" data-action="wrRelicWake" data-id="{{id}}" data-tooltip="{{localize 'VTM20.Wraith.Relic.WakeHint'}}"><i class="fa-solid fa-wand-sparkles"></i> {{localize "VTM20.Wraith.Relic.Wake"}}{{#if pathos}} ({{pathos}}){{/if}}</a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.Relic.None"}}</li>
    {{/each}}
  </ul>
  {{/if}}

  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Weapons"}}</span>
    {{#if editable}}<span class="r-h2-tools">
      <input type="text" class="r-h2-find" data-preset="weapon" data-combo="r-wpn-{{actor.id}}" placeholder="{{localize 'VTM20.Sheet.PresetWeapon'}}">
      <a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="weapon" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Own"}}</span></a>
    </span>{{/if}}
  </h2>
  {{!-- Оружие строками, как черты листа (В3): значок-атака, название, пул и сложность, урон чипом; дальность — только у стрелкового и метательного --}}
  <div class="r-wpn-list">
    {{#each weapons}}
    <div class="r-trait r-wpn-row {{#unless equipped}}is-off{{/unless}}" data-item-id="{{id}}">
      <div class="r-trait-main">
        <a class="r-attack" data-action="rollWeapon" data-tooltip="{{localize 'VTM20.Weapon.attack'}}"><i class="fa-solid {{icon}}"></i></a>
        <span class="r-wpn-name"><a class="r-trait-label" data-action="itemEdit">{{name}}</a><small>{{kindLabel}}</small></span>
        <span class="r-leader"></span>
        <span class="r-wpn-meta">{{localize "VTM20.Weapon.pool"}} <b>{{pool}}</b> · {{localize "VTM20.Weapon.diff"}} <b>{{difficulty}}</b>{{#if range}} · <b>{{range}}</b> {{localize "VTM20.Weapon.meters"}}{{#if rate}} · {{localize "VTM20.Weapon.rate"}} <b>{{rate}}</b>{{/if}}{{#if clip}} · {{localize "VTM20.Weapon.clip"}} <b>{{clip}}</b>{{/if}}{{/if}}</span>
        <span class="r-dmg-chip is-{{damageTypeKey}}" data-tooltip="{{localize 'VTM20.Weapon.damage'}}: {{damage}}">{{damageDice}} · {{damageType}}</span>
        <span class="r-td-tools">
          <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a>
          {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        </span>
      </div>
    </div>
    {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoWeapons"}}</div>
    {{/each}}
  </div>
  {{#if editable}}
  <datalist id="r-wpn-{{actor.id}}">{{#each weaponPresetGroups}}{{#each options}}<option value="{{label}}" data-group="{{../label}}" data-key="{{value}}"></option>{{/each}}{{/each}}</datalist>
  <datalist id="r-arm-{{actor.id}}">{{#each armorPresetGroups}}{{#each options}}<option value="{{label}}" data-group="{{../label}}" data-key="{{value}}"></option>{{/each}}{{/each}}</datalist>
  <datalist id="r-gear-{{actor.id}}">{{#each gearPresetGroups}}{{#each options}}<option value="{{label}}" data-group="{{../label}}" data-key="{{value}}"></option>{{/each}}{{/each}}</datalist>
  {{/if}}

  <div class="r-cols2">
    <div class="r-col">
      <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Armor"}}</span>
        {{#if editable}}<span class="r-h2-tools"><input type="text" class="r-h2-find is-short" data-preset="armor" data-combo="r-arm-{{actor.id}}" placeholder="{{localize 'VTM20.Sheet.PresetArmor'}}"><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="armor" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i></a></span>{{/if}}
      </h2>
      {{#each armors}}
      <div class="r-trait-main r-armor {{#unless equipped}}is-off{{/unless}}" data-item-id="{{id}}">
        <a class="r-icon-btn" data-action="itemToggle" data-field="system.equipped" data-tooltip="{{localize 'VTM20.Sheet.Equip'}}"><i class="fa-solid {{#if equipped}}fa-shield-halved{{else}}fa-shield{{/if}}"></i></a>
        <a class="r-trait-label" data-action="itemEdit">{{name}}</a>
        <span class="r-leader"></span>
        <span class="r-tag">{{localize "VTM20.Armor.rating"}} {{rating}}</span>
        {{#if penalty}}<span class="r-tag is-red">−{{penalty}}</span>{{/if}}
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </div>
      {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoArmor"}}</div>
      {{/each}}
    </div>

    <div class="r-col">
      <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Gear"}}</span>
        {{#if editable}}<span class="r-h2-tools"><input type="text" class="r-h2-find is-short is-gear" data-preset="gear" data-combo="r-gear-{{actor.id}}" placeholder="{{localize 'VTM20.Sheet.PresetGear'}}"><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="gear" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i></a></span>{{/if}}
      </h2>
      {{#each gear}}
      <div class="r-trait-main" data-item-id="{{id}}">
        <img class="r-thumb" src="{{img}}" alt="">
        <a class="r-trait-label" data-action="itemEdit">{{name}}</a>
        <span class="r-leader"></span>
        <input class="r-qty" type="number" value="{{quantity}}" min="0" data-item-id="{{id}}" data-item-field="system.quantity">
        <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </div>
      {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoGear"}}</div>
      {{/each}}
    </div>
  </div>
</section>
