{{!-- II. Гару (W20): Ранг и Слава, пять форм (поправки Атрибутов — в итоге черт), Дары по уровням, ритуалы. --}}
<section class="tab r-pane r-disciplines r-edges r-gifts {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{!-- Фера (W20 Changing Breeds): род — Гару или один из 11 Изменяющихся; у Фера свои формы, Дары рода и справка --}}
  {{#if werewolfInfo.fera}}
  {{!-- Фера (W20 Changing Breeds): род и два главных выбора — в шапке листа; здесь остальные выборы, что дают выбранные и справка рода --}}
  <div class="r-ww-fera is-fera">
    {{#each werewolfInfo.restDims}}
    <label class="r-ww-fera-pick"><span>{{label}}</span>
      <select {{#unless @root.editable}}disabled{{/unless}} name="system.werewolf.feraSub.{{key}}"><option value="">—</option>{{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    {{/each}}
    <dl class="r-ww-fera-facts">
      {{#each werewolfInfo.feraDims}}{{#if text}}<dt>{{label}}: {{picked}}</dt><dd>{{{text}}}</dd>{{/if}}{{/each}}
      {{#each werewolfInfo.fera.facts}}<dt>{{@key}}</dt><dd>{{{this}}}</dd>{{/each}}
    </dl>
    <details class="r-ww-fera-more"><summary>{{localize "VTM20.Werewolf.FeraTraits"}}</summary>
      <div class="r-ww-fera-text">{{{werewolfInfo.fera.traits}}}{{{werewolfInfo.fera.formsHtml}}}</div></details>
  </div>
  {{/if}}

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.RenownRank"}}</span></h2>
  {{!-- Ранг и Слава (W20, гл. 3–4): медальон Ранга (щелчок — окно «Слава и Ранг» с наградой Славой), под ним — где Гару:
       Умбра, септ и тотем стаи; три Славы — кружки постоянной, квадратики временной, число — постоянная / нужно до Ранга --}}
  <div class="r-ww-renown is-tab">
    <div class="r-ww-rankcell">
      <a class="r-ww-rankmedal {{#if werewolfInfo.canRank}}is-ready{{/if}}" {{#if editable}}data-action="wwStanding"{{/if}}
         data-tooltip="{{localize 'VTM20.Werewolf.RenownRank'}}{{#if werewolfInfo.nextRank}}<br>{{localize 'VTM20.Werewolf.NextRank'}}: {{werewolfInfo.nextRank}}{{/if}}">
        <span class="r-ww-rm-disc"><b>{{#if werewolfInfo.rank}}{{rRoman werewolfInfo.rank}}{{else}}0{{/if}}</b></span>
        <span class="r-ww-rm-text"><small>{{localize "VTM20.Werewolf.Rank"}}</small>{{#if werewolfInfo.rankName}}<em>{{werewolfInfo.rankName}}</em>{{/if}}</span>
      </a>
      <div class="r-ww-where">
        <a class="r-vc-btn {{#if werewolfInfo.umbra}}is-umbra{{/if}}" data-action="wwUmbra" data-tooltip="{{localize 'VTM20.Umbra.Title'}}{{#if werewolfInfo.umbra}}: {{werewolfInfo.umbra.name}}{{/if}}"><i class="fa-solid fa-moon"></i> {{#if werewolfInfo.umbra}}{{werewolfInfo.umbra.name}}{{else}}{{localize "VTM20.Werewolf.UmbraShort"}}{{/if}}</a>
        <a class="r-vc-btn" data-action="wwSept" data-tooltip="{{#if werewolfInfo.sept}}{{werewolfInfo.sept.name}}{{#each werewolfInfo.sept.posts}} · {{name}}{{/each}}{{else}}{{localize 'VTM20.Sept.Title'}}{{/if}}"><i class="fa-solid fa-campground"></i> {{#if werewolfInfo.sept}}{{werewolfInfo.sept.name}}{{else}}{{localize "VTM20.Sept.Title"}}{{/if}}</a>
        {{#if werewolfInfo.packTotem.totem}}<span class="r-vc-hint" data-tooltip="{{werewolfInfo.packTotem.pack}}: {{werewolfInfo.packTotem.totem.individual}}"><i class="fa-solid fa-feather-pointed"></i> {{werewolfInfo.packTotem.totem.name}}</span>{{/if}}
      </div>
    </div>
    {{#each werewolfInfo.renown}}
    <div class="r-vcard r-vc-renown is-{{key}}">
      <div class="r-vc-head">
        <h4 class="r-banner">{{label}}</h4>
        <div class="r-vc-status {{#if met}}is-met{{/if}}" data-tooltip="{{#if need}}{{localize 'VTM20.Werewolf.RenownStatusTip'}}{{else}}{{localize 'VTM20.Werewolf.Permanent'}}{{/if}}">{{#if ready}}<i class="fa-solid fa-medal r-ww-ready" data-tooltip="{{localize 'VTM20.Werewolf.RenownTempTip' n=temp}}"></i> {{/if}}<b>{{perm}}</b>{{#if need}} / {{need}}{{/if}}</div>
      </div>
      {{> rDots dots=dots cls="is-ten is-renown"}}
      <div class="r-boxes is-renown">
        {{#each tempDots}}<a class="r-box {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
      </div>
    </div>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Forms"}}</span></h2>
  <div class="r-ww-forms">
    {{#each werewolfInfo.forms}}
    <a class="r-ww-form {{#if active}}is-active{{/if}}" {{#unless active}}{{#if @root.editable}}data-action="wwForm" data-form="{{key}}"{{/if}}{{/unless}}
       data-tooltip="{{localize 'VTM20.Werewolf.ShiftDiff' n=diff}}{{#if mods}} · {{mods}}{{/if}}{{#if delirium}} · {{localize 'VTM20.Werewolf.Delirium'}}{{/if}}">
      <i class="fa-solid {{icon}}"></i><b>{{rName this}}</b><small>{{localize "VTM20.Roll.Vs"}} {{diff}}</small>
    </a>
    {{/each}}
  </div>

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Gifts"}}</span>
    <span class="r-h2-tools">{{#if editable}}<a class="r-h2-btn" data-action="library" data-kind="gift" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a>{{/if}}
      <a class="r-h2-btn is-plain" data-action="openRules" data-tooltip="{{localize 'VTM20.Werewolf.RulesHint'}}"><i class="fa-solid fa-book-open-reader"></i></a></span>
  </h2>
  {{#if editable}}{{#if ww.avail.length}}
  <div class="r-toolbar r-ww-add">
    <input type="text" class="r-ww-find" data-ww-add="gift" data-combo="r-wwg-{{actor.id}}" placeholder="{{localize 'VTM20.Werewolf.FindGift'}}" data-tooltip="{{localize 'VTM20.Werewolf.AddGiftHint'}}">
    <datalist id="r-wwg-{{actor.id}}">{{#each ww.avail}}<option value="{{label}}" data-key="{{key}}"></option>{{/each}}</datalist>
  </div>
  {{/if}}{{/if}}
  <ul class="r-edge-list r-ww-gifts">
    {{#each ww.gifts}}
    <li class="r-edge {{#unless own}}is-foreign{{/unless}}">
      <span class="r-edge-lvl">{{rRoman level}}</span>
      <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}}{{#if from}} · {{from}}{{/if}}{{#if pool}} · {{pool}}{{/if}}{{#if cost}} · {{cost}}{{/if}}</small>
        <div class="r-edge-text">{{{text}}}</div></span>
      {{#if @root.editable}}<a class="r-vc-btn" data-action="wwGift" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Werewolf.GiftUse'}}"><i class="fa-solid {{#if roll}}fa-dice-d10{{else}}fa-hand-sparkles{{/if}}"></i></a>
      <a class="r-icon-btn is-danger" data-action="wwGiftDel" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Werewolf.NoGifts"}}</li>
    {{/each}}
  </ul>

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Rites"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="library" data-kind="rite" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a></span>{{/if}}
  </h2>
  {{#if editable}}{{#if ww.ritesAvail.length}}
  <div class="r-toolbar r-ww-add">
    <input type="text" class="r-ww-find" data-ww-add="rite" data-combo="r-wwr-{{actor.id}}" placeholder="{{localize 'VTM20.Werewolf.FindRite'}}" data-tooltip="{{localize 'VTM20.Werewolf.AddRiteHint'}}">
    <datalist id="r-wwr-{{actor.id}}">{{#each ww.ritesAvail}}<option value="{{label}}" data-key="{{key}}"></option>{{/each}}</datalist>
  </div>
  {{/if}}{{/if}}
  <ul class="r-edge-list r-ww-rites">
    {{#each ww.rites}}
    <li class="r-edge">
      <span class="r-edge-lvl">{{#if level}}{{rRoman level}}{{else}}—{{/if}}</span>
      <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}} · {{kindName}} · {{pool}}</small>
        <div class="r-edge-text">{{{text}}}</div></span>
      {{#if @root.editable}}<a class="r-vc-btn" data-action="wwRite" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Werewolf.RiteUse'}}"><i class="fa-solid fa-dice-d10"></i></a>
      <a class="r-icon-btn is-danger" data-action="wwRiteDel" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Werewolf.NoRites"}}</li>
    {{/each}}
  </ul>

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Fetishes"}}</span></h2>
  {{#if editable}}<div class="r-toolbar r-ww-add">
    <input type="text" class="r-ww-find r-ww-fetish-find" data-ww-add="fetish" data-combo="r-wwf-{{actor.id}}" placeholder="{{localize 'VTM20.Werewolf.FindFetish'}}">
    <datalist id="r-wwf-{{actor.id}}">{{#each ww.fetishAvail}}{{#unless talen}}<option value="{{label}}" data-key="{{key}}" data-group="{{localize 'VTM20.Werewolf.FetishGroup'}}"></option>{{/unless}}{{/each}}{{#each ww.fetishAvail}}{{#if talen}}<option value="{{label}}" data-key="{{key}}" data-group="{{localize 'VTM20.Werewolf.TalenGroup'}}"></option>{{/if}}{{/each}}</datalist>
    <a class="r-vc-btn" data-action="wwFetishAdd"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
    <a class="r-vc-btn" data-action="wwFetishCraft" data-tooltip="{{localize 'VTM20.Werewolf.CraftHint'}}"><i class="fa-solid fa-hand-sparkles"></i> {{localize "VTM20.Werewolf.Craft"}}</a>
  </div>{{/if}}
  <ul class="r-edge-list r-ww-fetishes">
    {{#each ww.fetishes}}
    <li class="r-edge {{#if talen}}is-talen{{/if}}">
      <span class="r-edge-lvl">{{#if talen}}<i class="fa-solid fa-feather"></i>{{else}}{{rRoman level}}{{/if}}</span>
      <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}} · {{localize "VTM20.Werewolf.Gnosis"}} {{gnosis}}{{#if talen}} · ×{{n}}{{else}}{{#if attuned}} · {{localize "VTM20.Werewolf.Attuned"}}{{else if rejected}} · <em class="is-warn">{{localize "VTM20.Werewolf.RejectedShort"}}</em>{{else}} · <em>{{localize "VTM20.Werewolf.NotAttunedShort"}}</em>{{/if}}{{/if}}</small>
        <div class="r-edge-text">{{{text}}}</div></span>
      {{#if @root.editable}}
      {{#unless talen}}{{#unless attuned}}{{#if rejected}}{{#if @root.isGM}}<a class="r-vc-btn" data-action="wwFetishReconcile" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Werewolf.ReconcileHint'}}"><i class="fa-solid fa-handshake-simple"></i></a>{{/if}}{{else}}<a class="r-vc-btn" data-action="wwFetishAttune" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Werewolf.AttuneHint'}}"><i class="fa-solid fa-link"></i></a>{{/if}}{{/unless}}{{/unless}}
      <a class="r-vc-btn" data-action="wwFetishUse" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Werewolf.UseHint'}}"><i class="fa-solid fa-gem"></i></a>
      <a class="r-icon-btn is-danger" data-action="wwFetishDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Werewolf.NoFetishes"}}</li>
    {{/each}}
  </ul>

  {{#if ww.showDeform}}
  {{!-- Уродства метиса (W20, гл. 1; Changing Ways): у части есть механика — поглощение, Внешность, укус (models.mjs) --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Deformities"}}</span></h2>
  <ul class="r-edge-list r-ww-deforms">
    {{#each ww.deformities}}<li class="r-edge"><span class="r-edge-lvl"><i class="fa-solid fa-bone-break"></i></span>
      <span class="r-edge-main"><b>{{rName this}}</b> <small>{{rAlt this}}{{#if fx}} · {{localize "VTM20.Werewolf.DeformFx"}}{{/if}} · {{source}}</small><div class="r-edge-text">{{{text}}}</div></span>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wwDeformDel" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
    {{else}}<li class="r-note {{#if ww.needDeform}}is-warn{{/if}}">{{localize "VTM20.Werewolf.NoDeformities"}}</li>{{/each}}
  </ul>
  {{#if editable}}<div class="r-toolbar r-ww-add"><input type="text" class="r-ww-find" data-ww-add="deform" data-combo="r-wwd-{{actor.id}}" placeholder="{{localize 'VTM20.Werewolf.FindDeformity'}}">
    <datalist id="r-wwd-{{actor.id}}">{{#each ww.deformAvail}}<option value="{{label}}" data-key="{{key}}"></option>{{/each}}</datalist></div>{{/if}}
  {{/if}}

  <h2 class="r-h2"><span>{{localize "VTM20.Werewolf.Scars"}}</span></h2>
  {{#if editable}}<div class="r-toolbar r-ww-add"><input type="text" class="r-ww-find" data-ww-add="scar" data-combo="r-wws-{{actor.id}}" placeholder="{{localize 'VTM20.Werewolf.FindScar'}}">
    <datalist id="r-wws-{{actor.id}}">{{#each ww.scarAvail}}<option value="{{label}}" data-key="{{key}}"></option>{{/each}}</datalist></div>{{/if}}
  <ul class="r-edge-list r-ww-scars">
    {{#each ww.scars}}<li class="r-edge"><span class="r-edge-lvl"><i class="fa-solid fa-bandage"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <small>+{{glory}} {{localize "VTM20.Werewolf.RenownShort.glory"}}</small><div class="r-edge-text">{{{effect}}}</div></span>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wwScarDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</li>
    {{else}}<li class="r-note">{{localize "VTM20.Werewolf.NoScars"}}</li>{{/each}}
  </ul>
</section>
