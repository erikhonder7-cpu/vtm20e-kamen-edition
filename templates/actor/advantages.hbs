{{!-- III. Преимущества: факты биографии, достоинства и недостатки, расстройства, узы крови. --}}
<section class="tab r-pane r-advantages {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{#if weakness}}
  {{!-- Изъян клана: свёрнут до заголовка (с уточнением игрока), раскрывается щелчком --}}
  <div class="r-row-wrap r-weakness-card {{#if weaknessOpen}}is-open{{/if}}">
    <div class="r-weakness-head">
      {{#if sigil.sym}}{{rSym sigil.sym}}{{/if}}
      <a class="r-weakness-title" data-action="toggleRow" data-row-id="weakness">{{localize "VTM20.Sheet.Weakness"}} · {{weaknessTitle}}</a>
      {{#if system.weaknessNote}}<em class="r-weakness-note">{{system.weaknessNote}}</em>{{/if}}
      {{#if weaknessCheck}}<a class="r-chip" data-action="rollVirtue" data-kind="weakness"><i class="fa-solid fa-dice-d10"></i> {{weaknessCheck}}</a>{{/if}}
      <a class="r-icon-btn r-chevron" data-action="toggleRow" data-row-id="weakness"><i class="fa-solid fa-chevron-down"></i></a>
    </div>
    <div class="r-weakness-text">{{{weakness}}}</div>
    <div class="r-weakness-foot">
      <input type="text" name="system.weaknessNote" value="{{system.weaknessNote}}" placeholder="{{localize 'VTM20.Sheet.WeaknessNote'}}">
      {{#if soilClan}}<label class="r-soil">{{localize "VTM20.Weakness.soilDays"}} <input type="number" name="system.soilDays" value="{{system.soilDays}}" min="0" max="10"></label>{{/if}}
      {{#if lightClan}}<span class="r-hint">{{localize "VTM20.Weakness.light"}}</span>{{/if}}
    </div>
  </div>
  {{/if}}

  <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Backgrounds"}}</span>{{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="library" data-kind="background" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="background" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Own"}}</span></a></span>{{/if}}</h2>
  <div class="r-cols2">
    {{#each backgrounds}}
    <div class="r-row-wrap r-bg {{#if open}}is-open{{/if}}" data-item-id="{{id}}">
      <div class="r-trait-main">
        <a class="r-trait-label" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
        <span class="r-leader"></span>
        {{> rDots dots=dots}}
        <a class="r-icon-btn" data-action="itemEdit"><i class="fa-solid fa-pen-nib"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </div>
      <div class="r-power-body">{{{html}}}</div>
    </div>
    {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoBackgrounds"}}</div>
    {{/each}}
  </div>

  <div class="r-cols2 r-mf">
    {{#each mfColumns}}
    <div class="r-col">
      <h2 class="r-h2"><span>{{localize label}}</span><em class="r-h2-total">{{total}}</em>{{#if @root.editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="library" data-kind="{{key}}" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Own"}}</span></a></span>{{/if}}</h2>
      {{#each list}}
      <div class="r-row-wrap r-mf-row {{#if open}}is-open{{/if}}" data-item-id="{{id}}">
        <div class="r-trait-main">
          <span class="r-cost">{{cost}}</span>
          <a class="r-trait-label" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
          <span class="r-leader"></span>
          <span class="r-tag">{{category}}</span>
          <a class="r-icon-btn" data-action="itemEdit"><i class="fa-solid fa-pen-nib"></i></a>
          {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </div>
        <div class="r-power-body">{{{html}}}</div>
      </div>
      {{else}}<div class="r-empty">{{#if (eq key "merit")}}{{localize "VTM20.Sheet.NoMerits"}}{{else}}{{localize "VTM20.Sheet.NoFlaws"}}{{/if}}</div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <div class="r-cols2">
    <div class="r-col">
      <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Derangements"}}</span>{{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="library" data-kind="derangement" data-tooltip="{{localize 'VTM20.Library.Open'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Library.Open"}}</span></a><a class="r-h2-btn is-ghost" data-action="itemCreate" data-type="derangement" data-tooltip="{{localize 'VTM20.Sheet.Own'}}"><i class="fa-solid fa-feather"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Own"}}</span></a></span>{{/if}}</h2>
      {{#each derangements}}
      <div class="r-row-wrap r-mf-row {{#if open}}is-open{{/if}}" data-item-id="{{id}}">
        <div class="r-trait-main">
          <i class="fa-solid fa-brain r-muted"></i>
          <a class="r-trait-label" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
          <span class="r-leader"></span>
          {{#if permanent}}<span class="r-tag is-red">{{localize "VTM20.Sheet.Permanent"}}</span>{{/if}}
          <a class="r-icon-btn" data-action="itemEdit"><i class="fa-solid fa-pen-nib"></i></a>
          {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete"><i class="fa-solid fa-xmark"></i></a>{{/if}}
        </div>
        <div class="r-power-body">{{{html}}}</div>
      </div>
      {{else}}<div class="r-empty">{{localize "VTM20.Sheet.NoDerangements"}}</div>
      {{/each}}
    </div>

    {{#unless isMortal}}
    <div class="r-col">
      <h2 class="r-h2"><span>{{localize "VTM20.Sheet.Bonds"}}</span>{{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="addBond" data-tooltip="{{localize 'VTM20.Sheet.Add'}}"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Sheet.Add"}}</span></a></span>{{/if}}</h2>
      {{#each bonds}}
      <div class="r-trait-main r-bond">
        <select name="system.bonds.{{index}}.role" class="r-mini-select">
          <option value="regnant" {{#if (eq role "regnant")}}selected{{/if}}>{{localize "VTM20.Bond.regnant"}}</option>
          <option value="thrall" {{#if (eq role "thrall")}}selected{{/if}}>{{localize "VTM20.Bond.thrall"}}</option>
        </select>
        <input class="r-trait-input" type="text" name="system.bonds.{{index}}.name" value="{{name}}" placeholder="{{localize 'VTM20.Bond.name'}}">
        {{> rDots dots=dots}}
        {{#if isRegnant}}{{#if ../editable}}
        <a class="r-icon-btn" data-action="drinkBond" data-index="{{index}}" data-tooltip="{{localize 'VTM20.BondX.Drink'}} · {{tip}}"><i class="fa-solid fa-droplet"></i></a>
        <a class="r-icon-btn" data-action="resistBond" data-index="{{index}}" data-tooltip="{{localize 'VTM20.BondX.Resist'}}"><i class="fa-solid fa-hand-fist"></i></a>
        {{/if}}{{/if}}
        <a class="r-icon-btn is-danger" data-action="removeBond" data-index="{{index}}"><i class="fa-solid fa-xmark"></i></a>
      </div>
      {{else}}<div class="r-empty">{{localize "VTM20.Bond.none"}}</div>
      {{/each}}
      <p class="r-hint">{{localize "VTM20.Bond.hint"}}</p>
    </div>
    {{/unless}}
  </div>
</section>
