{{!-- Шапка «дела»: портрет с подписью (поколение), имя и амплуа, сведения строками, справа — запас крови;
     под сведениями, рядом с портретом, — полоса ночных действий. --}}
<header class="r-head">
  {{#if sigil.sym}}{{rSym sigil.sym "r-head-watermark"}}{{/if}}

  <div class="r-head-main">
    <figure class="r-portrait-frame {{portraitState.cls}}" style="--wound: {{portraitState.wound}}">
      <img class="r-portrait" src="{{actor.img}}" data-edit="img" data-action="editImage" alt="{{actor.name}}" title="{{actor.name}}">
      <span class="r-portrait-veil" aria-hidden="true"></span>
      {{#if portraitState.badges.length}}
      <span class="r-portrait-badges">
        {{#each portraitState.badges}}<a class="r-pbadge {{#if hot}}is-hot{{/if}}" {{#if id}}data-action="clearStatus" data-status="{{id}}" data-tooltip="{{label}} — {{localize 'VTM20.Sheet.ClearStatus'}}"{{else}}data-tooltip="{{label}}"{{/if}}><i class="fa-solid {{icon}}"></i></a>{{/each}}
      </span>
      {{/if}}
      <figcaption class="r-seal {{#if diablerie.veins}}has-veins{{/if}}" {{#if isVampire}}data-tooltip="{{localize 'VTM20.Details.generation'}}: {{system.generation}}{{#if diablerie}}<br>{{localize 'VTM20.Diablerie.Mark' victim=diablerie.victim from=diablerie.from to=diablerie.to}}{{#if diablerie.veins}}<br>{{localize 'VTM20.Diablerie.Veins' date=diablerie.until}}{{/if}}{{/if}}"{{/if}}>
        {{#if diablerie.veins}}<i class="fa-solid fa-skull r-seal-veins"></i>{{/if}}
        {{#if isVampire}}<span class="r-seal-num">{{rRoman system.generation}}</span><span class="r-seal-cap">{{localize "VTM20.Sheet.Gen"}}</span>
        {{#if editable}}<i class="fa-solid fa-chevron-down r-seal-caret"></i><select name="system.generation" data-dtype="Number" class="r-seal-select" aria-label="{{localize 'VTM20.Details.generation'}}">{{#each generations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{rRoman value}} — {{value}}</option>{{/each}}</select>{{/if}}
        {{else if isDemon}}<span class="r-seal-num r-seal-icon"><i class="fa-solid fa-fire-flame-curved"></i></span><span class="r-seal-cap">{{#if house}}{{house.name}}{{else}}{{typeLabel}}{{/if}}</span>
        {{else if werewolfSeal}}<span class="r-seal-num r-seal-icon r-seal-glyph">{{rSym werewolfSeal.sym "r-wg"}}</span><span class="r-seal-cap">{{werewolfSeal.label}}</span>
        {{else if isCreature}}<span class="r-seal-num r-seal-icon"><i class="fa-solid fa-paw"></i></span><span class="r-seal-cap">{{typeLabel}}</span>
        {{else if isGhoul}}<span class="r-seal-num r-seal-icon"><i class="fa-solid {{#if isRevenant}}fa-dna{{else}}fa-hand-holding-droplet{{/if}}"></i></span><span class="r-seal-cap">{{typeLabel}}</span>
        {{else}}<span class="r-seal-num r-seal-icon"><i class="fa-solid fa-heart-pulse"></i></span><span class="r-seal-cap">{{typeLabel}}</span>{{/if}}
      </figcaption>
    </figure>

    <div class="r-head-info">
      <div class="r-kicker">
        <span class="r-kicker-type">{{#if earthbound}}{{localize "VTM20.Creator.Earthbound"}}{{else if thrallInfo}}{{localize "VTM20.Creator.Thrall"}}{{else}}{{typeLabel}}{{/if}}</span>
        {{#if clan.nickname}}<i class="r-kicker-dia"></i><em class="r-kicker-nick is-link" data-action="clanAtlas" data-tooltip="{{localize 'VTM20.Clans.Open'}}">«{{clan.nickname}}»</em>{{/if}}
        {{#if house}}<i class="r-kicker-dia"></i><em class="r-kicker-nick is-link" data-action="houseAtlas" data-tooltip="{{localize 'VTM20.Demon.AtlasOpen'}}">«{{house.akkadian}}»</em>{{/if}}
        {{#if sectSym}}<i class="r-kicker-dia"></i>{{rSym sectSym "r-sym-inline"}}{{/if}}
        <span class="r-motto" aria-hidden="true">{{#if earthbound}}Adorate me{{else if isDemon}}Non serviam{{else if isWerewolf}}Pro Gaia{{else if isHunter}}Vigilate{{else}}La Liberté ou la Mort{{/if}}</span>
      </div>
      <div class="r-name-row">
        <input class="r-name {{nameSize}}" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'VTM20.Sheet.Name'}}" spellcheck="false">
        <input class="r-concept" type="text" name="system.details.concept" value="{{system.details.concept}}" placeholder="{{localize 'VTM20.Details.concept'}}…" spellcheck="false">
      </div>

      <div class="r-dossier {{#if isDemon}}is-demon{{/if}}">
        {{#if isVampire}}
        <label class="r-df is-wide" {{#if clan}}data-tooltip="{{clan.disciplinesText}}"{{/if}}><span>{{localize "VTM20.Details.clan"}}</span>
          <select name="system.clan">
            {{#each clanGroups}}<optgroup label="{{label}}">{{#each clans}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</optgroup>{{/each}}
          </select>
        </label>
        {{#if clanChoices}}
        <label class="r-df"><span>{{localize "VTM20.Details.clanChoice"}}</span>
          <select name="system.clanChoice"><option value="">—</option>{{#each clanChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
        {{/if}}
        <label class="r-df"><span>{{localize "VTM20.Details.sect"}}</span>
          <input type="text" name="system.details.sect" value="{{system.details.sect}}" data-combo="r-sect-{{actor.id}}"></label>
        <label class="r-df"><span>{{localize "VTM20.Details.sire"}}</span><input type="text" name="system.details.sire" value="{{system.details.sire}}"></label>
        {{/if}}

        {{#if isGhoul}}
        {{!-- Гуль ↔ ревенант: у ревенанта вместо домитора — семейство (своя витэ, семейные Дисциплины и изъян) --}}
        <label class="r-df"><span>{{localize "VTM20.Details.ghoulType"}}</span>
          <select name="system.ghoulType">{{#each ghoulTypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{#if isDhampir}}
        <label class="r-df is-wide" data-tooltip="{{dhampirConceptTip}}"><span>{{localize "VTM20.Dhampir.Concept"}}</span>
          <select name="system.dhampir.concept"><option value="">—</option>{{#each dhampirConcepts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-df"><span>{{localize "VTM20.Dhampir.Antecedent"}}</span><input type="text" name="system.dhampir.antecedent" value="{{system.dhampir.antecedent}}"></label>
        <label class="r-df" {{#if dhampirWeakness}}data-tooltip="{{localize 'VTM20.Dhampir.WeaknessOf'}}: {{dhampirWeakness}}"{{/if}}><span>{{localize "VTM20.Dhampir.AntecedentClan"}}</span>
          <select name="system.dhampir.antecedentClan"><option value="">—</option>{{#each antecedentClans}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{else if isRevenant}}
        <label class="r-df is-wide"><span>{{localize "VTM20.Details.family"}}</span>
          <select name="system.family"><option value="">—</option>{{#each families}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{else}}
        <label class="r-df is-wide"><span>{{localize "VTM20.Details.domitor"}}</span><input type="text" name="system.domitor" value="{{system.domitor}}"></label>
        <label class="r-df is-check" data-tooltip="{{localize 'VTM20.Ghoul.RetainerTip'}}"><input type="checkbox" name="system.retainer" {{checked system.retainer}}><span>{{localize "VTM20.Ghoul.Retainer"}}</span></label>
        <label class="r-df"><span>{{localize "VTM20.Revenant.DomitorClan"}}</span>
          <select name="system.domitorClan"><option value="">—</option>{{#each domitorClans}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-df is-narrow"><span>{{localize "VTM20.Details.donorGeneration"}}</span>
          <select name="system.domitorGeneration" data-dtype="Number">{{#each donorGenerations}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
        {{/if}}
        {{/if}}

        {{#if isCreature}}
        <label class="r-df is-wide"><span>{{localize "VTM20.Sheet.Kind"}}</span><input type="text" name="system.kind" value="{{system.kind}}"></label>
        <label class="r-df is-narrow r-sp-toggle" data-tooltip="{{localize 'VTM20.Werewolf.Spirit.toggleHint'}}"><span>{{localize "VTM20.Werewolf.Spirit.title"}}</span><input type="checkbox" name="system.spirit.on" {{checked system.spirit.on}}></label>
        <label class="r-df is-narrow"><span>{{localize "VTM20.Sheet.BloodPool"}}</span><input type="number" name="system.blood.max" value="{{system.blood.max}}" min="0" max="100"></label>
        <label class="r-df is-check"><input type="checkbox" name="system.supernatural" {{checked system.supernatural}}><span>{{localize "VTM20.Sheet.Supernatural"}}</span></label>
        {{/if}}

        {{#if isDemon}}
        {{!-- Падший: Дом, Облик (Знание, чья форма), фракция; ниже — Натура, Маска, игрок; последней строкой — имена пополам --}}
        <label class="r-df is-house" {{#if house}}data-tooltip="{{house.text}}"{{/if}}><span>{{localize "VTM20.Demon.House"}}</span>
          <select name="system.house"><option value="">—</option>{{#each houses}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-df is-visage" {{#if visageLore}}data-tooltip="{{visageLore}}"{{/if}}><span>{{localize "VTM20.Demon.Visage"}}</span>
          <select name="system.visage"><option value="">—</option>{{#each visages}}<option value="{{value}}" {{#if selected}}selected{{/if}} title="{{lore}}">{{label}}</option>{{/each}}</select></label>
        <label class="r-df is-faction"><span>{{localize "VTM20.Demon.Faction"}}</span>
          <select name="system.faction"><option value="">—</option>{{#each factions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{/if}}

        {{#if isWerewolf}}
        {{!-- Гару (W20): порода, аугурия (фаза луны), племя (тотем); Ранг, Слава, Ярость и Гнозис — в шкалах --}}
        {{#if werewolfInfo.fera}}
        {{!-- Фера (W20 Changing Breeds): вместо породы и аугурии Гару — выбор внутри рода (порода, аспект, племя…) --}}
        {{#each werewolfInfo.headDims}}
        <label class="r-df {{#if @last}}is-wide{{/if}}"><span>{{label}}</span>
          <select name="system.werewolf.feraSub.{{key}}"><option value="">—</option>{{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        {{/each}}
        {{!-- род; «Гару» в этом же списке возвращает к Гару --}}
        <label class="r-df" data-tooltip="{{werewolfInfo.fera.en}}"><span>{{localize "VTM20.Werewolf.FeraKind"}}</span>
          <select name="system.werewolf.fera">{{#each werewolfInfo.feraOptions}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{else}}
        <label class="r-df" data-tooltip="{{werewolfInfo.breed.notes}}"><span>{{localize "VTM20.Werewolf.Breed"}}</span>
          <select name="system.werewolf.breed">{{#each werewolfInfo.breeds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        <label class="r-df" data-tooltip="{{werewolfInfo.auspice.role}}"><span>{{localize "VTM20.Werewolf.Auspice"}}</span>
          <select name="system.werewolf.auspice">{{#each werewolfInfo.auspices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{!-- племя; ниже в том же списке — роды Фера (значение «~род» переключает в Фера: models.mjs, _preUpdate) --}}
        <label class="r-df is-wide" data-tooltip="{{localize 'VTM20.Werewolf.Totem'}}: {{werewolfInfo.tribe.totem}}"><span>{{localize "VTM20.Werewolf.Tribe"}}</span>
          <select name="system.werewolf.tribe">{{#each werewolfInfo.tribes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            <optgroup label="{{localize 'VTM20.Werewolf.FeraGroup'}}">{{#each werewolfInfo.feraOptions}}{{#if key}}<option value="~{{key}}">{{label}}</option>{{/if}}{{/each}}</optgroup></select></label>
        {{/if}}
        <span class="r-df-break"></span>
        {{/if}}
        {{#if isHunter}}
        <label class="r-df is-wide r-df-creed" {{#if creedTip}}data-tooltip="{{creedTip}}"{{/if}}><span>{{localize "VTM20.Hunter.Creed"}}</span>
          <select name="system.hunter.creed">{{#each creeds}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}} · {{who}}</option>{{/each}}</select></label>
        {{/if}}
        {{#if isMortal}}
        <label class="r-df"><span>{{localize "VTM20.Details.age"}}</span><input type="text" name="system.details.age" value="{{system.details.age}}"></label>
        <label class="r-df is-wide"><span>{{localize "VTM20.Details.haven"}}</span><input type="text" name="system.details.haven" value="{{system.details.haven}}"></label>
        {{/if}}

        <label class="r-df is-arch" {{#if natureRegain}}data-tooltip="{{localize 'VTM20.Sheet.NatureRegain'}} {{natureRegain}}"{{/if}}><span>{{localize "VTM20.Details.nature"}}</span>
          <input type="text" name="system.details.nature" value="{{system.details.nature}}" data-combo="r-arch-{{actor.id}}"></label>
        <label class="r-df is-arch"><span>{{localize "VTM20.Details.demeanor"}}</span>
          <input type="text" name="system.details.demeanor" value="{{system.details.demeanor}}" data-combo="r-arch-{{actor.id}}"></label>
        <label class="r-df is-player"><span>{{localize "VTM20.Details.player"}}</span><input type="text" name="system.details.player" value="{{system.details.player}}"></label>
        {{#if isDemon}}
        <label class="r-df is-names"><span>{{localize "VTM20.Demon.Celestial"}}</span><input type="text" name="system.names.celestial" value="{{system.names.celestial}}"></label>
        <label class="r-df is-names"><span>{{localize "VTM20.Demon.TrueName"}}</span><input type="text" name="system.names.trueName" value="{{system.names.trueName}}"></label>
        {{/if}}
      </div>
    </div>

    {{#if hasBlood}}
    <aside class="r-assignat">
      <div class="r-assignat-head">
        <span class="r-assignat-title">{{localize "VTM20.Sheet.BloodPool"}}</span>
        <span class="r-assignat-num"><b>{{system.blood.value}}</b><small>/{{system.blood.max}}</small></span>
      </div>
      <div class="r-drops">
        {{#each bloodBoxes}}<a class="r-drop {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"><svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 2C12 2 4 12 4 18a8 8 0 0 0 16 0C20 12 12 2 12 2z"/></svg></a>{{/each}}
      </div>
      <div class="r-assignat-meta">
        <span>{{localize "VTM20.Sheet.PerTurn"}} <b>{{system.blood.perTurn}}</b></span>
        <a data-action="spendBlood" data-tooltip="{{localize 'VTM20.Sheet.SpendBlood'}}"><i class="fa-solid fa-minus"></i></a>
        <a data-action="bloodHeal" data-tooltip="{{localize 'VTM20.Sheet.HealHint'}}"><i class="fa-solid fa-hand-holding-droplet"></i></a>
        {{#if isDhampir}}<a data-action="drinkVitae" data-tooltip="{{localize 'VTM20.Dhampir.DrinkHint'}}"><i class="fa-solid fa-wine-glass"></i></a>{{/if}}
        {{#if anyBoost}}<a data-action="clearBoosts" data-tooltip="{{localize 'VTM20.Sheet.ClearBoosts'}}"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
      </div>
      {{#if isDhampir}}{{#if system.dhampir.vitae}}<div class="r-assignat-meta r-dh-vitae" data-tooltip="{{localize 'VTM20.Dhampir.VitaeHint'}}"><span>{{localize "VTM20.Dhampir.Vitae"}} <b>{{system.dhampir.vitae}}</b></span>{{#if editable}}<a data-action="setVitae" data-n="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}</div>{{/if}}{{/if}}
      <div class="r-boosts">
        {{#each boosts}}<a class="r-boost-chip {{#if value}}is-on{{/if}}" data-action="boost" data-attr="{{key}}" data-tooltip="{{label}}: {{localize 'VTM20.Sheet.BoostHint'}}">{{short}}{{#if value}} <b>+{{value}}</b>{{/if}}</a>{{/each}}
      </div>
    </aside>
    {{/if}}

    {{#if isDemon}}
    {{!-- Вера вместо запаса крови: временная — языками пламени, постоянная — точками --}}
    <aside class="r-assignat is-faith">
      <div class="r-assignat-head">
        <span class="r-assignat-title">{{localize "VTM20.Demon.Faith"}}</span>
        <span class="r-assignat-num"><b>{{system.faith.temporary}}</b><small>/{{system.faith.permanent}}</small></span>
      </div>
      <div class="r-drops">
        {{#each faithBoxes}}<a class="r-drop {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"><svg viewBox="0 0 24 30" aria-hidden="true"><path d="M12 1c1 5 7 8 7 16a7 7 0 0 1-14 0c0-4 2-6 3-8 0 3 1 5 3 5-1-5 1-9 1-13z"/></svg></a>{{/each}}
      </div>
      <div class="r-faith-perm">{{> rDots dots=faithPerm cls="is-ten"}}</div>
      <div class="r-assignat-meta">
        <span>{{#if system.apocalyptic}}<em>{{localize "VTM20.Demon.FormActive"}}</em>{{/if}}</span>
        <a data-action="spendFaith" data-tooltip="{{localize 'VTM20.Demon.SpendFaith'}}"><i class="fa-solid fa-minus"></i></a>
        <a data-action="harvestFaith" data-tooltip="{{localize 'VTM20.Demon.HarvestTip'}}"><i class="fa-solid fa-wheat-awn"></i></a>
        <a data-action="pactFaith" data-tooltip="{{localize 'VTM20.Demon.PactFaithTip'}}"><i class="fa-solid fa-file-signature"></i></a>
        <a data-action="apocalyptic" data-tooltip="{{#if system.apocalyptic}}{{localize 'VTM20.Demon.FormDrop'}}{{else}}{{localize 'VTM20.Demon.FormTake'}}{{/if}}" {{#if system.apocalyptic}}class="is-on"{{/if}}><i class="fa-solid fa-dragon"></i></a>
      </div>
    </aside>
    {{/if}}

    {{#unless needsCreation}}
    <nav class="r-head-acts">
      {{#if hasBlood}}<a class="r-act" data-action="hunt" data-tooltip="{{localize 'VTM20.Hunt.Button'}}"><i class="fa-solid fa-moon"></i><span>{{localize "VTM20.Hunt.Button"}}</span></a>{{/if}}
      {{#if isDemon}}
      {{!-- Падший: Жатва Веры, апокалиптическая форма, Вера по договорам на новый день --}}
      <a class="r-act" data-action="harvestFaith" data-tooltip="{{localize 'VTM20.Demon.HarvestTip'}}"><i class="fa-solid fa-wheat-awn"></i><span>{{localize "VTM20.Demon.ActHarvest"}}</span></a>
      <a class="r-act {{#if system.apocalyptic}}is-on{{/if}}" data-action="apocalyptic" data-tooltip="{{#if system.apocalyptic}}{{localize 'VTM20.Demon.FormDrop'}}{{else}}{{localize 'VTM20.Demon.FormTake'}}{{/if}}"><i class="fa-solid fa-dragon"></i><span>{{localize "VTM20.Demon.ActForm"}}</span></a>
      <a class="r-act is-minor" data-action="revelation" data-tooltip="{{localize 'VTM20.Demon.RevealTip'}}"><i class="fa-solid fa-eye"></i><span>{{localize "VTM20.Demon.RevealShort"}}</span></a>
      <a class="r-act is-minor" data-action="pactFaith" data-tooltip="{{localize 'VTM20.Demon.PactFaithTip'}}"><i class="fa-solid fa-file-signature"></i><span>{{localize "VTM20.Demon.ActPacts"}}</span></a>
      {{/if}}
      {{#if isVampire}}<a class="r-act is-minor" data-action="awaken" data-tooltip="{{localize 'VTM20.Sheet.Awaken'}}"><i class="fa-solid fa-cloud-moon"></i><span>{{localize "VTM20.Sheet.AwakenShort"}}</span></a>{{/if}}
      <a class="r-act is-minor" data-action="downtime" data-tooltip="{{localize 'VTM20.Downtime.Tip'}}"><i class="fa-solid fa-hourglass-half"></i><span>{{localize "VTM20.Downtime.Short"}}</span></a>
      <a class="r-act" data-action="attack" data-tooltip="{{localize 'VTM20.Combat.Attack'}}"><i class="fa-solid fa-khanda"></i><span>{{localize "VTM20.Combat.Attack"}}</span></a>
      <a class="r-act" data-action="rollInitiative" data-tooltip="{{localize 'VTM20.Sheet.Initiative'}}"><i class="fa-solid fa-bolt"></i><span>{{localize "VTM20.Sheet.Initiative"}}</span><b>{{system.initiative}}</b></a>
      <a class="r-act is-minor" data-action="takeDamage" data-tooltip="{{localize 'VTM20.Sheet.TakeDamageShort'}}"><i class="fa-solid fa-heart-crack"></i><span>{{localize "VTM20.Sheet.TakeDamageShort"}}</span></a>
      <a class="r-act is-minor" data-action="hazard" data-tooltip="{{localize 'VTM20.Hazard.Title'}}"><i class="fa-solid fa-triangle-exclamation"></i><span>{{localize "VTM20.Hud.Hazard"}}</span></a>
      {{#if isWerewolf}}
      {{!-- Гару: действия боя и превращения — наверху; Умбра, септ, Слава и Бред — на вкладке шкал у Ярости и Гнозиса --}}
      <a class="r-act" data-action="wwActions" data-tooltip="{{localize 'VTM20.Werewolf.ActionsHint'}}"><i class="fa-solid fa-forward-fast"></i><span>{{localize "VTM20.Werewolf.Actions"}}</span></a>
      <a class="r-act is-minor" data-action="wwRegen" data-tooltip="{{localize 'VTM20.Werewolf.RegenHint'}}"><i class="fa-solid fa-heart-pulse"></i><span>{{localize "VTM20.Werewolf.Regen"}}</span></a>
      <a class="r-act is-minor" data-action="wwStep" data-tooltip="{{localize 'VTM20.Werewolf.StepHint'}}"><i class="fa-solid fa-circle-half-stroke"></i><span>{{localize "VTM20.Werewolf.StepSideways"}}</span></a>
      <a class="r-act is-minor" data-action="wwDelirium" data-tooltip="{{localize 'VTM20.Werewolf.DeliriumBtnHint'}}"><i class="fa-solid fa-eye-low-vision"></i><span>{{localize "VTM20.Werewolf.DeliriumBtn"}}</span></a>
      {{#if haranoProne}}<a class="r-act is-minor" data-action="wwHarano" data-tooltip="{{localize 'VTM20.Werewolf.HaranoCheckHint'}}"><i class="fa-solid fa-cloud-rain"></i><span>{{localize "VTM20.Werewolf.HaranoShort"}}</span></a>{{/if}}
      <a class="r-act is-minor" data-action="wwPrimal" data-tooltip="{{localize 'VTM20.Werewolf.Primal.hint'}}"><i class="fa-solid fa-paw"></i><span>{{localize "VTM20.Werewolf.Primal.short"}}</span></a>
      {{/if}}
      {{#if weaknessCheck}}<a class="r-act" data-action="rollVirtue" data-kind="weakness" data-tooltip="{{weaknessCheck}}"><i class="fa-solid fa-dice-d10"></i><span>{{weaknessCheck}}</span></a>{{/if}}
      <span class="r-acts-spacer"></span>
      {{#if isDemon}}<a class="r-act is-hot" data-action="tormentSin" data-tooltip="{{localize 'VTM20.Demon.SinHint'}}"><i class="fa-solid fa-skull"></i><span>{{localize "VTM20.Demon.Sin"}}</span></a>{{/if}}
      {{#if wwDown}}<a class="r-act is-hot" data-action="wwStayUp" data-tooltip="{{localize 'VTM20.Werewolf.StayUpHint'}}"><i class="fa-solid fa-person-rays"></i><span>{{localize "VTM20.Werewolf.StayUp"}}</span></a>{{/if}}
      {{#if isWerewolf}}<a class="r-act is-hot" data-action="wwFrenzy" data-tooltip="{{localize 'VTM20.Werewolf.FrenzyHint'}}"><i class="fa-solid fa-fire"></i><span>{{localize "VTM20.Werewolf.Frenzy"}}</span></a>{{/if}}
      {{#unless (or isDemon isWerewolf)}}<a class="r-act is-hot" data-action="rollVirtue" data-kind="frenzy" data-tooltip="{{localize 'VTM20.Roll.frenzy.title'}}"><i class="fa-solid fa-face-angry"></i><span>{{localize "VTM20.Roll.frenzy.title"}}</span></a>{{/unless}}
      {{#if isVampire}}<a class="r-act is-hot" data-action="diablerie" data-tooltip="{{localize 'VTM20.Diablerie.Title'}}"><i class="fa-solid fa-skull"></i><span>{{localize "VTM20.Diablerie.Short"}}</span></a>{{/if}}
      {{#if isGhoul}}<a class="r-act is-hot" data-action="rollVirtue" data-kind="rapture" data-tooltip="{{localize 'VTM20.Roll.rapture.hint'}}"><i class="fa-solid fa-heart-pulse"></i><span>{{localize "VTM20.Roll.rapture.title"}}</span></a>{{/if}}
      {{#unless (or isMortal isDemon isDhampir isWerewolf)}}<a class="r-act is-hot" data-action="rollVirtue" data-kind="rotschreck" data-tooltip="{{localize 'VTM20.Roll.rotschreck.title'}}"><i class="fa-solid fa-fire"></i><span>{{localize "VTM20.Roll.rotschreck.title"}}</span></a>{{/unless}}
    </nav>
    {{/unless}}
  </div>

  <datalist id="r-arch-{{actor.id}}">{{#each archetypes}}<option value="{{this}}"></option>{{/each}}</datalist>
  <datalist id="r-sect-{{actor.id}}">{{#each sects}}<option value="{{value}}"></option>{{/each}}</datalist>
</header>
