{{!-- Лист котерии, стаи или ячейки охотников (module/sheets/group-sheet.mjs) — в языке листа персонажа. --}}
<div class="r-gs is-{{system.kind}}">
  <header class="r-head r-gs-head">
    {{#if cabal.sym}}<span class="r-gs-watermark r-gs-sign" aria-hidden="true">{{rSym cabal.sym "r-mg"}}</span>{{else}}<i class="fa-solid {{icon}} r-gs-watermark" aria-hidden="true"></i>{{/if}}
    <div class="r-head-main r-gs-main">
      <figure class="r-portrait-frame">
        <img class="r-portrait" src="{{actor.img}}" {{#if editable}}data-action="editImage" data-edit="img"{{/if}} alt="{{actor.name}}">
        <figcaption class="r-seal"><span class="r-seal-num r-seal-icon">{{#if cabal.sym}}{{rSym cabal.sym "r-mg"}}{{else}}<i class="fa-solid {{icon}}"></i>{{/if}}</span><span class="r-seal-cap">{{sealLabel}}</span></figcaption>
      </figure>
      <div class="r-head-info">
        <div class="r-kicker"><span class="r-kicker-type">{{#if vampiric}}{{typeLabel}}{{else}}{{kindLabel}}{{/if}}</span><span class="r-motto" aria-hidden="true">{{#if cabal}}Ascensio{{else if circle}}Memento mori{{else if motley}}Ex somnio{{else}}Liberté, Égalité, Fraternité{{/if}}</span></div>
        <div class="r-name-row"><input class="r-name" type="text" name="name" value="{{actor.name}}" spellcheck="false" {{#unless editable}}disabled{{/unless}}></div>
        <div class="r-dossier">
          <label class="r-df"><span>{{localize "VTM20.Group.KindLabel"}}</span>
            <select name="system.kind" {{#unless editable}}disabled{{/unless}}>{{#each kinds}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label class="r-df is-wide"><span>{{localize "VTM20.Group.Domain"}}</span>
            <select name="system.domain" {{#unless editable}}disabled{{/unless}}><option value="">—</option>{{#each domains}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
          {{#if cell}}<label class="r-df is-wide"><span>{{localize "VTM20.Group.Net"}}</span><input type="text" name="system.net" value="{{system.net}}" placeholder="{{localize 'VTM20.Group.NetHint'}}" {{#unless editable}}disabled{{/unless}}></label>{{/if}}
        </div>
      </div>
      <div class="r-gs-tally"><b>{{members.length}}</b><span>{{localize "VTM20.Group.Members"}}</span></div>
    </div>
  </header>

  <div class="r-gs-body">
    <h2 class="r-h2"><span>{{localize "VTM20.Group.Members"}}</span>
      {{#if sabbat}}{{#if gm}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="vaulderie" data-tooltip="{{localize 'VTM20.Vinc.RiteTip'}}"><i class="fa-solid fa-wine-glass"></i> <span class="r-h2-lbl">{{localize "VTM20.Vinc.Rite"}}</span></a></span>{{/if}}{{/if}}</h2>
    <div class="r-gs-gallery">
      {{#each members}}
      <article class="r-gs-card">
        <a class="r-gs-face" data-action="openActor" data-id="{{id}}" data-tooltip="{{localize 'VTM20.Group.OpenSheet'}}"><img src="{{img}}" alt=""></a>
        <div class="r-gs-who">
          <a class="r-gs-cname" data-action="openActor" data-id="{{id}}">{{name}}</a>
          <span class="r-gs-ctype">{{type}}</span>
          {{#if line}}<span class="r-gs-cline">{{line}}</span>{{/if}}
          {{#if concept}}<span class="r-gs-cconcept">{{concept}}</span>{{/if}}
          {{#if wraith}}<span class="r-gs-cquint r-gs-cwraith"><span data-tooltip="{{localize 'VTM20.Wraith.Pathos'}}"><i class="fa-solid fa-heart-pulse"></i> {{wraith.pathos}}/{{wraith.pathosMax}}</span>
            <span data-tooltip="{{localize 'VTM20.Wraith.Corpus'}}"><i class="fa-solid fa-ghost"></i> {{wraith.corpus}}/{{wraith.corpusMax}}</span>
            <span data-tooltip="{{localize 'VTM20.Willpower'}}"><i class="fa-solid fa-shield-halved"></i> {{wraith.will}}</span>
            {{#if @root.gm}}<span data-tooltip="{{localize 'VTM20.Wraith.Angst'}}"><i class="fa-solid fa-skull"></i> {{wraith.angst}}</span>{{/if}}</span>{{/if}}
          {{#if mage}}<span class="r-gs-cquint"><i class="fa-solid fa-sun"></i> {{mage.quint}}{{#if @root.editable}} <a data-action="nodeDraw" data-id="{{id}}" data-tooltip="{{localize 'VTM20.Group.NodeDrawHint'}}"><i class="fa-solid fa-hand-holding-droplet"></i></a>{{/if}}</span>{{/if}}
        </div>
        {{#if ../editable}}<a class="r-gs-x" data-action="dropMember" data-id="{{id}}" data-tooltip="{{localize 'VTM20.Group.Drop'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </article>
      {{/each}}
      {{#if editable}}<div class="r-gs-dropzone" data-drop="members"><i class="fa-solid fa-user-plus"></i><span>{{localize "VTM20.Group.DropMember"}}</span></div>{{/if}}
    </div>

    {{#if cabal}}
    {{!-- Чантри кабала: размах по очкам общего пула, Узел и его выработка, общий запас Квинтэссенции и Тасса --}}
    <h2 class="r-h2"><span>{{localize "VTM20.Group.Chantry"}}{{#if cabal.name}} — {{cabal.name}}{{/if}}</span>
      <span class="r-h2-tools">{{#if cabal.tier}}<span class="r-gs-pool">{{cabal.tier}}</span>{{/if}}{{#if editable}}<a class="r-h2-btn" data-action="nodeWeek" data-tooltip="{{localize 'VTM20.Group.NodeWeekHint' free=cabal.weekFree tass=cabal.weekTass}}"><i class="fa-solid fa-calendar-week"></i> <span class="r-h2-lbl">{{localize "VTM20.Group.NodeWeek"}}</span></a>{{/if}}</span></h2>
    <div class="r-dossier r-gs-chantry">
      <label class="r-df is-wide"><span>{{localize "VTM20.Group.ChantryName"}}</span><input type="text" name="system.chantry.name" value="{{cabal.name}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="r-df"><span>{{localize "VTM20.Group.ChantrySignLabel"}}</span>
        <select name="system.chantry.sign" {{#unless editable}}disabled{{/unless}}>{{#each cabal.signs}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label class="r-df" data-tooltip="{{localize 'VTM20.Group.ChantryPointsHint'}}"><span>{{localize "VTM20.Group.ChantryPoints"}}</span><input type="number" name="system.chantry.points" value="{{cabal.points}}" min="0" {{#unless editable}}disabled{{/unless}}></label>
      <label class="r-df" data-tooltip="{{localize 'VTM20.Group.NodeRateHint'}}"><span>{{localize "VTM20.Group.NodeRate"}}</span><input type="number" name="system.chantry.rate" value="{{cabal.rate}}" min="1" max="10" {{#unless editable}}disabled{{/unless}}></label>
      <label class="r-df is-wide"><span>{{localize "VTM20.Mage.Resonance"}}</span><input type="text" name="system.chantry.resonance" value="{{cabal.resonance}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <div class="r-gs-haven">
      <div class="r-gs-scale is-row"><span class="r-gs-stat-cap">{{localize "VTM20.Group.Node"}}</span>
        <i class="r-gs-dots">{{#each cabal.nodeDots}}<b class="{{#if on}}on{{/if}}" {{#if @root.editable}}data-action="nodeStock"{{/if}} data-key="node" data-n="{{n}}"></b>{{/each}}</i>
        <small>{{localize "VTM20.Group.NodeYield" n=cabal.week free=cabal.weekFree tass=cabal.weekTass}}</small></div>
      <div class="r-gs-scale is-row"><span class="r-gs-stat-cap">{{localize "VTM20.Group.Library"}}</span>
        <i class="r-gs-dots">{{#each cabal.libDots}}<b class="{{#if on}}on{{/if}}" {{#if @root.editable}}data-action="nodeStock"{{/if}} data-key="library" data-n="{{n}}"></b>{{/each}}</i>
        <small>{{localize "VTM20.Group.LibraryHint"}}</small></div>
    </div>
    <div class="r-gs-tallies r-gs-stock">
      <div><b>{{cabal.quint}}</b><span>{{localize "VTM20.Group.StockQuint"}}</span>{{#if editable}}<em><a data-action="nodeStock" data-key="quint" data-d="-1"><i class="fa-solid fa-minus"></i></a><a data-action="nodeStock" data-key="quint" data-d="1"><i class="fa-solid fa-plus"></i></a></em>{{/if}}</div>
      <div><b>{{cabal.tass}}</b><span>{{localize "VTM20.Group.StockTass"}}</span>{{#if editable}}<em><a data-action="nodeStock" data-key="tass" data-d="-1"><i class="fa-solid fa-minus"></i></a><a data-action="nodeStock" data-key="tass" data-d="1"><i class="fa-solid fa-plus"></i></a></em>{{/if}}</div>
      <div><b>{{cabal.week}}</b><span>{{localize "VTM20.Group.StockWeek"}}</span></div>
    </div>
    {{/if}}

    {{#if motley}}
    {{!-- Мотли подменышей: фригольд (C20, гл. 7) — рейтинг, владелец, баэлфайр; «Ночь во фригольде» — Гламур спящим (apps/changeling.mjs) --}}
    <h2 class="r-h2"><span>{{localize "VTM20.Changeling.Freehold.Title"}}{{#if motley.freehold}} — {{motley.freehold}}{{/if}}</span>
      <span class="r-h2-tools">{{#if editable}}<a class="r-h2-btn" data-action="sanctuary" data-tooltip="{{localize 'VTM20.Changeling.Freehold.SanctuaryHint'}}"><i class="fa-solid fa-fire"></i> <span class="r-h2-lbl">{{localize "VTM20.Changeling.Freehold.Sanctuary"}}</span></a>
        <a class="r-h2-btn" data-action="reave" data-tooltip="{{localize 'VTM20.Changeling.Reave.Hint'}}"><i class="fa-solid fa-hand-holding-hand"></i> <span class="r-h2-lbl">{{localize "VTM20.Changeling.Reave.Title"}}</span></a>{{/if}}</span></h2>
    <div class="r-dossier r-gs-chantry">
      <label class="r-df is-wide"><span>{{localize "VTM20.Changeling.Freehold.Name"}}</span><input type="text" name="system.motley.freehold" value="{{motley.freehold}}" {{#unless editable}}disabled{{/unless}}></label>
      <label class="r-df"><span>{{localize "VTM20.Changeling.Freehold.Owner"}}</span><select name="system.motley.owner" {{#unless editable}}disabled{{/unless}}>{{#each motley.owners}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label class="r-df is-wide"><span>{{localize "VTM20.Changeling.Freehold.Balefire"}}</span><input type="text" name="system.motley.balefire" value="{{motley.balefire}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    <div class="r-gs-haven">
      <div class="r-gs-scale is-row"><span class="r-gs-stat-cap">{{localize "VTM20.Changeling.Freehold.Rating"}}</span>
        <i class="r-gs-dots">{{#each motley.dots}}<b class="{{#if on}}on{{/if}}" {{#if @root.editable}}data-action="freehold"{{/if}} data-key="rating" data-n="{{n}}"></b>{{/each}}</i>
        <small>{{localize "VTM20.Changeling.Freehold.RatingHint" n=motley.rating}}</small></div>
    </div>
    {{!-- Book of Freeholds: архетип, черты, Силы, причуда; Владений нужно — очки / 3 --}}
    <div class="r-dossier r-gs-chantry">
      <label class="r-df" data-tooltip="{{motley.archText}}"><span>{{localize "VTM20.Changeling.Freehold.Archetype"}}</span><select name="system.motley.archetype" {{#unless editable}}disabled{{/unless}}>{{#each motley.archetypes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
      <label class="r-df" data-tooltip="{{localize 'VTM20.Changeling.Freehold.TH.passages'}}"><span>{{localize "VTM20.Changeling.Freehold.T.passages"}}</span><input type="number" name="system.motley.passages" value="{{motley.passages}}" min="0" max="10" {{#unless editable}}disabled{{/unless}}></label>
      <label class="r-df is-wide"><span>{{localize "VTM20.Changeling.Freehold.Quirk"}}</span><input type="text" name="system.motley.quirk" value="{{motley.quirk}}" {{#unless editable}}disabled{{/unless}}></label>
    </div>
    {{#if motley.archText}}<p class="r-hint">{{motley.archText}}</p>{{/if}}
    <div class="r-gs-haven">
      {{#each motley.traits}}<div class="r-gs-scale is-row"><span class="r-gs-stat-cap" data-tooltip="{{hint}}">{{label}}</span>
        <i class="r-gs-dots">{{#each dots}}<b class="{{#if on}}on{{/if}}" {{#if @root.editable}}data-action="freehold"{{/if}} data-key="{{../key}}" data-n="{{n}}"></b>{{/each}}</i><small>{{hint}}</small></div>{{/each}}
    </div>
    <div class="r-checks r-cl-fh-powers">{{#each motley.powers}}<label class="r-check" data-tooltip="{{text}}"><input type="checkbox" {{#if on}}checked{{/if}} {{#if @root.editable}}data-action="freehold" data-power="{{key}}"{{else}}disabled{{/if}}> {{name}} <small>{{cost}}</small></label>{{/each}}</div>
    <p class="r-hint">{{localize "VTM20.Changeling.Freehold.Cost" pts=motley.pts n=motley.holdings}}</p>
    <p class="r-hint">{{localize "VTM20.Changeling.Freehold.Rules"}}</p>
    {{/if}}

    {{#if circle}}
    {{!-- Круг призраков: общее Обиталище (общий факт) и крусибл «Орфея» (apps/circle.mjs) --}}
    <h2 class="r-h2"><span>{{localize "VTM20.Wraith.Circle.Title"}}</span>
      <span class="r-h2-tools">{{#if circle.crucible}}<span class="r-gs-pool"><i class="fa-solid fa-link"></i> {{localize "VTM20.Wraith.Circle.Crucible"}}</span>{{/if}}
        {{#if gm}}{{#if circle.crucible}}<a class="r-h2-btn" data-action="unbond"><i class="fa-solid fa-link-slash"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Circle.Unbond"}}</span></a>
        {{else}}<a class="r-h2-btn" data-action="bond" data-tooltip="{{localize 'VTM20.Wraith.Circle.BondHint'}}"><i class="fa-solid fa-link"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Circle.Bond"}}</span></a>{{/if}}{{/if}}</span></h2>
    <div class="r-gs-tallies">
      <div><b>{{#if circle.haunt}}{{circle.haunt}}{{else}}—{{/if}}</b><span>{{localize "VTM20.Wraith.Circle.Haunt"}}</span></div>
    </div>
    <p class="r-hint">{{#if circle.haunt}}{{localize "VTM20.Wraith.Circle.HauntHint" n=circle.haunt}}{{else}}{{localize "VTM20.Wraith.Circle.HauntNone"}}{{/if}}</p>
    <p class="r-hint">{{#if circle.crucible}}{{localize "VTM20.Wraith.Circle.CrucibleHint"}}{{else}}{{localize "VTM20.Wraith.Circle.NoCrucible"}}{{/if}}</p>
    {{/if}}

    <div class="r-gs-cols">
      <section>
        <h2 class="r-h2"><span>{{localize "VTM20.Group.Pools"}}</span>
          <span class="r-h2-tools"><a class="r-h2-btn" data-action="pools"><i class="fa-solid fa-people-roof"></i> <span class="r-h2-lbl">{{localize "VTM20.Group.PoolsOpen"}}</span></a></span></h2>
        {{#each pools}}<div class="r-gs-line"><span>{{bg}}{{#if primary}} <i class="fa-solid fa-anchor r-gs-anchor" data-tooltip="{{localize 'VTM20.Group.Primary'}}"></i>{{/if}}</span>
          <i class="r-gs-dots">{{#each dots}}<b class="{{#if this}}on{{/if}}"></b>{{/each}}</i></div>
        {{else}}<p class="r-gs-empty">{{localize "VTM20.Group.NoPools"}}</p>{{/each}}
      </section>
      <section>
        <h2 class="r-h2"><span>{{localize "VTM20.Group.Domain"}}</span></h2>
        {{#if domain}}
        <a class="r-gs-domain" data-action="openActor" data-id="{{domain.id}}">
          <img src="{{domain.img}}" alt=""><span><b>{{domain.name}}</b><i class="r-gs-dots">{{#each domain.dots}}<b class="{{#if this}}on{{/if}}"></b>{{/each}}</i></span>
        </a>
        {{else}}<div class="r-gs-dropzone is-slim" data-drop="domain"><i class="fa-solid fa-city"></i><span>{{localize "VTM20.Group.DropDomain"}}</span></div>{{/if}}
      </section>
    </div>

    {{#if vampiric}}
    {{!-- «Общее убежище» (V20 Anarchs Unbound): точки общего факта — между роскошью, размером и защитой --}}
    <h2 class="r-h2"><span>{{localize "VTM20.Group.HavenTitle"}}</span><span class="r-h2-tools"><span class="r-gs-src">Anarchs Unbound</span>
      {{#if haven.pool}}<span class="r-gs-pool {{#if haven.over}}is-diff{{/if}}">{{localize "VTM20.Group.HavenUsed" used=haven.used n=haven.pool}}</span>{{/if}}</span></h2>
    <div class="r-gs-haven">
      {{#each haven.rows}}
      <div class="r-gs-scale is-row">
        <span class="r-gs-stat-cap">{{label}}</span>
        <i class="r-gs-dots">{{#each dots}}<b class="{{#if on}}on{{/if}}" {{#if @root.editable}}data-action="haven"{{/if}} data-key="{{../key}}" data-n="{{n}}"></b>{{/each}}</i>
        <small>{{hint}}</small>
      </div>
      {{/each}}
    </div>
    {{#unless haven.pool}}<p class="r-hint">{{localize "VTM20.Group.HavenNoPool"}}</p>{{/unless}}
    {{/if}}

    {{#if totem}}
    <h2 class="r-h2"><span>{{localize "VTM20.Group.Totem"}} — {{totem.name}}</span></h2>
    <dl class="r-gs-dl">
      <dt>{{localize "VTM20.Group.TotemEach"}}</dt><dd>{{{totem.individual}}}</dd>
      <dt>{{localize "VTM20.Group.TotemPack"}}</dt><dd>{{{totem.pack}}}</dd>
      <dt>{{localize "VTM20.Group.TotemBan"}}</dt><dd>{{{totem.ban}}}</dd>
    </dl>
    {{!-- запасы тотема на историю (тратит любой член стаи вместо своих очков), запрет и принятие тотема --}}
    {{#if totem.banned}}<p class="r-hint is-warn"><i class="fa-solid fa-ban"></i> {{localize "VTM20.Group.TotemBannedNote"}}</p>{{/if}}
    {{#if totem.pools.length}}
    <div class="r-gs-totem-pools">
      {{#each totem.pools}}
      <div class="r-vcard">
        <div class="r-vc-head"><h4 class="r-banner">{{label}}</h4><div class="r-vc-status"><b>{{left}}</b> / {{max}}</div></div>
        <div class="r-boxes">{{#each boxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if (and filled ../../editable)}}data-action="totemSpend" data-key="{{../key}}" data-tooltip="{{localize 'VTM20.Group.TotemSpendHint'}}"{{/if}}></a>{{/each}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}
    <div class="r-gs-totem-acts">
      {{#if totem.pools.length}}{{#if editable}}<a class="r-btn" data-action="totemRefill" data-tooltip="{{localize 'VTM20.Group.TotemRefillHint'}}"><i class="fa-solid fa-rotate"></i> {{localize "VTM20.Group.TotemRefill"}}</a>{{/if}}{{/if}}
      {{#if gm}}
      <a class="r-btn is-accent" data-action="totemAccept" data-tooltip="{{localize 'VTM20.Group.TotemAcceptHint'}}"><i class="fa-solid fa-feather-pointed"></i> {{localize "VTM20.Group.TotemAccept"}}</a>
      {{#if totem.banned}}<a class="r-btn" data-action="totemBan" data-on="0"><i class="fa-solid fa-hands-praying"></i> {{localize "VTM20.Group.TotemContrition"}}</a>
      {{else}}<a class="r-btn" data-action="totemBan" data-on="1"><i class="fa-solid fa-ban"></i> {{localize "VTM20.Group.TotemBanBroken"}}</a>{{/if}}
      {{/if}}
    </div>
    {{/if}}

    {{#if cell}}
    <h2 class="r-h2"><span>{{localize "VTM20.Group.Cell"}}</span></h2>
    <div class="r-gs-tallies">{{#each cell}}<div><b>{{n}}</b><span>{{label}}</span></div>{{/each}}</div>
    {{/if}}

    <h2 class="r-h2"><span>{{localize "VTM20.Group.Notes"}}</span></h2>
    <textarea class="r-gs-notes" name="system.notes" rows="5" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
  </div>
</div>
