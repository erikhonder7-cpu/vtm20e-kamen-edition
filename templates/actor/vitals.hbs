{{!-- Шкалы: здоровье, воля, Человечность или Путь с Добродетелями. Шапка карточки — название и число в одну строку. --}}
<section class="r-vitals-wrap {{#if vitalsClosed}}is-closed{{/if}}">
{{!-- Торпор и Окончательная смерть (план 9): плашка над шкалами --}}
{{#if death}}
<div class="r-fate-plate is-dead">
  <span class="r-fate-title">{{localize "VTM20.Torpor.Death.Title"}}</span>
  <span class="r-fate-meta">{{death.at}} · <i>{{death.cause}}</i></span>
  <span class="r-fate-note">{{localize "VTM20.Torpor.Death.Note"}}</span>
  {{#if isGM}}<a class="r-h2-btn" data-action="undoDeath"><i class="fa-solid fa-rotate-left"></i> {{localize "VTM20.Torpor.Death.Undo"}}</a>{{/if}}
</div>
{{else if torporState}}
<div class="r-vcard r-fate-plate is-torpor">
  <div class="r-vc-head"><h4 class="r-banner"><span>{{localize "VTM20.Torpor.Title"}}</span></h4><div class="r-vc-status">{{torporState.cause}}</div></div>
  <div class="r-fate-grid">
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Since"}}</span><b>{{torporState.since}}</b></div>
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Span"}}</span><b>{{torporState.span}}</b> <small>({{localize "VTM20.Torpor.Morality"}} {{torporState.morality}})</small></div>
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Wakes"}}</span><b>{{torporState.until}}</b></div>
  </div>
  <div class="r-fate-bar"><i style="width: {{torporState.pct}}%"></i></div>
  <div class="r-fate-nights"><span>{{localize "VTM20.Torpor.Passed" n=torporState.passed}}</span><span>{{localize "VTM20.Torpor.Left" n=torporState.left}}</span></div>
  {{#if editable}}<div class="r-fate-tools">
    <a class="r-h2-btn {{#unless torporState.ready}}is-off{{/unless}}" data-action="torporWake" data-tooltip="{{localize 'VTM20.Torpor.WakeHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Torpor.Wake"}}</a>
    <a class="r-h2-btn" data-action="torporWakeBlood" data-tooltip="{{localize 'VTM20.Torpor.WakeBloodHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Torpor.WakeBlood"}}</a>
    {{#unless torporState.ready}}<span class="r-fate-note">{{localize "VTM20.Torpor.NotYetShort"}}</span>{{/unless}}
  </div>{{/if}}
</div>
{{/if}}

<div class="r-vitals-fold"><div class="r-vitals">
  <div class="r-vcard r-vc-health {{#if healthHurt}}is-hurt{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner"><span>{{localize "VTM20.Sheet.Health"}}</span></h4>
      <div class="r-vc-status">{{healthStatus}}{{#if woundPenalty}} <b>{{woundPenalty}}</b>{{/if}}</div>
    </div>
    <div class="r-hboxes">
      {{#each health}}
      <div class="r-hbox is-{{state}} is-sev{{sev}} {{#if current}}is-current{{/if}}" data-tooltip="{{label}}{{#if penaltyLabel}} ({{penaltyLabel}}){{/if}}">
        <span class="r-hbox-mark">{{mark}}</span>
        <span class="r-hbox-pen">{{#if out}}<i class="fa-solid fa-skull"></i>{{else}}{{penaltyLabel}}{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools">
      <span class="r-vc-btngroup" data-tooltip="{{localize 'VTM20.Sheet.HealthHint'}}">
        <span class="r-vc-btnlabel">{{localize "VTM20.Sheet.DamageMarks"}}</span>
        <a class="r-vc-btn is-sq is-bashing" data-action="setHealth" data-type="bashing" aria-label="{{localize 'VTM20.Damage.bashing'}}">/</a>
        <a class="r-vc-btn is-sq is-lethal" data-action="setHealth" data-type="lethal" aria-label="{{localize 'VTM20.Damage.lethal'}}">X</a>
        <a class="r-vc-btn is-sq is-aggravated" data-action="setHealth" data-type="aggravated" aria-label="{{localize 'VTM20.Damage.aggravated'}}">✱</a>
      </span>
      {{#if isDemon}}<a class="r-vc-btn" data-action="faithHeal" data-tooltip="{{localize 'VTM20.Demon.FaithHealHint'}}"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VTM20.Demon.FaithHeal"}}</a>{{/if}}
      {{#if hasBlood}}<a class="r-vc-btn" data-action="bloodHeal" data-type="aggravated" data-tooltip="{{localize 'VTM20.Sheet.HealAggHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Sheet.HealAggShort"}}</a>{{/if}}
      <span class="r-vc-hint" data-tooltip="{{localize 'VTM20.Sheet.SoakHint'}}"><i class="fa-solid fa-shield-halved"></i> {{soak.bashing}}/{{soak.lethal}}/{{soak.aggravated}}</span>
    </div>
  </div>

  <div class="r-vcard r-vc-will">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="rollVirtue" data-kind="willpower">{{localize "VTM20.Willpower"}}</a></h4>
      <div class="r-vc-status"><b>{{system.willpower.temporary}}</b> / {{system.willpower.permanent}}</div>
    </div>
    {{> rDots dots=willPerm cls="is-ten"}}
    <div class="r-boxes">
      {{#each willTemp}}<a class="r-box {{#if filled}}is-filled{{/if}} {{#if locked}}is-locked{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    <div class="r-vc-tools">
      <a class="r-vc-btn" data-action="spendWill"><i class="fa-solid fa-minus"></i> {{localize "VTM20.Sheet.SpendWillShort"}}</a>
      {{#if natureRegain}}<span class="r-vc-hint" data-tooltip="{{localize 'VTM20.Sheet.NatureRegain'}} {{natureRegain}}"><i class="fa-solid fa-star"></i> {{system.details.nature}}</span>{{/if}}
    </div>
  </div>

  {{#if isDemon}}
  {{!-- Мука падшего: постоянная — точками, временная копится клетками (10 клеток — +1 постоянной); Добродетели демона --}}
  <div class="r-vcard r-vc-morality is-torment {{#if tormentHigh}}is-high{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner" data-tooltip="{{localize 'VTM20.Demon.TormentDieHint'}}"><span>{{localize "VTM20.Demon.Torment"}}</span></h4>
      <a class="r-icon-btn r-path-open" data-action="tormentLog" data-tooltip="{{localize 'VTM20.Demon.LogHint'}}"><i class="fa-solid fa-scroll"></i></a>
      <div class="r-vc-status"><b>{{system.torment.permanent}}</b>{{#if tormentHigh}} · {{localize "VTM20.Demon.HighTorment"}}{{/if}}</div>
    </div>
    {{> rDots dots=tormentPerm cls="is-ten"}}
    <div class="r-boxes" data-tooltip="{{localize 'VTM20.Demon.TormentTempHint'}}">
      {{#each tormentTemp}}<a class="r-box {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    {{#if urges}}
    {{!-- Привязанный: Потребности (Earthbound, гл. 3) — в форме и в теле носителя раскладываются по Характеристикам --}}
    <div class="r-virtues is-urges" data-tooltip="{{localize 'VTM20.Demon.UrgesHint'}}">
      {{#each urges}}
      <div class="r-virtue">
        <span class="r-trait-label" data-tooltip="{{tip}}">{{label}}</span>
        <span class="r-virtue-dots">{{> rDots dots=dots}}{{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.urges.{{key}}" data-kind="urge" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools"><span class="r-note r-eb-doom">{{localize "VTM20.Demon.EarthboundDoom"}}</span></div>
    {{else}}
    <div class="r-virtues">
      {{#each virtues}}
      <div class="r-virtue">
        <a class="r-trait-label" data-action="rollTrait" data-trait="virtues.{{slot}}">{{label}}</a>
        <span class="r-virtue-dots">{{> rDots dots=dots}}{{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.virtues.{{slot}}.value" data-kind="virtue" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools is-torment">
      <a class="r-vc-btn" data-action="tormentSin" data-tooltip="{{localize 'VTM20.Demon.SinHint'}}"><i class="fa-solid fa-skull"></i> {{localize "VTM20.Demon.Sin"}}</a>
      {{#if isGM}}<a class="r-vc-btn is-sq" data-action="sinSuggest" data-tooltip="{{localize 'VTM20.Demon.SinSuggestHint'}}"><i class="fa-solid fa-bell"></i></a>{{/if}}
      <a class="r-vc-btn" data-action="tormentKind" data-tooltip="{{localize 'VTM20.Demon.KindHint'}}"><i class="fa-solid fa-hand-holding-heart"></i> {{localize "VTM20.Demon.Kind"}}</a>
      {{!-- искупление опытом: коротко, цена — в подсказке; длинная надпись выталкивала кнопку на вторую строку --}}
      {{#if editable}}<a class="r-vc-btn is-right" data-action="tormentAtone" data-tooltip="{{localize 'VTM20.Demon.AtoneHint'}}"><i class="fa-solid fa-feather"></i> −1</a>{{/if}}
    </div>
    {{/if}}
  </div>
  {{else if hunterInfo}}
  {{!-- Охотник (Hunter: The Reckoning, гл. 4): Убеждённость 0–10 и Добродетели охоты; Человечности у наделённых нет --}}
  <div class="r-vcard r-vc-morality r-vc-hunter">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="openRules" data-tooltip="{{localize 'VTM20.Hunter.RulesHint'}}">{{localize "VTM20.Hunter.Conviction"}}</a></h4>
      <div class="r-vc-status" data-tooltip="{{localize 'VTM20.Hunter.BaseHint' n=hunterInfo.base}}"><b>{{hunterInfo.conviction}}</b> <small>/ {{hunterInfo.base}}</small></div>
    </div>
    {{> rDots dots=hunterInfo.convDots cls="is-ten"}}
    <div class="r-virtues r-hvirtues">
      {{#each hunterInfo.virtues}}
      <div class="r-virtue {{#if primary}}is-primary{{/if}} {{#if over}}is-over{{/if}}" data-tooltip="{{#if primary}}{{localize 'VTM20.Hunter.PrimaryHint'}} {{/if}}{{localize 'VTM20.Hunter.UsedHint' used=used value=value}}{{#if madness}} {{localize 'VTM20.Hunter.MadnessHint' n=madness}}{{/if}}">
        <a class="r-trait-label" data-action="rollTrait" data-trait="hunter.{{key}}">{{label}}</a>
        <span class="r-hv-num"><b>{{value}}</b>{{#if used}} <small>({{used}})</small>{{/if}}</span>
        {{> rDots dots=dots cls="is-ten is-small"}}
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools">
      <a class="r-vc-btn" data-action="hunterSight" data-tooltip="{{localize 'VTM20.Hunter.SightHint'}}"><i class="fa-solid fa-eye"></i> {{localize "VTM20.Hunter.Sight"}}</a>
      <a class="r-vc-btn is-sq" data-action="hunterTest" data-tooltip="{{localize 'VTM20.Hunter.VirtueTestHint'}}"><i class="fa-solid fa-scale-balanced"></i></a>
      {{#if editable}}<a class="r-vc-btn is-sq" data-action="hunterRestore" data-tooltip="{{localize 'VTM20.Hunter.RestoreHint'}}"><i class="fa-solid fa-rotate-left"></i></a>
      {{#if hunterInfo.canTrade}}<a class="r-vc-btn is-on" data-action="hunterTrade" data-tooltip="{{localize 'VTM20.Hunter.TradeHint'}}"><i class="fa-solid fa-arrow-up"></i> {{localize "VTM20.Hunter.Trade"}}</a>{{/if}}{{/if}}
      <a class="r-vc-btn is-sq {{#if system.exorcist.target}}is-on{{/if}}" data-action="exorcist" data-tooltip="{{localize 'VTM20.Exorcist.BtnHint'}}"><i class="fa-solid fa-hands-praying"></i></a>
      {{#if hunterInfo.madness}}<span class="r-vc-hint is-right is-warn" data-tooltip="{{localize 'VTM20.Hunter.MadnessHint' n=hunterInfo.madness}}"><i class="fa-solid fa-brain"></i> {{hunterInfo.madness}}</span>{{/if}}
    </div>
  </div>
  {{else if thrallInfo}}
  {{!-- Слуга падшего (Damned and Deceived): Вера слуги, хозяин, Добродетели падших, грех по порогу постоянной Воли --}}
  <div class="r-vcard r-vc-morality is-thrall">
    <div class="r-vc-head">
      <h4 class="r-banner"><span>{{localize "VTM20.Demon.ThrallCard"}}</span></h4>
      <div class="r-vc-status">{{localize "VTM20.Creator.ThrallFaith"}} <b>{{thrallInfo.faith}}</b></div>
    </div>
    {{> rDots dots=thrallInfo.faithDots}}
    <div class="r-thrall-master">{{localize "VTM20.Creator.PactMaster"}}:
      {{#if thrallInfo.master}}<a data-action="openUuid" data-uuid="{{thrallInfo.masterUuid}}">{{thrallInfo.master}}</a>{{else}}<em>{{localize "VTM20.Demon.ThrallNoMaster"}}</em>{{/if}}</div>
    <div class="r-virtues">
      {{#each virtues}}
      <div class="r-virtue">
        <a class="r-trait-label" data-action="rollTrait" data-trait="virtues.{{slot}}">{{label}}</a>
        <span class="r-virtue-dots">{{> rDots dots=dots}}{{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.virtues.{{slot}}.value" data-kind="virtue" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools">
      <span class="r-vc-hint is-left" data-tooltip="{{localize 'VTM20.Demon.ThrallSinGateHint'}}: {{thrallInfo.sin}}">{{localize "VTM20.Demon.ThrallSinGate"}}: <b>{{system.willpower.permanent}}</b></span>
      <a class="r-vc-btn" data-action="thrallGifts" data-tooltip="{{localize 'VTM20.Gifts.BtnHint'}}"><i class="fa-solid fa-gift"></i> {{thrallInfo.gifts}}</a>
      {{#if editable}}<a class="r-vc-btn is-sq" data-action="thrallPact" data-tooltip="{{localize 'VTM20.Demon.PactEditHint'}}"><i class="fa-solid fa-file-signature"></i></a>
      <a class="r-vc-btn is-sq" data-action="ghoulify" data-tooltip="{{localize 'VTM20.Ghoulify.Btn'}}"><i class="fa-solid fa-droplet"></i></a>
      <a class="r-vc-btn is-sq" data-action="thrallBreak" data-tooltip="{{localize 'VTM20.Demon.PactBreak'}}"><i class="fa-solid fa-link-slash"></i></a>{{/if}}
      <a class="r-vc-btn is-right" data-action="thrallSin" data-tooltip="{{localize 'VTM20.Demon.ThrallSinBtnHint'}}"><i class="fa-solid fa-skull"></i> {{localize "VTM20.Demon.Sin"}}</a>
    </div>
  </div>
  {{else}}
  <div class="r-vcard r-vc-morality">
    <div class="r-vc-head">
      {{#if isMortal}}<h4 class="r-banner"><a data-action="openPath" data-tooltip="{{localize 'VTM20.Sheet.OpenPath'}}">{{#each paths}}{{#if selected}}{{name}}{{/if}}{{/each}}</a></h4>
      {{else}}<h4 class="r-banner is-select">
        <select name="system.morality.path" class="r-path-select">
          {{#each paths}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </h4>{{/if}}
      <a class="r-icon-btn r-path-open" data-action="openPath" data-tooltip="{{localize 'VTM20.Sheet.OpenPath'}}"><i class="fa-solid fa-book-open"></i></a>
      <div class="r-vc-status"><b>{{system.morality.value}}</b></div>
    </div>
    {{> rDots dots=moralityDots cls="is-ten"}}
    <div class="r-virtues">
      {{#each virtues}}
      <div class="r-virtue">
        <a class="r-trait-label" data-action="rollTrait" data-trait="virtues.{{slot}}">{{label}}</a>
        <span class="r-virtue-dots">{{> rDots dots=dots}}{{#if @root.editable}}<a class="r-buy" data-action="buy" data-path="system.virtues.{{slot}}.value" data-kind="virtue" data-label="{{label}}" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools">
      <span class="r-vc-hint is-left" data-tooltip="{{localize 'VTM20.Sheet.BearingHint'}}">{{localize "VTM20.Sheet.Bearing"}}: <b>{{bearing.name}}</b> {{bearing.mod}}</span>
      {{#if isMortal}}{{#if editable}}<a class="r-vc-btn is-sq" data-action="thrallPact" data-tooltip="{{localize 'VTM20.Demon.PactExistingBtn'}}"><i class="fa-solid fa-handshake-angle"></i></a>
      <a class="r-vc-btn is-sq" data-action="ghoulify" data-tooltip="{{localize 'VTM20.Ghoulify.Btn'}}"><i class="fa-solid fa-droplet"></i></a>
      <a class="r-vc-btn is-sq {{#if system.ebServant.empowerments}}is-on{{/if}}" data-action="ebServant" data-tooltip="{{localize 'VTM20.EbServant.BtnHint'}}"><i class="fa-solid fa-gem"></i></a>{{/if}}
      <a class="r-vc-btn is-sq {{#if system.exorcist.target}}is-on{{/if}}" data-action="exorcist" data-tooltip="{{localize 'VTM20.Exorcist.BtnHint'}}"><i class="fa-solid fa-hands-praying"></i></a>{{/if}}
      <a class="r-vc-btn is-right" data-action="rollVirtue" data-kind="degeneration"><i class="fa-solid fa-scale-unbalanced"></i> {{localize "VTM20.Sheet.DegenerationShort"}}</a>
    </div>
  </div>
  {{/if}}
</div></div>
  {{!-- Полоса под шкалами: свернуть или развернуть их; свёрнутые — сводкой в одну строку --}}
  <a class="r-vitals-strip" data-action="toggleVitals" data-tooltip="{{#if vitalsClosed}}{{localize 'VTM20.Sheet.VitalsOpen'}}{{else}}{{localize 'VTM20.Sheet.VitalsClose'}}{{/if}}">
    <span class="r-vs-sum">
      <span class="r-vs-item {{#if healthHurt}}is-hurt{{/if}}"><i class="fa-solid fa-heart-pulse"></i> {{healthStatus}}{{#if woundPenalty}} <b>{{woundPenalty}}</b>{{/if}}</span>
      <span class="r-vs-item"><i class="fa-solid fa-shield-heart"></i> {{localize "VTM20.Willpower"}} <b>{{system.willpower.temporary}}</b>/{{system.willpower.permanent}}</span>
      {{#if isDemon}}<span class="r-vs-item"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VTM20.Demon.Faith"}} <b>{{system.faith.temporary}}</b>/{{system.faith.permanent}}</span>
      <span class="r-vs-item"><i class="fa-solid fa-link-slash"></i> {{localize "VTM20.Demon.Torment"}} <b>{{system.torment.permanent}}</b></span>
      {{else if thrallInfo}}<span class="r-vs-item"><i class="fa-solid fa-handshake-angle"></i> {{localize "VTM20.Creator.ThrallFaith"}} <b>{{thrallInfo.faith}}</b></span>
      {{else}}<span class="r-vs-item"><i class="fa-solid fa-scale-balanced"></i> {{#each paths}}{{#if selected}}{{name}}{{/if}}{{/each}} <b>{{system.morality.value}}</b></span>{{/if}}
    </span>
    <i class="fa-solid fa-chevron-up r-vs-caret"></i>
  </a>
</section>
