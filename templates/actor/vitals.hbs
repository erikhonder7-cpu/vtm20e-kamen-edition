      <a class="r-vc-btn is-sq {{#if system.exorcist.target}}is-on{{/if}}" data-action="exorcist" data-tooltip="{{localize 'VTM20.Exorcist.BtnHint'}}"><i class="fa-solid fa-hands-praying"></i></a>{{/if}}
      {{#if canEmbrace}}<a class="r-vc-btn is-sq" data-action="embrace" data-tooltip="{{localize 'VTM20.Embrace.Btn'}}"><i class="fa-solid fa-moon"></i></a>{{/if}}
      {{#if pathShift}}<a class="r-vc-btn is-sq" data-action="pathShift" data-tooltip="{{localize 'VTM20.PathShift.Btn'}}"><i class="fa-solid fa-route"></i></a>{{/if}}
      {{!-- Голконда (apps/golconda.mjs): всегда видна у вампира на Пути Человечности — состояние, что мешает, прогресс поиска --}}
      {{#if golconda}}
      {{#if golconda.active}}<span class="r-vc-hint is-gold r-golc" data-tooltip="{{localize 'VTM20.Golconda.ActiveHint'}}"><i class="fa-solid fa-sun"></i> {{golconda.label}}</span>
      {{else if golconda.lost}}<span class="r-vc-hint is-warn r-golc" data-tooltip="{{localize 'VTM20.Golconda.LostHint'}}"><i class="fa-solid fa-heart-crack"></i> {{golconda.label}}</span>
      {{else if golconda.failed}}<span class="r-vc-hint r-golc is-off" data-tooltip="{{localize 'VTM20.Golconda.FailedHint'}}"><i class="fa-solid fa-cloud"></i> {{golconda.label}}</span>
      {{else if golconda.closed}}<span class="r-vc-hint r-golc is-off" data-tooltip="{{localize 'VTM20.Golconda.NotEligible'}} {{golconda.why}}"><i class="fa-solid fa-sun"></i> {{golconda.label}}</span>
      {{else}}
        {{#if (rEq golconda.stage "suspire")}}<span class="r-vc-hint is-gold r-golc" data-tooltip="{{localize 'VTM20.Golconda.SuspireWait'}}"><i class="fa-solid fa-book-open"></i> {{golconda.label}}</span>
        {{else if editable}}<a class="r-vc-btn r-golc {{#if golconda.progress}}is-on{{/if}}" data-action="golcondaSeek" data-tooltip="{{localize 'VTM20.Golconda.SeekHint'}}"><i class="fa-solid fa-sun"></i> {{golconda.label}}{{#if golconda.progress}} <small>{{golconda.progress}}</small>{{/if}}</a>
        {{else}}<span class="r-vc-hint r-golc"><i class="fa-solid fa-sun"></i> {{golconda.label}}{{#if golconda.progress}} <small>{{golconda.progress}}</small>{{/if}}</span>{{/if}}
        {{#if golconda.canSuspire}}<a class="r-vc-btn is-sq {{#if (rEq golconda.stage 'suspire')}}is-on{{/if}}" data-action="golcondaSuspire" data-tooltip="{{localize 'VTM20.Golconda.SuspireHint'}}"><i class="fa-solid fa-hands-praying"></i></a>{{/if}}
      {{/if}}
      {{/if}}
      <a class="r-vc-btn is-right" data-action="rollVirtue" data-kind="degeneration"><i class="fa-solid fa-scale-unbalanced"></i> {{localize "VTM20.Sheet.DegenerationShort"}}</a>
    </div>
  </div>
  {{/if}}
</div></div>
  {{!-- Полоса под шкалами: свернуть или развернуть их; свёрнутые — сводкой в одну строку --}}
  <a class="r-vitals-strip" data-action="toggleVitals" data-tooltip="{{#if vitalsClosed}}{{localize 'VTM20.Sheet.VitalsOpen'}}{{else}}{{localize 'VTM20.Sheet.VitalsClose'}}{{/if}}">
    <span class="r-vs-sum">
      <span class="r-vs-item {{#if healthHurt}}is-hurt{{/if}}"><i class="fa-solid fa-heart-pulse"></i> {{healthStatus}}{{#if woundPenalty}} <b>{{woundPenalty}}</b>{{/if}}</span>
      <span class="r-vs-item"><i class="fa-solid fa-shield-heart"></i> {{localize "VTM20.Willpower"}} <b>{{system.willpower.temporary}}</b>/{{system.willpower.permanent}}</span>
      {{#if isDemon}}<span class="r-vs-item"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VTM20.Demon.Faith"}} <b>{{system.faith.temporary}}</b>/{{system.faith.permanent}}</span>
      <span class="r-vs-item"><i class="fa-solid fa-link-slash"></i> {{localize "VTM20.Demon.Torment"}} <b>{{system.torment.permanent}}</b></span>
      {{else if werewolfInfo}}<span class="r-vs-item"><i class="fa-solid fa-fire"></i> {{localize "VTM20.Werewolf.Rage"}} <b>{{werewolfInfo.rage}}</b>/{{werewolfInfo.ragePerm}}</span>
      <span class="r-vs-item"><i class="fa-solid fa-spiral"></i> {{localize "VTM20.Werewolf.Gnosis"}} <b>{{werewolfInfo.gnosis}}</b>/{{werewolfInfo.gnosisPerm}}</span>
      <span class="r-vs-item"><i class="fa-solid {{werewolfInfo.formIcon}}"></i> {{werewolfInfo.formName}}</span>
      {{else if wraithInfo}}<span class="r-vs-item"><i class="fa-solid fa-ghost"></i> {{localize "VTM20.Wraith.Pathos"}} <b>{{wraithInfo.pathos}}</b>/10</span>
      <span class="r-vs-item {{#if wraithInfo.canCatharsis}}is-hurt{{/if}}"><i class="fa-solid fa-mask"></i> {{localize "VTM20.Wraith.Angst"}} <b>{{wraithInfo.angst}}</b>/{{wraithInfo.angstPerm}}</span>
      {{else if mageInfo}}<span class="r-vs-item"><i class="fa-solid fa-hat-wizard"></i> {{@root.mageInfo.L.Arete}} <b>{{mageInfo.arete}}</b></span>
      <span class="r-vs-item"><i class="fa-solid fa-sun"></i> {{@root.mageInfo.L.Quintessence}} <b>{{mageInfo.quintessence}}</b></span>
      <span class="r-vs-item {{#if mageInfo.backlash}}is-hurt{{/if}}"><i class="fa-solid fa-burst"></i> {{localize "VTM20.Mage.Paradox"}} <b>{{mageInfo.paradox}}</b></span>
      {{else if thrallInfo}}<span class="r-vs-item"><i class="fa-solid fa-handshake-angle"></i> {{localize "VTM20.Creator.ThrallFaith"}} <b>{{thrallInfo.faith}}</b></span>
      {{else}}<span class="r-vs-item"><i class="fa-solid fa-scale-balanced"></i> {{#each paths}}{{#if selected}}{{name}}{{/if}}{{/each}} <b>{{system.morality.value}}</b></span>{{/if}}
    </span>
    <i class="fa-solid fa-chevron-up r-vs-caret"></i>
  </a>
</section>
