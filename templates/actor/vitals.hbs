{{!-- Шкалы: здоровье, воля, Человечность или Путь с Добродетелями. Шапка карточки — название и число в одну строку. --}}
<section class="r-vitals-wrap {{#if vitalsClosed}}is-closed{{/if}}">
{{!-- Торпор и Окончательная смерть (план 9): плашка над шкалами --}}
{{#if death}}
<div class="r-fate-plate is-dead">
  <span class="r-fate-title">{{localize "VTM20.Torpor.Death.Title"}}</span>
  <span class="r-fate-meta">{{death.at}} · <i>{{death.cause}}</i></span>
  <span class="r-fate-note">{{localize "VTM20.Torpor.Death.Note"}}</span>
  {{#if isGM}}<a class="r-h2-btn" data-action="undoDeath"><i class="fa-solid fa-rotate-left"></i> {{localize "VTM20.Torpor.Death.Undo"}}</a>{{/if}}
</div>
{{else if torporState}}
<div class="r-vcard r-fate-plate is-torpor">
  <div class="r-vc-head"><h4 class="r-banner"><span>{{localize "VTM20.Torpor.Title"}}</span></h4><div class="r-vc-status">{{torporState.cause}}</div></div>
  <div class="r-fate-grid">
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Since"}}</span><b>{{torporState.since}}</b></div>
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Span"}}</span><b>{{torporState.span}}</b> <small>({{localize "VTM20.Torpor.Morality"}} {{torporState.morality}})</small></div>
    <div><span class="r-fate-lbl">{{localize "VTM20.Torpor.Wakes"}}</span><b>{{torporState.until}}</b></div>
  </div>
  <div class="r-fate-bar"><i style="width: {{torporState.pct}}%"></i></div>
  <div class="r-fate-nights"><span>{{localize "VTM20.Torpor.Passed" n=torporState.passed}}</span><span>{{localize "VTM20.Torpor.Left" n=torporState.left}}</span></div>
  {{#if editable}}<div class="r-fate-tools">
    <a class="r-h2-btn {{#unless torporState.ready}}is-off{{/unless}}" data-action="torporWake" data-tooltip="{{localize 'VTM20.Torpor.WakeHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Torpor.Wake"}}</a>
    <a class="r-h2-btn" data-action="torporWakeBlood" data-tooltip="{{localize 'VTM20.Torpor.WakeBloodHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Torpor.WakeBlood"}}</a>
    {{#unless torporState.ready}}<span class="r-fate-note">{{localize "VTM20.Torpor.NotYetShort"}}</span>{{/unless}}
  </div>{{/if}}
</div>
{{/if}}

<div class="r-vitals-fold"><div class="r-vitals">
  <div class="r-vcard r-vc-health {{#if healthHurt}}is-hurt{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner"><span>{{#if wraithInfo}}{{localize "VTM20.Wraith.Corpus"}}{{else}}{{localize "VTM20.Sheet.Health"}}{{/if}}</span></h4>
      <div class="r-vc-status">{{#if wraithInfo}}<span data-tooltip="{{localize 'VTM20.Wraith.StateHint'}}">{{wraithInfo.stateLabel}}</span> <b>{{system.health.value}}</b>/{{wraithInfo.corpus}}{{else}}{{healthStatus}}{{#if woundPenalty}} <b>{{woundPenalty}}</b>{{/if}}{{/if}}</div>
    </div>
    {{#if wraithInfo}}<div class="r-wr-corpus" data-tooltip="{{localize 'VTM20.Wraith.CorpusPermHint'}}">{{> rDots dots=wraithInfo.corpusDots cls="is-ten"}}</div>{{/if}}
    <div class="r-hboxes">
      {{#each health}}
      <div class="r-hbox is-{{state}} is-sev{{sev}} {{#if current}}is-current{{/if}}" data-tooltip="{{label}}{{#if penaltyLabel}} ({{penaltyLabel}}){{/if}}">
        <span class="r-hbox-mark">{{mark}}</span>
        <span class="r-hbox-pen">{{#if out}}<i class="fa-solid fa-skull"></i>{{else}}{{penaltyLabel}}{{/if}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools">
      <span class="r-vc-btngroup" data-tooltip="{{localize 'VTM20.Sheet.HealthHint'}}">
        <span class="r-vc-btnlabel">{{localize "VTM20.Sheet.DamageMarks"}}</span>
        <a class="r-vc-btn is-sq is-bashing" data-action="setHealth" data-type="bashing" aria-label="{{localize 'VTM20.Damage.bashing'}}">/</a>
        <a class="r-vc-btn is-sq is-lethal" data-action="setHealth" data-type="lethal" aria-label="{{localize 'VTM20.Damage.lethal'}}">X</a>
        <a class="r-vc-btn is-sq is-aggravated" data-action="setHealth" data-type="aggravated" aria-label="{{localize 'VTM20.Damage.aggravated'}}">✱</a>
      </span>
      {{#if isDemon}}<a class="r-vc-btn" data-action="faithHeal" data-tooltip="{{localize 'VTM20.Demon.FaithHealHint'}}"><i class="fa-solid fa-fire-flame-curved"></i> {{localize "VTM20.Demon.FaithHeal"}}</a>{{/if}}
      {{#if wraithInfo}}<a class="r-vc-btn" data-action="wrHeal" data-tooltip="{{#if spectre}}{{localize 'VTM20.Wraith.Spectre.HealHint'}}{{else}}{{localize 'VTM20.Wraith.HealHint'}}{{/if}}"><i class="fa-solid fa-hand-sparkles"></i> {{#if spectre}}{{localize "VTM20.Wraith.Spectre.HealShort"}}{{else}}{{localize "VTM20.Wraith.HealShort"}}{{/if}}</a>
      {{#if editable}}<select name="system.wraith.state" class="r-mini-select" data-tooltip="{{localize 'VTM20.Wraith.StateHint'}}">{{#each wraithInfo.states}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}{{/if}}
      {{#if hasBlood}}<a class="r-vc-btn" data-action="bloodHeal" data-type="aggravated" data-tooltip="{{localize 'VTM20.Sheet.HealAggHint'}}"><i class="fa-solid fa-droplet"></i> {{localize "VTM20.Sheet.HealAggShort"}}</a>{{/if}}
      <span class="r-vc-hint" data-tooltip="{{localize 'VTM20.Sheet.SoakHint'}}"><i class="fa-solid fa-shield-halved"></i> {{soak.bashing}}/{{soak.lethal}}/{{soak.aggravated}}</span>
    </div>
  </div>

  <div class="r-vcard r-vc-will">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="rollVirtue" data-kind="willpower">{{localize "VTM20.Willpower"}}</a></h4>
      <div class="r-vc-status"><b>{{system.willpower.temporary}}</b> / {{system.willpower.permanent}}</div>
    </div>
    {{> rDots dots=willPerm cls="is-ten"}}
    <div class="r-boxes">
      {{#each willTemp}}<a class="r-box {{#if filled}}is-filled{{/if}} {{#if locked}}is-locked{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    <div class="r-vc-tools">
      <a class="r-vc-btn" data-action="spendWill"><i class="fa-solid fa-minus"></i> {{localize "VTM20.Sheet.SpendWillShort"}}</a>
      {{#if natureRegain}}<span class="r-vc-hint" data-tooltip="{{localize 'VTM20.Sheet.NatureRegain'}} {{natureRegain}}"><i class="fa-solid fa-star"></i> {{system.details.nature}}</span>{{/if}}
    </div>
  </div>

  {{#if isDemon}}
  {{!-- Мука падшего: постоянная — точками, временная копится клетками (10 клеток — +1 постоянной); Добродетели демона --}}
  <div class="r-vcard r-vc-morality is-torment {{#if tormentHigh}}is-high{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner" data-tooltip="{{localize 'VTM20.Demon.TormentDieHint'}}"><span>{{localize "VTM20.Demon.Torment"}}</span></h4>
      <a class="r-icon-btn r-path-open" data-action="tormentLog" data-tooltip="{{localize 'VTM20.Demon.LogHint'}}"><i class="fa-solid fa-scroll"></i></a>
      <div class="r-vc-status"><b>{{system.torment.permanent}}</b>{{#if tormentHigh}} · {{localize "VTM20.Demon.HighTorment"}}{{/if}}</div>
    </div>
    {{> rDots dots=tormentPerm cls="is-ten"}}
    <div class="r-boxes" data-tooltip="{{localize 'VTM20.Demon.TormentTempHint'}}">
      {{#each tormentTemp}}<a class="r-box {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    {{#if urges}}
    {{!-- Привязанный: Потребности (Earthbound, гл. 3) — в форме и в теле носителя раскладываются по Характеристикам --}}
    <div class="r-virtues is-urges" data-tooltip="{{localize 'VTM20.Demon.UrgesHint'}}">
      {{#each urges}}
      <div class="r-virtue">
        <span class="r-trait-label" data-tooltip="{{tip}}">{{label}}</span>
        <span class="r-virtue-dots">{{> rDots dots=dots}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools"><span class="r-note r-explain r-eb-doom">{{localize "VTM20.Demon.EarthboundDoom"}}</span></div>
    {{else}}
    <div class="r-virtues">
      {{#each virtues}}
      <div class="r-virtue">
        <a class="r-trait-label" data-action="rollTrait" data-trait="virtues.{{slot}}">{{label}}</a>
        <span class="r-virtue-dots">{{> rDots dots=dots}}</span>
      </div>
      {{/each}}
    </div>
    <div class="r-vc-tools is-torment">
      <a class="r-vc-btn" data-action="tormentSin" data-tooltip="{{localize 'VTM20.Demon.SinHint'}}"><i class="fa-solid fa-skull"></i> {{localize "VTM20.Demon.Sin"}}</a>
      {{#if isGM}}<a class="r-vc-btn is-sq" data-action="sinSuggest" data-tooltip="{{localize 'VTM20.Demon.SinSuggestHint'}}"><i class="fa-solid fa-bell"></i></a>{{/if}}
      <a class="r-vc-btn" data-action="tormentKind" data-tooltip="{{localize 'VTM20.Demon.KindHint'}}"><i class="fa-solid fa-hand-holding-heart"></i> {{localize "VTM20.Demon.Kind"}}</a>
      {{!-- искупление опытом: коротко, цена — в подсказке; длинная надпись выталкивала кнопку на вторую строку --}}
      {{#if editable}}<a class="r-vc-btn is-right" data-action="tormentAtone" data-tooltip="{{localize 'VTM20.Demon.AtoneHint'}}"><i class="fa-solid fa-feather"></i> −1</a>{{/if}}
    </div>
    {{/if}}
  </div>
  {{else if werewolfInfo}}
  {{!-- Гару (W20, гл. 4): Ярость и Гнозис — как Воля: постоянное кружками, текущий пул квадратиками (щелчок — поставить).
       Текущая Ярость может быть выше постоянной; Гнозис — нет. Слава и Ранг — строкой в шапке. --}}
  <div class="r-vcard r-vc-morality r-vc-garou is-pair">
    {{!-- Ярость и Гнозис — двумя колонками: карточка ниже и вровень со Здоровьем и Волей --}}
    <div class="r-ww-pool">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="rollTrait" data-trait="werewolf.rage" data-tooltip="{{localize 'VTM20.Werewolf.RageHint'}}">{{localize "VTM20.Werewolf.Rage"}}</a></h4>
      {{#if werewolfInfo.beast}}<span class="r-vc-hint is-warn r-ww-beast" data-tooltip="{{localize 'VTM20.Werewolf.BeastHint' n=werewolfInfo.beast}}"><i class="fa-solid fa-paw-claws"></i> −{{werewolfInfo.beast}}</span>{{/if}}
      {{#if editable}}<a class="r-vc-btn" data-action="wwRageRegain" data-tooltip="{{localize 'VTM20.Werewolf.RageRegainHint'}}"><i class="fa-solid fa-moon"></i></a>{{/if}}
      <div class="r-vc-status"><b>{{werewolfInfo.rage}}</b> / {{werewolfInfo.ragePerm}}</div>
    </div>
    {{> rDots dots=werewolfInfo.rageDots cls="is-ten is-rage"}}
    <div class="r-boxes is-rage">
      {{#each werewolfInfo.rageTemp}}<a class="r-box {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    </div>
    <div class="r-ww-pool">
    <div class="r-vc-head is-second">
      <h4 class="r-banner"><a data-action="rollTrait" data-trait="werewolf.gnosis" data-tooltip="{{localize 'VTM20.Werewolf.GnosisHint'}}">{{localize "VTM20.Werewolf.Gnosis"}}</a></h4>
      {{#if editable}}<a class="r-vc-btn" data-action="wwGnosisRegain" data-tooltip="{{localize 'VTM20.Werewolf.GnosisRegainHint'}}"><i class="fa-solid fa-spiral"></i></a>{{/if}}
      <div class="r-vc-status"><b>{{werewolfInfo.gnosis}}</b> / {{werewolfInfo.gnosisPerm}}</div>
    </div>
    {{> rDots dots=werewolfInfo.gnosisDots cls="is-ten is-gnosis"}}
    <div class="r-boxes is-gnosis">
      {{#each werewolfInfo.gnosisTemp}}<a class="r-box {{#if filled}}is-filled{{/if}} {{#if locked}}is-locked{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    </div>
  </div>
  {{else if spectre}}
  {{!-- Психея Спектра (Wraith 20, гл. 10): рейтинг Пафоса — точками (10 — Искупление), запас — клетками; Катарсис Психеи,
       когда запас выше Воли. Рейтинг игрок знать не должен — точный счёт у проводника Психеи и рассказчика. --}}
  <div class="r-vcard r-vc-morality r-vc-shadow r-vc-psyche {{#if spectre.psyche.catharsis}}is-catharsis{{/if}} {{#if spectre.psyche.canCatharsis}}is-high{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="openRules" data-tooltip="{{localize 'VTM20.Wraith.Spectre.PsycheHint'}}">{{localize "VTM20.Wraith.Spectre.Psyche"}}</a></h4>
      <div class="r-vc-status">{{localize "VTM20.Wraith.Pathos"}} <b>{{spectre.psyche.pool}}</b> / {{spectre.psyche.rating}}</div>
    </div>
    {{> rDots dots=spectre.psyche.ratingDots cls="is-ten is-psyche"}}
    <div class="r-boxes is-psyche" data-tooltip="{{localize 'VTM20.Wraith.Spectre.PoolHint'}}">
      {{#each spectre.psyche.poolBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" data-action="setDots" data-path="{{path}}" data-n="{{n}}"></a>{{/each}}
    </div>
    <label class="r-wr-arch"><span>{{localize "VTM20.Wraith.Spectre.PsycheArchetype"}}</span>
      <select name="system.wraith.spectre.psyche.archetype"><option value="">—</option>{{#each spectre.psyche.archetypes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
    </label>
    <div class="r-vc-tools">
      <a class="r-vc-btn {{#if spectre.psyche.catharsis}}is-on{{/if}}" data-action="spCatharsis" data-tooltip="{{localize 'VTM20.Wraith.Spectre.CatharsisHint'}}"><i class="fa-solid fa-dove"></i> {{localize "VTM20.Wraith.Catharsis"}}</a>
      <a class="r-vc-btn is-sq" data-action="wrShadowDice" data-tooltip="{{localize 'VTM20.Wraith.Guide.PsycheDiceHint'}}"><i class="fa-solid fa-dice"></i></a>
      {{#if wraithInfo.canGuide}}<a class="r-vc-btn is-sq" data-action="wrWhisper" data-tooltip="{{localize 'VTM20.Wraith.Guide.WhisperPsycheHint'}}"><i class="fa-solid fa-comment-dots"></i></a>{{/if}}
      {{#if isGM}}<a class="r-vc-btn is-sq {{#if wraithInfo.guide}}is-on{{/if}}" data-action="wrGuide" data-tooltip="{{localize 'VTM20.Wraith.Guide.HintPsyche'}}"><i class="fa-solid fa-user-secret"></i></a>{{/if}}
      {{#if wraithInfo.guide}}<span class="r-vc-hint r-wr-guide" data-tooltip="{{localize 'VTM20.Wraith.Guide.HintPsyche'}}"><i class="fa-solid fa-user-secret"></i> {{wraithInfo.guide}}</span>{{/if}}
      {{#if spectre.psyche.redeemed}}<span class="r-vc-hint is-right"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Wraith.Spectre.Redeemed"}}</span>{{/if}}
    </div>
  </div>
  {{else if changelingInfo}}
  {{!-- Грёза (C20, гл. 6): Гламур — точками постоянный и клетками временный; Банальность — рейтинг и пул (пул выше Гламура — Туманы);
       Кошмар 0–10 (10 — Дисбаланс: клетка Воли), Высвобождение и кубики Кошмара — module/apps/changeling.mjs --}}
  <div class="r-vcard r-vc-morality r-vc-dream {{#if changelingInfo.mists}}is-mists{{/if}} {{#if changelingInfo.bedlam}}is-bedlam{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner">{{localize "VTM20.Changeling.Glamour"}}</h4>
      <div class="r-vc-status"><b>{{changelingInfo.glamour}}</b> / {{changelingInfo.glamourPerm}}</div>
    </div>
    {{> rDots dots=changelingInfo.glamourDots cls="is-ten is-glamour"}}
    <div class="r-boxes is-glamour">{{#each changelingInfo.glamourBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
    <div class="r-vc-head r-vc-sub">
      <h4 class="r-banner" data-tooltip="{{localize 'VTM20.Changeling.BanalityHint'}}">{{localize "VTM20.Changeling.Banality"}}</h4>
      <div class="r-vc-status"><b>{{changelingInfo.banality}}</b>{{#if changelingInfo.mists}} <small class="is-warn">{{localize "VTM20.Changeling.Mists"}}</small>{{/if}}</div>
    </div>
    {{> rDots dots=changelingInfo.banalityDots cls="is-ten is-banality"}}
    <div class="r-boxes is-banality" data-tooltip="{{localize 'VTM20.Changeling.BanalityPoolHint'}}">{{#each changelingInfo.banalityBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
    <div class="r-vc-head r-vc-sub">
      <h4 class="r-banner" data-tooltip="{{localize 'VTM20.Changeling.NightmareHint'}}">{{localize "VTM20.Changeling.Nightmare"}}</h4>
      <div class="r-vc-status"><b>{{changelingInfo.nightmare}}</b>{{#if changelingInfo.imbalance}} <small class="is-warn" data-tooltip="{{localize 'VTM20.Changeling.ImbalanceHint'}}">{{localize "VTM20.Changeling.Imbalance"}} {{changelingInfo.imbalance}}</small>{{/if}}</div>
    </div>
    <div class="r-boxes is-nightmare">{{#each changelingInfo.nightmareBoxes}}<a class="r-box {{#if filled}}is-filled{{/if}}" {{#if @root.editable}}data-action="setDots" data-path="{{path}}" data-n="{{n}}"{{/if}}></a>{{/each}}</div>
    <div class="r-vc-tools">
      {{#if editable}}<a class="r-vc-btn is-sq" data-action="clGlamour" data-d="-1" data-tooltip="{{localize 'VTM20.Changeling.SpendGlamour'}}"><i class="fa-solid fa-minus"></i></a>
      <a class="r-vc-btn is-sq" data-action="clGlamour" data-d="1" data-tooltip="{{localize 'VTM20.Changeling.GainGlamour'}}"><i class="fa-solid fa-star"></i></a>
      <a class="r-vc-btn" data-action="clCast" data-tooltip="{{localize 'VTM20.Changeling.CantripHint'}}"><i class="fa-solid fa-wand-sparkles"></i> {{localize "VTM20.Changeling.Cantrip"}}</a>
      <a class="r-vc-btn is-sq is-right" data-action="clTrigger" data-tooltip="{{localize 'VTM20.Changeling.TriggerHint'}}"><i class="fa-solid fa-snowflake"></i></a>
      <a class="r-vc-btn is-sq" data-action="clNightmare" data-d="1" data-tooltip="{{localize 'VTM20.Changeling.NightmarePlus'}}"><i class="fa-solid fa-moon"></i></a>{{/if}}
    </div>
    {{#if (or changelingInfo.wyrd changelingInfo.threshold changelingInfo.place)}}<div class="r-cl-states">
      {{#if changelingInfo.wyrd}}<span class="r-cl-state is-wyrd" data-tooltip="{{localize 'VTM20.Changeling.WyrdHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Changeling.WyrdChip"}}</span>{{/if}}
      {{#if changelingInfo.threshold}}<span class="r-cl-state is-bedlam" data-tooltip="{{changelingInfo.threshold.text}}"><i class="fa-solid fa-masks-theater"></i> {{changelingInfo.threshold.name}} · {{changelingInfo.threshold.n}}
        {{#if changelingInfo.isGM}}<a data-action="clBedlamEnd" data-tooltip="{{localize 'VTM20.Changeling.BedlamEnd'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}</span>{{/if}}
      {{#if changelingInfo.place}}<span class="r-cl-state is-place" data-tooltip="{{localize 'VTM20.Changeling.PlaceHint'}}"><i class="fa-solid fa-building"></i> {{localize "VTM20.Changeling.PlaceChip" n=changelingInfo.place}}</span>{{/if}}
    </div>{{/if}}
    {{#if editable}}<div class="r-vc-tools r-cl-tools2">
      <a class="r-vc-btn" data-action="clEpiphany" data-tooltip="{{localize 'VTM20.Changeling.Epi.Hint'}}"><i class="fa-solid fa-lightbulb"></i> {{localize "VTM20.Changeling.Epi.Short"}}</a>
      <a class="r-vc-btn {{#if changelingInfo.wyrd}}is-on{{/if}}" data-action="clWyrd" data-tooltip="{{localize 'VTM20.Changeling.WyrdHint'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Changeling.Wyrd"}}</a>
      <a class="r-vc-btn" data-action="clAutumn" data-tooltip="{{localize 'VTM20.Changeling.AutumnHint'}}"><i class="fa-solid fa-leaf"></i> {{localize "VTM20.Changeling.Autumn"}}</a>
      {{#if changelingInfo.isGM}}<a class="r-vc-btn is-sq is-right" data-action="clPlace" data-tooltip="{{localize 'VTM20.Changeling.PlaceBanality'}}"><i class="fa-solid fa-building"></i></a>{{/if}}
    </div>{{/if}}
  </div>
  {{else if wraithInfo}}
  {{!-- Тень (Wraith 20, гл. 6): постоянный Ангст — точками, временный — клетками (10 — +1 постоянный); архетип; Катарсис,
       когда временный Ангст выше Воли. Ангст ведёт проводник-Тень: игрок видит шкалу, но точный счёт — у ведущего. --}}
  <div class="r-vcard r-vc-morality r-vc-shadow {{#if wraithInfo.catharsis}}is-catharsis{{/if}} {{#if wraithInfo.canCatharsis}}is-high{{/if}}">
    <div class="r-vc-head">
      <h4 class="r-banner"><a data-action="openRules" data-tooltip="{{localize 'VTM20.Wraith.RulesHint'}}">{{localize "VTM20.Wraith.Shadow"}}</a></h4>
