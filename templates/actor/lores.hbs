{{!-- II. Знания демона (Demon: The Fallen): точки, призывы по кругам из справочника, апокалиптическая форма Облика. --}}
<section class="tab r-pane r-disciplines r-lores {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h2 class="r-h2"><span>{{localize "VTM20.Demon.Lores"}}</span>
    <span class="r-h2-tools">
      {{#if lores.length}}<a class="r-h2-btn is-plain" data-action="toggleAll" data-tooltip="{{localize 'VTM20.Sheet.ToggleAllHint'}}"><i class="fa-solid {{#if allOpen}}fa-angles-up{{else}}fa-angles-down{{/if}}"></i> <span class="r-h2-lbl">{{#if allOpen}}{{localize "VTM20.Sheet.CollapseAll"}}{{else}}{{localize "VTM20.Sheet.ExpandAll"}}{{/if}}</span></a>{{/if}}
      {{#if editable}}
      {{#if missingHouse}}<a class="r-h2-btn" data-action="addHouseLores" data-tooltip="{{localize 'VTM20.Demon.AddHouseLoresHint'}}"><i class="fa-solid fa-fire-flame-curved"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.AddHouseLores"}}</span></a>{{/if}}
      <a class="r-h2-btn" data-action="addLore" data-tooltip="{{localize 'VTM20.Demon.AddLore'}}"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.AddLore"}}</span></a>
      <a class="r-h2-btn is-plain {{#if earthbound}}is-on{{/if}}" data-action="toggleEarthbound" data-tooltip="{{localize 'VTM20.Demon.EarthboundTip'}}"><i class="fa-solid {{#if earthbound}}fa-gem{{else}}fa-link-slash{{/if}}"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.Earthbound"}}</span></a>
      {{/if}}
    </span>
  </h2>

  {{#each lores}}
  <article class="r-row-wrap r-disc {{#if open}}is-open{{/if}} {{#if own}}is-clan{{/if}}" data-item-id="{{id}}">
    <header class="r-disc-head">
      <span class="r-disc-sigil"><i class="fa-solid {{#if dark}}fa-skull{{else if common}}fa-book{{else}}fa-fire-flame-curved{{/if}}"></i></span>
      <div class="r-disc-title">
        <a class="r-disc-name" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
        <span class="r-disc-sub">{{#if en}}{{en}} · {{/if}}{{houseName}}{{#if own}}{{#unless common}} · <b>{{localize "VTM20.Demon.OwnHouse"}}</b>{{/unless}}{{/if}}</span>
      </div>
      {{> rDots dots=dots cls="is-disc"}}
      <div class="r-disc-tools">
        {{#if @root.editable}}<a class="r-buy" data-action="buy" data-item-id="{{id}}" data-path="system.value" data-kind="lore" data-tooltip="{{localize 'VTM20.Xp.Buy'}}: {{xp}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
        <a class="r-icon-btn" data-action="itemEdit" data-tooltip="{{localize 'VTM20.Sheet.Edit'}}"><i class="fa-solid fa-pen-nib"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        <a class="r-icon-btn r-chevron" data-action="toggleRow" data-row-id="{{id}}"><i class="fa-solid fa-chevron-down"></i></a>
      </div>
    </header>

    <div class="r-disc-body"><div class="r-disc-inner">
      <div class="r-ladder">
        {{#each powers}}{{> rPower disc=(concat "lore:" ../key)}}{{/each}}
        {{#if nextPower}}<div class="r-next"><span class="r-power-lvl">{{rRoman nextPower.level}}</span><span class="r-next-text">{{localize "VTM20.Demon.NextEvocation"}}: <b>{{nextPower.name}}</b></span></div>{{/if}}
      </div>
    </div></div>
  </article>
  {{else}}
  <div class="r-empty">{{localize "VTM20.Demon.NoLores"}}</div>
  {{/each}}

  {{!-- Ритуалы падших (Players Guide, гл. 6): ход — длительный бросок Веры Анкиды, затем бросок эффекта --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Demon.Rituals"}}</span>
    <span class="r-h2-tools"><a class="r-h2-btn is-plain" data-action="openRules" data-tooltip="{{localize 'VTM20.Demon.RitualsRules'}}"><i class="fa-solid fa-book-open-reader"></i></a></span>
  </h2>
  {{#each demonRituals}}
  <article class="r-row-wrap r-rite {{#if open}}is-open{{/if}} {{#if run}}is-live{{/if}}" data-item-id="{{id}}">
    <header class="r-rite-head">
      <a class="r-rite-seal" data-action="toggleRow" data-row-id="{{id}}" data-tooltip="{{localize 'VTM20.Demon.RitualNeedTip'}}">
        <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="17"/><circle cx="20" cy="20" r="12.5"/>
          <path d="M20 3 L34.7 28.5 H5.3 Z"/><path d="M20 37 L5.3 11.5 H34.7 Z"/></svg>
        <b>{{need}}</b>
      </a>
      <div class="r-rite-title">
        <a class="r-rite-name" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
        <span class="r-rite-chips">{{#each chips}}<span class="r-lchip {{#if primary}}is-primary{{/if}} {{#unless has}}is-missing{{/unless}}" data-tooltip="{{#if primary}}{{localize 'VTM20.DRitual.Primary'}}{{else}}{{localize 'VTM20.DRitual.Secondary'}}{{/if}}{{#unless has}} — {{localize 'VTM20.Demon.RitualMissing'}}{{/unless}}">{{name}} <i>{{dots}}</i></span>{{/each}}</span>
      </div>
      <div class="r-rite-track" data-tooltip="{{#if run}}{{localize 'VTM20.Demon.RitualProgress' total=total need=need turn=run.turn}}{{else}}{{localize 'VTM20.Demon.RitualNeedTip'}}{{/if}}">
        <span class="r-rite-turns">{{#each turns}}<i class="{{#if done}}is-done{{/if}} {{#if next}}is-next{{/if}}"></i>{{/each}}</span>
        <span class="r-rite-meter"><i style="width: {{pct}}%"></i></span>
        <span class="r-rite-count"><b>{{total}}</b>/{{need}}</span>
      </div>
      <div class="r-disc-tools">
        {{#if @root.editable}}<a class="r-icon-btn r-rite-go" data-action="ritualTurn" data-tooltip="{{localize 'VTM20.Demon.RitualTurn'}}"><i class="fa-solid fa-hourglass-half"></i></a>{{/if}}
        {{#if canEffect}}<a class="r-icon-btn" data-action="ritualEffect" data-tooltip="{{localize 'VTM20.Demon.RitualEffect'}}: {{roll}}"><i class="fa-solid fa-dice-d10"></i></a>{{/if}}
        <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a>
        <a class="r-icon-btn" data-action="itemEdit" data-tooltip="{{localize 'VTM20.Sheet.Edit'}}"><i class="fa-solid fa-pen-nib"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        <a class="r-icon-btn r-chevron" data-action="toggleRow" data-row-id="{{id}}"><i class="fa-solid fa-chevron-down"></i></a>
      </div>
    </header>
    <div class="r-rite-body">
      <div class="r-rite-facts">
        {{#if time}}<span data-tooltip="{{localize 'VTM20.DRitual.Time'}}"><i class="fa-solid fa-clock"></i>{{time}}</span>{{/if}}
        {{#if limits}}<span data-tooltip="{{localize 'VTM20.DRitual.Limits'}}"><i class="fa-solid fa-moon"></i>{{limits}}</span>{{/if}}
        {{#if roll}}<span data-tooltip="{{localize 'VTM20.Demon.RitualEffect'}}"><i class="fa-solid fa-dice-d10"></i>{{roll}}</span>{{/if}}
        <span data-tooltip="{{localize 'VTM20.DRitual.Cost'}}"><i class="fa-solid fa-star"></i>{{cost}} {{localize "VTM20.Demon.XpShort"}}</span>
      </div>
      <div class="r-rite-text">{{{html}}}</div>
      {{#if high}}<div class="r-rite-note is-high"><b>{{localize "VTM20.DRitual.High"}}</b>{{high}}</div>{{/if}}
      {{#if variants}}<div class="r-rite-note is-var"><b>{{localize "VTM20.DRitual.Variants"}}</b>{{variants}}</div>{{/if}}
    </div>
  </article>
  {{else}}
  <div class="r-empty">{{localize "VTM20.Demon.NoRituals"}}</div>
  {{/each}}

  {{!-- Реликвии падших --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Demon.Relics"}}</span></h2>
  {{#each relics}}
  <article class="r-row-wrap r-rite r-relic-row is-{{kindKey}} {{#if open}}is-open{{/if}}" data-item-id="{{id}}">
    <header class="r-rite-head">
      <a class="r-rite-seal is-gem" data-action="toggleRow" data-row-id="{{id}}">
        <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 4 L33 14 L20 36 L7 14 Z"/><path d="M7 14 H33 M14 14 L20 36 L26 14 M14 14 L20 4 L26 14"/></svg>
      </a>
      <div class="r-rite-title">
        <a class="r-rite-name" data-action="toggleRow" data-row-id="{{id}}">{{name}}</a>
        <span class="r-rite-chips"><span class="r-kindtag">{{kind}}</span>{{#each chips}}<span class="r-lchip">{{name}}</span>{{/each}}</span>
      </div>
      <div class="r-disc-tools">
        <a class="r-icon-btn" data-action="itemChat" data-tooltip="{{localize 'VTM20.Sheet.ToChat'}}"><i class="fa-solid fa-comment-dots"></i></a>
        <a class="r-icon-btn" data-action="itemEdit" data-tooltip="{{localize 'VTM20.Sheet.Edit'}}"><i class="fa-solid fa-pen-nib"></i></a>
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="itemDelete" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-trash"></i></a>{{/if}}
        <a class="r-icon-btn r-chevron" data-action="toggleRow" data-row-id="{{id}}"><i class="fa-solid fa-chevron-down"></i></a>
      </div>
    </header>
    <div class="r-rite-body">
      {{#if use}}<div class="r-rite-facts"><span data-tooltip="{{localize 'VTM20.Relic.Use'}}"><i class="fa-solid fa-hand-sparkles"></i>{{use}}</span></div>{{/if}}
      <div class="r-rite-text">{{{html}}}</div>
      {{#if mechanics}}<div class="r-rite-note is-sys"><b>{{localize "VTM20.Relic.Mechanics"}}</b>{{mechanics}}</div>{{/if}}
    </div>
  </article>
  {{else}}
  <div class="r-empty">{{localize "VTM20.Demon.NoRelics"}}</div>
  {{/each}}

  {{!-- Врождённые способности (гл. 7): без броска — иммунитеты, с броском — мороки, имена, изгнание --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Demon.Innate"}}</span>
    <span class="r-h2-tools">
      <a class="r-h2-btn" data-action="innate" data-kind="illusion" data-tooltip="{{localize 'VTM20.Demon.InnateIllusionNote'}}"><i class="fa-solid fa-eye"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.InnateIllusionShort"}}</span></a>
      <a class="r-h2-btn" data-action="innate" data-kind="names" data-tooltip="{{localize 'VTM20.Demon.InnateNameHow'}}"><i class="fa-solid fa-signature"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.InnateNameShort"}}</span></a>
      <a class="r-h2-btn" data-action="innate" data-kind="exorcism" data-tooltip="{{localize 'VTM20.Demon.InnateExorcismNote'}}"><i class="fa-solid fa-person-walking-arrow-right"></i> <span class="r-h2-lbl">{{localize "VTM20.Demon.InnateExorcismShort"}}</span></a>
    </span>
  </h2>
  <p class="r-note r-innate-note">{{localize "VTM20.Demon.InnateText"}}</p>

  {{!-- Апокалиптическая форма: черты Облика; высокая Мука открывает тёмные черты --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Demon.Form"}}</span>
    <span class="r-h2-tools">
      {{#if form}}{{#if editable}}<a class="r-h2-btn {{#if form.on}}is-on{{/if}}" data-action="apocalyptic" data-tooltip="{{#if form.on}}{{localize 'VTM20.Demon.FormDrop'}}{{else}}{{localize 'VTM20.Demon.FormTake'}}{{/if}}"><i class="fa-solid fa-dragon"></i> <span class="r-h2-lbl">{{#if form.on}}{{localize "VTM20.Demon.FormDropShort"}}{{else}}{{localize "VTM20.Demon.FormTakeShort"}}{{/if}}</span></a>{{/if}}{{/if}}
    </span>
  </h2>
  {{#if form}}
  <div class="r-form {{#if form.on}}is-on{{/if}}">
    <p class="r-form-title"><b>{{form.visage}}</b> · {{form.lore}}{{#if form.on}} · <em>{{localize "VTM20.Demon.FormActive"}}</em>{{/if}}</p>
    {{#if form.fxSummary}}<p class="r-form-sum"><i class="fa-solid fa-dragon"></i> {{form.fxSummary}}</p>{{/if}}
    <div class="r-form-cols">
      <div class="r-form-col">
        <h4 class="r-h4">{{localize "VTM20.Demon.FormLow"}}</h4>
        {{#each form.low}}<div class="r-trait r-form-feat" {{#if tip}}data-tooltip="{{tip}}"{{/if}}>{{name}}{{#if mech}} <small class="r-form-mech">{{mech}}</small>{{/if}}{{#if pickable}} <a class="r-form-pick" {{#if @root.editable}}data-action="formPick" data-name="{{name}}"{{/if}} data-tooltip="{{localize 'VTM20.Demon.FormPickHint'}}"><i class="fa-solid fa-sliders"></i> {{#if picked}}{{picked}}{{else}}{{localize "VTM20.Demon.FormPickShort"}}{{/if}}</a>{{/if}}</div>{{/each}}
      </div>
      <div class="r-form-col is-high">
        <h4 class="r-h4">{{localize "VTM20.Demon.FormHigh"}} <small>({{form.highN}}/4)</small>{{#if form.free}} <em class="r-form-free">{{localize "VTM20.Demon.FormFree" n=form.free}}</em>{{/if}}</h4>
        {{#each form.high}}
        {{#if on}}<div class="r-trait r-form-feat is-chosen"><a {{#if @root.editable}}data-action="formHighPick" data-index="{{index}}" data-tooltip="{{localize 'VTM20.Demon.FormUnpick'}}"{{/if}}><b class="r-form-ord">{{order}}</b>{{name}}</a>{{#if mech}} <small class="r-form-mech">{{mech}}</small>{{/if}}{{#if pickable}} <a class="r-form-pick" {{#if @root.editable}}data-action="formPick" data-name="{{name}}"{{/if}} data-tooltip="{{localize 'VTM20.Demon.FormPickHint'}}"><i class="fa-solid fa-sliders"></i> {{#if picked}}{{picked}}{{else}}{{localize "VTM20.Demon.FormPickShort"}}{{/if}}</a>{{/if}}</div>
        {{else if scene}}<div class="r-trait r-form-feat is-scene">{{name}} <em>· {{localize "VTM20.Demon.SceneMark"}}</em>{{#if mech}} <small class="r-form-mech">{{mech}}</small>{{/if}}{{#if pickable}} <a class="r-form-pick" {{#if @root.editable}}data-action="formPick" data-name="{{name}}"{{/if}} data-tooltip="{{localize 'VTM20.Demon.FormPickHint'}}"><i class="fa-solid fa-sliders"></i> {{#if picked}}{{picked}}{{else}}{{localize "VTM20.Demon.FormPickShort"}}{{/if}}</a>{{/if}}</div>
        {{else if pick}}<a class="r-trait r-form-feat is-pick" {{#if @root.editable}}data-action="formHighPick" data-index="{{index}}" data-tooltip="{{localize 'VTM20.Demon.FormPick'}}"{{/if}}><i class="fa-solid fa-plus"></i> {{name}}{{#if mech}} <small class="r-form-mech">{{mech}}</small>{{/if}}</a>
        {{else}}<a class="r-trait r-form-feat is-off" {{#if ../form.on}}data-action="sceneHigh" data-index="{{index}}" data-tooltip="{{localize 'VTM20.Demon.SceneHighHint'}}"{{/if}}>{{name}}{{#if mech}} <small class="r-form-mech">{{mech}}</small>{{/if}}</a>{{/if}}
        {{/each}}
      </div>
    </div>
    <p class="r-note">{{localize "VTM20.Demon.FormNote"}}</p>
  </div>
  {{else}}
  <div class="r-empty">{{localize "VTM20.Demon.NoVisage"}}</div>
  {{/if}}
</section>
