{{!-- II. Призрак (Wraith 20): Арканои — карточками Гильдий с расколотыми кружками рангов (Общий и Посвящённый уровни);
     Страсти и Оковы (Пафос и Воля), Тень — Тёмные Страсти и Шипы. Тексты — справочник data/wraith.json. --}}
<section class="tab r-pane r-edges r-arcanoi {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <h2 class="r-h2"><span>{{localize "VTM20.Wraith.Arcanoi"}}</span>
    <span class="r-h2-tools">
      {{#if arc.own.length}}<a class="r-h2-btn is-plain" data-action="wrFold" data-to="{{#if arc.allFolded}}0{{else}}1{{/if}}" data-tooltip="{{localize 'VTM20.Sheet.ToggleAllHint'}}"><i class="fa-solid {{#if arc.allFolded}}fa-angles-down{{else}}fa-angles-up{{/if}}"></i> <span class="r-h2-lbl">{{#if arc.allFolded}}{{localize "VTM20.Sheet.ExpandAll"}}{{else}}{{localize "VTM20.Sheet.CollapseAll"}}{{/if}}</span></a>{{/if}}
      <a class="r-h2-btn is-plain" data-action="wrAtlas" data-tooltip="{{localize 'VTM20.Wraith.AtlasHint'}}"><i class="fa-solid fa-book-skull"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Atlas"}}</span></a>
      <a class="r-h2-btn is-plain" data-action="openRules" data-tooltip="{{localize 'VTM20.Wraith.RulesHint'}}"><i class="fa-solid fa-book-open-reader"></i></a>
    </span>
  </h2>
  {{!-- Покров сцены: рейтинг и из чего он сложился; рассказчик двигает рейтинг и Истерию, игрок отмечает «в Обиталище» --}}
  <div class="r-wr-shroud" data-tooltip="{{wraithInfo.shroud.text}}">
    <span class="r-wr-shroud-lbl"><i class="fa-solid fa-cloud"></i> {{localize "VTM20.Wraith.Shroud.Label"}}{{#if wraithInfo.shroud.scene}} <small>· {{wraithInfo.shroud.scene}}</small>{{/if}}</span>
    <b class="r-wr-shroud-num">{{wraithInfo.shroud.value}}</b>
    <small class="r-wr-shroud-why">{{wraithInfo.shroud.text}}</small>
    {{#unless (rEq wraithInfo.place "shadowlands")}}<span class="r-wr-necro-chip" data-tooltip="{{localize 'VTM20.Wraith.Place.Hint'}}"><i class="fa-solid fa-dungeon"></i> {{wraithInfo.placeLabel}}</span>{{/unless}}
    {{#if wraithInfo.necropolis}}<span class="r-wr-necro-chip" data-tooltip="{{wraithInfo.necropolis.text}}"><i class="fa-solid fa-city"></i> {{wraithInfo.necropolis.name}}</span>{{/if}}
    <span class="r-wr-shroud-tools">
      {{#if wraithInfo.isGM}}
      <select class="r-mini-select r-wr-place" data-tooltip="{{localize 'VTM20.Wraith.Place.Hint'}}">{{#each wraithInfo.places}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <select class="r-mini-select r-wr-necro" data-tooltip="{{localize 'VTM20.Wraith.Necro.Hint'}}"><option value="">{{localize "VTM20.Wraith.Necro.None"}}</option>{{#each wraithInfo.necropoli}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <a class="r-vc-btn is-sq" data-action="wrShroud" data-what="base" data-d="-1" data-tooltip="{{localize 'VTM20.Wraith.Shroud.Down'}}"><i class="fa-solid fa-minus"></i></a>
      <a class="r-vc-btn is-sq" data-action="wrShroud" data-what="base" data-d="1" data-tooltip="{{localize 'VTM20.Wraith.Shroud.Up'}}"><i class="fa-solid fa-plus"></i></a>
      <a class="r-vc-btn" data-action="wrShroud" data-what="hysteria" data-d="1" data-tooltip="{{localize 'VTM20.Wraith.Shroud.HysteriaHint'}}"><i class="fa-solid fa-face-scream"></i> {{localize "VTM20.Wraith.Shroud.HysteriaBtn"}}</a>
      <a class="r-vc-btn is-sq" data-action="uwStorm" data-tooltip="{{localize 'VTM20.Wraith.Storm.Hint'}}"><i class="fa-solid fa-hurricane"></i></a>
      <a class="r-vc-btn is-sq" data-action="uwFog" data-tooltip="{{localize 'VTM20.Wraith.Fog.Hint'}}"><i class="fa-solid fa-smog"></i></a>
      {{#if wraithInfo.shroud.hysteria}}<a class="r-vc-btn is-sq" data-action="wrShroud" data-what="hysteria" data-d="0" data-tooltip="{{localize 'VTM20.Wraith.Shroud.HysteriaReset'}}"><i class="fa-solid fa-rotate-left"></i></a>{{/if}}
      {{/if}}
      {{#if editable}}<a class="r-vc-btn is-sq" data-action="wrTempest" data-tooltip="{{localize 'VTM20.Wraith.Tempest.Hint'}}"><i class="fa-solid fa-wind"></i></a>
      <a class="r-vc-btn is-sq {{#if wraithInfo.forecast}}is-on{{/if}}" data-action="wrForecast" data-tooltip="{{#if wraithInfo.forecast}}{{localize 'VTM20.Wraith.Forecast.OnHint' hits=wraithInfo.forecast.hits}}{{else}}{{localize 'VTM20.Wraith.Forecast.Hint'}}{{/if}}"><i class="fa-solid fa-tornado"></i></a>
      {{#if wraithInfo.forecast}}<a class="r-vc-btn is-sq" data-action="wrForecastClear" data-tooltip="{{localize 'VTM20.Wraith.Forecast.Clear'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}{{/if}}
      {{#if wraithInfo.haunt}}{{#if editable}}<a class="r-vc-btn {{#if wraithInfo.inHaunt}}is-on{{/if}}" data-action="wrHaunt" data-tooltip="{{localize 'VTM20.Wraith.Shroud.HauntHint'}}"><i class="fa-solid fa-house-chimney-crack"></i> {{localize "VTM20.Wraith.Shroud.InHaunt"}}</a>{{/if}}{{/if}}
    </span>
  </div>

  {{!-- Спектр (гл. 10): каста, «Пал в Забвение» — у рассказчика --}}
  {{#if spectre}}
  <div class="r-wr-spectre-bar">
    <span class="r-wr-shroud-lbl"><i class="fa-solid fa-skull"></i> {{localize "VTM20.Wraith.Spectre.Title"}}</span>
    <select name="system.wraith.spectre.caste" class="r-mini-select" data-tooltip="{{spectre.caste.name}}"><option value="">—</option>{{#each spectre.castes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    {{#if spectre.caste}}<small class="r-wr-shroud-why" data-tooltip="{{spectre.caste.creation}}">{{localize "VTM20.Wraith.Spectre.CasteHint"}}</small>{{/if}}
    {{#if isGM}}<a class="r-vc-btn" data-action="spBecome" data-tooltip="{{localize 'VTM20.Wraith.Spectre.LeaveHint'}}"><i class="fa-solid fa-dove"></i> {{localize "VTM20.Wraith.Spectre.Leave"}}</a>{{/if}}
  </div>
  {{else if risen}}
  {{!-- Восставший (гл. 11): в теле или в Землях Теней, Проводник; Восстание и переходы; «Дисциплины» тела за Пафос --}}
  <div class="r-wr-spectre-bar r-wr-risen-bar">
    <span class="r-wr-shroud-lbl"><i class="fa-solid fa-person-rays"></i> {{localize "VTM20.Wraith.Risen.Title"}}</span>
    <b class="r-wr-risen-state {{#if risen.body}}is-body{{/if}}">{{#if risen.body}}{{localize "VTM20.Wraith.Risen.InBody"}}{{else}}{{localize "VTM20.Wraith.Risen.InShadowlands"}}{{/if}}{{#if risen.shadowRules}} · {{localize "VTM20.Wraith.Risen.ShadowRules"}}{{/if}}</b>
    <label class="r-wr-risen-conduit" data-tooltip="{{localize 'VTM20.Wraith.Risen.ConduitHint'}}"><i class="fa-solid fa-ring"></i>
      <input type="text" name="system.wraith.risen.conduit" value="{{risen.conduit}}" placeholder="{{localize 'VTM20.Wraith.Risen.Conduit'}}" {{#unless editable}}disabled{{/unless}}></label>
    {{#if editable}}<span class="r-wr-shroud-tools">
      {{#if risen.body}}<a class="r-vc-btn" data-action="rsLeave" data-tooltip="{{localize 'VTM20.Wraith.Risen.ToShadowlandsHint'}}"><i class="fa-solid fa-ghost"></i> {{localize "VTM20.Wraith.Risen.ToShadowlands"}}</a>
      <a class="r-vc-btn is-sq" data-action="rsSlumber" data-tooltip="{{localize 'VTM20.Wraith.Risen.SlumberHint'}}"><i class="fa-solid fa-bed"></i></a>
      <a class="r-vc-btn is-sq" data-action="rsDown" data-tooltip="{{localize 'VTM20.Wraith.Risen.DownHint'}}"><i class="fa-solid fa-person-falling"></i></a>
      {{else}}<a class="r-vc-btn" data-action="rsBody" data-tooltip="{{localize 'VTM20.Wraith.Risen.ToBodyHint'}}"><i class="fa-solid fa-person-rays"></i> {{localize "VTM20.Wraith.Risen.ToBody"}}</a>{{/if}}
      <a class="r-vc-btn is-sq" data-action="rsOn" data-tooltip="{{localize 'VTM20.Wraith.Risen.OffHint'}}"><i class="fa-solid fa-xmark"></i></a>
    </span>{{/if}}
  </div>
  <div class="r-wr-risen-disc">
    {{#each risen.disc}}
    <span class="r-wr-risen-d" data-tooltip="{{hint}}"><span class="r-trait-label">{{label}}</span>{{> rDots dots=dots cls="is-small"}}
      {{#if value}}<a class="r-vc-btn is-sq" data-action="rsDisc" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Wraith.Risen.DiscUse'}}"><i class="fa-solid fa-bolt"></i></a>{{/if}}</span>
    {{/each}}
  </div>
  {{else if projector.isProjector}}
  {{!-- Проектор «Орфея»: Оттенок (Любимые и Запретный Арканои), скиммер или спящий, проекция, Эмблема, Живучесть, Глаза мёртвых --}}
  <div class="r-wr-spectre-bar r-wr-proj-bar">
    <span class="r-wr-shroud-lbl"><i class="fa-solid fa-person-falling-burst"></i> {{localize "VTM20.Wraith.Proj.Title"}}</span>
    <select name="system.wraith.projector.shade" class="r-mini-select" data-tooltip="{{localize 'VTM20.Wraith.Proj.ShadeHint'}}"><option value="">{{localize "VTM20.Wraith.Proj.Shade"}}</option>{{#each projector.shades}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>
    <select name="system.wraith.projector.lament" class="r-mini-select"><option value="skimmer" {{#if (eq projector.lament "skimmer")}}selected{{/if}}>{{localize "VTM20.Wraith.Proj.Skimmer"}}</option><option value="sleeper" {{#if (eq projector.lament "sleeper")}}selected{{/if}}>{{localize "VTM20.Wraith.Proj.Sleeper"}}</option></select>
    <b class="r-wr-risen-state {{#if projector.projecting}}is-body{{/if}}">{{#if projector.projecting}}{{localize "VTM20.Wraith.Proj.Out"}}{{else}}{{localize "VTM20.Wraith.Proj.In"}}{{/if}}</b>
    {{#if editable}}<span class="r-wr-shroud-tools">
      <a class="r-vc-btn" data-action="pjProject" data-tooltip="{{localize 'VTM20.Wraith.Proj.ProjectHint'}}"><i class="fa-solid {{#if projector.projecting}}fa-person{{else}}fa-person-falling-burst{{/if}}"></i> {{#if projector.projecting}}{{localize "VTM20.Wraith.Proj.Back"}}{{else}}{{localize "VTM20.Wraith.Proj.Go"}}{{/if}}</a>
      {{#if projector.projecting}}<a class="r-vc-btn is-sq {{#if projector.emblem}}is-on{{/if}}" data-action="pjEmblem" data-tooltip="{{localize 'VTM20.Wraith.Proj.EmblemHint'}}"><i class="fa-solid fa-shield-halved"></i></a>
      <a class="r-vc-btn is-sq" data-action="pjWill" data-tooltip="{{localize 'VTM20.Wraith.Proj.VitalityHint'}}"><i class="fa-solid fa-heart-pulse"></i></a>
      {{else}}<a class="r-vc-btn is-sq" data-action="pjEyes" data-tooltip="{{localize 'VTM20.Wraith.Proj.DeadEyesHint'}}"><i class="fa-solid fa-eye"></i></a>
      <a class="r-vc-btn is-sq" data-action="uwPigment" data-tooltip="{{localize 'VTM20.Wraith.Orph.PigmentHint'}}"><i class="fa-solid fa-syringe"></i></a>{{/if}}
      <a class="r-vc-btn is-sq" data-action="uwYoke" data-tooltip="{{localize 'VTM20.Wraith.Orph.YokeHint'}}"><i class="fa-solid fa-link"></i></a>
      <a class="r-vc-btn is-sq" data-action="uwShare" data-tooltip="{{localize 'VTM20.Wraith.Orph.ShareHint'}}"><i class="fa-solid fa-hand-holding-heart"></i></a>
      <a class="r-vc-btn is-sq" data-action="pjOn" data-tooltip="{{localize 'VTM20.Wraith.Proj.OffHint'}}"><i class="fa-solid fa-xmark"></i></a>
    </span>{{/if}}
  </div>
  {{#if projector.shade}}<p class="r-note r-wr-proj-shade">{{localize "VTM20.Wraith.Proj.ShadeLine" fav=projector.favored proh=projector.prohibited max=projector.pathosMax}}</p>{{/if}}
  {{else}}
  <div class="r-wr-spectre-bar is-off">
    {{#if editable}}<a class="r-vc-btn" data-action="pjOn" data-tooltip="{{localize 'VTM20.Wraith.Proj.OnHint'}}"><i class="fa-solid fa-person-falling-burst"></i> {{localize "VTM20.Wraith.Proj.On"}}</a>
    <a class="r-vc-btn" data-action="rsOn" data-tooltip="{{localize 'VTM20.Wraith.Risen.OnHint'}}"><i class="fa-solid fa-person-rays"></i> {{localize "VTM20.Wraith.Risen.On"}}</a>
    <a class="r-vc-btn" data-action="rsRise" data-tooltip="{{localize 'VTM20.Wraith.Risen.RiseHint'}}"><i class="fa-solid fa-hand-fist"></i> {{localize "VTM20.Wraith.Risen.Rise"}}</a>{{/if}}
    {{#if isGM}}<a class="r-vc-btn" data-action="spBecome" data-tooltip="{{localize 'VTM20.Wraith.Spectre.BecomeHint'}}"><i class="fa-solid fa-skull"></i> {{localize "VTM20.Wraith.Spectre.Become"}}</a>
    <a class="r-vc-btn {{#if projector.isHue}}is-on{{/if}}" data-action="uwHue" data-tooltip="{{localize 'VTM20.Wraith.Hue.Hint'}}"><i class="fa-solid fa-droplet-slash"></i> {{localize "VTM20.Wraith.Hue.Title"}}</a>{{/if}}
  </div>
  {{/if}}

  {{#if editable}}{{#if arc.avail.length}}
  <div class="r-toolbar">
    <select class="r-wr-arc-add"><option value="">{{localize "VTM20.Wraith.AddArcanos"}}</option>{{#each arc.avail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="wrArcAdd" data-tooltip="{{localize 'VTM20.Wraith.AddArcanosHint'}}"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>
  {{/if}}{{/if}}

  {{!-- Арканои — карточками Гильдий. Пять рангов — кружки, расколотые пополам, как на листе Wraith 20 (гл. 5):
       левая половина — Общий уровень, правая — Посвящённый (тайна Гильдии). Щелчок по половинке открывает её уровень. --}}
  <div class="r-wr-arcs">
  {{#each arc.own}}
  <article class="r-vcard r-wr-arc {{#if folded}}is-shut{{else}}is-open{{/if}} {{#if home}}is-home{{/if}} {{#if forbidden}}is-forbidden{{/if}} {{#if sel}}has-sel{{/if}}">
    <header class="r-wr-arc-head">
      <span class="r-wr-arc-sigil" data-tooltip="{{guild}}">{{rSym sym "r-wrg"}}</span>
      <div class="r-wr-arc-title">
        <a class="r-wr-arc-name" data-action="rollTrait" data-trait="wraith.{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Roll'}}">{{name}}</a>
        <span class="r-wr-arc-guild">{{guild}}{{#if home}} · <b>{{localize "VTM20.Wraith.HomeGuild"}}</b>{{/if}}{{#if forbidden}} · <em>{{localize "VTM20.Wraith.Forbidden"}}</em>{{/if}}</span>
      </div>
      {{> rDots dots=dots cls="is-small"}}
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrArcDel" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      <a class="r-icon-btn r-chevron" data-action="wrFold" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Details'}}"><i class="fa-solid fa-chevron-down"></i></a>
    </header>
    <div class="r-wr-arc-body">
    <div class="r-wr-ranks">
      {{#each ranks}}
      <span class="r-wr-rank {{#if owned}}is-owned{{else}}is-beyond{{/if}}" data-roman="{{roman}}">
        {{#each halves}}<a class="r-wr-half is-{{side}} {{#if known}}is-known{{/if}} {{#unless allowed}}is-locked{{/unless}} {{#if selected}}is-sel{{/if}}"
          {{#if ../owned}}data-action="wrPick" data-key="{{../../key}}" data-level="{{level}}" data-kind="{{kind}}"{{/if}}
          data-tooltip="{{../roman}} · {{kindLabel}}: <b>{{name}}</b>{{#unless known}}{{#if ../owned}} — {{localize 'VTM20.Wraith.ArtUnknownShort'}}{{/if}}{{/unless}}"></a>{{/each}}
      </span>
      {{/each}}
    </div>
    <div class="r-wr-arc-attrs">{{attrs}}</div>
    {{#with sel}}
    <div class="r-wr-artpane {{#unless common}}is-initiate{{/unless}} {{#unless known}}is-unknown{{/unless}}">
      <div class="r-wr-art-top">
        <span class="r-wr-art-rank">{{roman}}</span>
        <span class="r-wr-art-name"><b>{{name}}</b>{{#if en}} <em>{{en}}</em>{{/if}}<small>{{kindLabel}}</small></span>
      </div>
      <div class="r-wr-art-chips">
        <span class="r-wr-chip" {{#if diffNote}}data-tooltip="{{diffNote}}"{{/if}}><i class="fa-solid fa-dice-d10"></i> {{#if attrLabel}}{{attrLabel}} + {{../name}} = <b>{{pool}}</b>{{#if diff}} · {{localize "VTM20.Roll.Vs"}} {{diff}}{{/if}}{{else}}{{localize "VTM20.Wraith.NoRoll"}}{{/if}}</span>
        {{#if viaShroud}}<span class="r-wr-chip is-shroud" data-tooltip="{{diffNote}}"><i class="fa-solid fa-cloud"></i> {{localize "VTM20.Wraith.Shroud.Through"}}</span>{{/if}}
        {{#if cost}}<span class="r-wr-chip is-cost"><i class="fa-solid fa-droplet"></i> {{cost}}</span>{{/if}}
      </div>
      <div class="r-wr-art-text">{{{html}}}</div>
      <div class="r-vc-tools">
        {{#if known}}<a class="r-vc-btn is-use" data-action="wrArt" data-key="{{../key}}" data-level="{{level}}" data-kind="{{kind}}" data-tooltip="{{localize 'VTM20.Wraith.UseArt'}}"><i class="fa-solid {{#if attrLabel}}fa-dice-d10{{else}}fa-hand-sparkles{{/if}}"></i> {{localize "VTM20.Wraith.Use"}}</a>{{/if}}
        {{#if @root.editable}}<a class="r-vc-btn {{#unless allowed}}is-locked{{/unless}}" data-action="wrArtToggle" data-key="{{../key}}" data-level="{{level}}" data-kind="{{#if common}}skip{{else}}initiate{{/if}}"
          data-tooltip="{{#unless allowed}}{{localize 'VTM20.Wraith.InitiateLocked'}}{{else}}{{#if known}}{{localize 'VTM20.Wraith.ArtKnown'}}{{else}}{{localize 'VTM20.Wraith.ArtUnknown'}}{{/if}}{{/unless}}"><i class="fa-solid {{#if known}}fa-circle-minus{{else}}fa-circle-plus{{/if}}"></i> {{#if known}}{{localize "VTM20.Wraith.Forget"}}{{else}}{{localize "VTM20.Wraith.Learn"}}{{/if}}</a>{{/if}}
        <a class="r-vc-btn is-sq is-right" data-action="wrPick" data-key="{{../key}}" data-level="{{level}}" data-kind="{{kind}}" data-tooltip="{{localize 'VTM20.Wraith.Collapse'}}"><i class="fa-solid fa-chevron-up"></i></a>
      </div>
    </div>
    {{/with}}
    </div>
  </article>
  {{else}}<p class="r-note">{{localize "VTM20.Wraith.NoArcanoi"}}</p>
  {{/each}}
  </div>

  {{#if spectre}}
  {{!-- Тёмные Арканои Спектра (гл. 10): уровни строками — пул, сложность, цена в Ангсте; щелчок — бросок --}}
  <h2 class="r-h2 is-shadow"><span>{{localize "VTM20.Wraith.Spectre.Dark"}}</span></h2>
  {{#if editable}}{{#if spectre.darkAvail.length}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.Spectre.AddDark"}}</option>{{#each spectre.darkAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="spRow" data-kind="dark" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}{{/if}}
  <div class="r-wr-darks">
    {{#each spectre.dark}}
    <article class="r-vcard r-wr-dark">
      <header class="r-wr-arc-head">
        <span class="r-wr-arc-sigil" data-tooltip="{{localize 'VTM20.Wraith.Spectre.Dark'}}">{{rSym @root.spectre.darkSym "r-wrg"}}</span>
        <div class="r-wr-arc-title"><a class="r-wr-arc-name" data-action="rollTrait" data-trait="spectre.{{key}}"><i class="fa-solid {{icon}}"></i> {{name}}</a><span class="r-wr-arc-guild">{{en}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="spRow" data-kind="dark" data-op="del" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </header>
      <ul class="r-wr-dark-levels">
        {{#each levels}}
        <li class="{{#unless known}}is-beyond{{/unless}}" data-tooltip="{{diffNote}}">
          <span class="r-wr-art-rank">{{level}}</span>
          <a class="r-wr-dark-name" {{#if known}}data-action="spDark" data-key="{{../key}}" data-level="{{level}}"{{/if}}><b>{{name}}</b> <em>{{en}}</em></a>
          <span class="r-wr-chip"><i class="fa-solid fa-dice-d10"></i> {{#if attrLabel}}{{attrLabel}} + {{../name}} = <b>{{pool}}</b> · {{localize "VTM20.Roll.Vs"}} {{diff}}{{else}}{{localize "VTM20.Wraith.NoRoll"}}{{/if}}</span>
          {{#if cost}}<span class="r-wr-chip is-cost">{{cost}}</span>{{/if}}
          {{#if viaShroud}}<span class="r-wr-chip is-shroud"><i class="fa-solid fa-cloud"></i></span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </article>
    {{/each}}
  </div>
  {{/if}}

  {{#if risen}}
  {{!-- Очарование и Случайность (гл. 11): свои Арканои Восставших, без лишнего Ангста --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Wraith.Risen.Arcanoi"}}</span></h2>
  {{#if editable}}{{#if risen.artAvail.length}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.AddArcanos"}}</option>{{#each risen.artAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="rsArtRow" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}{{/if}}
  <div class="r-wr-darks">
    {{#each risen.arts}}
    <article class="r-vcard r-wr-dark is-risen">
      <header class="r-wr-arc-head">
        <span class="r-wr-arc-sigil"><i class="fa-solid {{icon}}"></i></span>
        <div class="r-wr-arc-title"><span class="r-wr-arc-name">{{name}}</span><span class="r-wr-arc-guild">{{en}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="rsArtRow" data-op="del" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </header>
      <ul class="r-wr-dark-levels">
        {{#each levels}}
        <li class="{{#unless known}}is-beyond{{/unless}}" {{#if diffNote}}data-tooltip="{{diffNote}}"{{/if}}>
          <span class="r-wr-art-rank">{{level}}</span>
          <a class="r-wr-dark-name" {{#if known}}data-action="rsArt" data-key="{{../key}}" data-level="{{level}}"{{/if}}><b>{{name}}</b> <em>{{en}}</em></a>
          <span class="r-wr-chip"><i class="fa-solid fa-dice-d10"></i> {{poolLabel}} = <b>{{poolN}}</b> · {{localize "VTM20.Roll.Vs"}} {{diff}}</span>
          {{#if cost}}<span class="r-wr-chip is-cost">{{cost}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </article>
    {{/each}}
  </div>
  {{/if}}

  {{!-- Другое Тёмное Царство (гл. 13): откуда призрак; местные Арканои — Пути Нефритовой Империи, Смещение Сварги, Повеление абамбо --}}
  <h2 class="r-h2"><span>{{localize "VTM20.Wraith.Realm.Arcanoi"}}</span>
    <span class="r-h2-tools"><select name="system.wraith.realm.kingdom" class="r-mini-select" data-tooltip="{{localize 'VTM20.Wraith.Realm.Hint'}}"><option value="">{{localize "VTM20.Wraith.Realm.Stygia"}}</option>{{#each realm.kingdoms}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></span>
  </h2>
  {{#if realm.realm}}
  {{#if editable}}{{#if realm.avail.length}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.AddArcanos"}}</option>{{#each realm.avail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="rlRow" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}{{/if}}
  {{#if (eq realm.realm.key "jade")}}<p class="r-note">{{localize "VTM20.Wraith.Realm.JadeNote"}}</p>{{/if}}
  {{#if (eq realm.realm.key "africa")}}<p class="r-note">{{localize "VTM20.Wraith.Realm.AfricaNote"}}</p>{{/if}}
  {{/if}}
  <div class="r-wr-darks">
    {{#each realm.arts}}
    <article class="r-vcard r-wr-dark is-realm">
      <header class="r-wr-arc-head">
        <span class="r-wr-arc-sigil">{{rSym sym "r-wrg"}}</span>
        <div class="r-wr-arc-title"><a class="r-wr-arc-name" data-action="rollTrait" data-trait="realm.{{key}}">{{name}}</a><span class="r-wr-arc-guild">{{en}}</span></div>
        {{> rDots dots=dots cls="is-small"}}
        {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="rlRow" data-op="del" data-key="{{key}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
      </header>
      <ul class="r-wr-dark-levels">
        {{#each levels}}
        <li class="{{#unless known}}is-beyond{{/unless}}" data-tooltip="{{diffNote}}">
          <span class="r-wr-art-rank">{{level}}</span>
          <a class="r-wr-dark-name" {{#if known}}data-action="rlArt" data-key="{{../key}}" data-i="{{i}}"{{/if}}><b>{{name}}</b> <em>{{en}}</em></a>
          <span class="r-wr-chip"><i class="fa-solid fa-dice-d10"></i> {{poolLabel}} = <b>{{poolN}}</b> · {{localize "VTM20.Roll.Vs"}} {{diff}}</span>
          {{#if cost}}<span class="r-wr-chip is-cost">{{cost}}</span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </article>
    {{/each}}
  </div>

  {{!-- Страсти (гл. 8): Пафос — бросок рейтинга, сл. 6 (сам) или 8 (видит у смертного), раз за сцену; у Спектра — его Тёмные Страсти, Ангст --}}
  <h2 class="r-h2"><span>{{#if spectre}}{{localize "VTM20.Wraith.Spectre.OwnPassions"}}{{else}}{{localize "VTM20.Wraith.Passions"}}{{/if}} <small>{{wp.passionSum}}</small></span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="wrRowAdd" data-kind="passion"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Common.Add"}}</span></a></span>{{/if}}
  </h2>
  <ul class="r-edge-list r-wr-rows">
    {{#each wp.passions}}
    <li class="r-wr-row {{#if resolved}}is-resolved{{/if}} {{#if res.resolving}}is-resolving{{/if}}">
      <input type="text" class="r-wr-text" name="system.wraith.passions.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.PassionText'}}">
      <input type="text" class="r-wr-emo" name="system.wraith.passions.{{i}}.emotion" value="{{emotion}}" placeholder="{{localize 'VTM20.Wraith.Emotion'}}">
      {{#if resolved}}<span class="r-wr-res-tag" data-tooltip="{{localize 'VTM20.Wraith.Res.DoneHint'}}"><i class="fa-solid fa-dove"></i> {{localize "VTM20.Wraith.Res.Done"}}</span>{{else}}
      {{> rDots dots=dots}}
      {{#if res.resolving}}<span class="r-wr-res-tag is-going" data-tooltip="{{res.tip}}"><i class="fa-solid fa-feather"></i> {{res.orig}}</span>{{/if}}
      <a class="r-vc-btn" data-action="wrPassion" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.PassionHint'}}"><i class="fa-solid fa-heart"></i></a>
      {{#unless @root.spectre}}{{#if @root.editable}}{{#unless res.locked}}<a class="r-vc-btn" data-action="wrResolve" data-kind="passion" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Res.Hint'}}"><i class="fa-solid fa-dove"></i></a>{{/unless}}{{/if}}
      {{#if @root.isGM}}<a class="r-vc-btn" data-action="wrWane" data-kind="passion" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Res.WaneHint'}}"><i class="fa-solid fa-hourglass-end"></i></a>{{/if}}{{/unless}}
      {{/if}}
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrRowDel" data-kind="passion" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.NoPassions"}}</li>
    {{/each}}
  </ul>

  {{!-- Оковы (гл. 8): Воля — бросок рейтинга, сл. 6 в конце сцены с Оковами, сл. 4 за 8 часов Сна в них --}}
  <h2 class="r-h2"><span>{{#if projector.isProjector}}{{localize "VTM20.Wraith.Proj.Tethers"}}{{else}}{{localize "VTM20.Wraith.Fetters"}}{{/if}} <small>{{wp.fetterSum}}</small></span>
    {{#if editable}}<span class="r-h2-tools">{{#unless spectre}}{{#unless projector.isProjector}}{{#if wp.shadowlands.noFetters}}<a class="r-h2-btn is-warn" data-action="wrLinger" data-tooltip="{{#if wp.shadowlands.perDay}}{{localize 'VTM20.Wraith.Res.LingerDayHint'}}{{else}}{{localize 'VTM20.Wraith.Res.LingerSceneHint'}}{{/if}}"><i class="fa-solid fa-hourglass-half"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Res.Linger"}}</span></a>{{/if}}{{/unless}}{{/unless}}<a class="r-h2-btn" data-action="wrRowAdd" data-kind="fetter"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Common.Add"}}</span></a></span>{{/if}}
  </h2>
  <ul class="r-edge-list r-wr-rows">
    {{#each wp.fetters}}
    <li class="r-wr-row {{#if resolved}}is-resolved{{/if}}">
      <input type="text" class="r-wr-text is-wide" name="system.wraith.fetters.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.FetterText'}}">
      <label class="r-wr-check" data-tooltip="{{localize 'VTM20.Wraith.ResolvedHint'}}"><input type="checkbox" name="system.wraith.fetters.{{i}}.resolved" {{checked resolved}}> {{localize "VTM20.Wraith.Resolved"}}</label>
      {{#unless resolved}}
      {{> rDots dots=dots}}
      {{#if res.resolving}}<span class="r-wr-res-tag is-going" data-tooltip="{{res.tip}}"><i class="fa-solid fa-feather"></i> {{res.orig}}</span>{{/if}}
      <a class="r-vc-btn" data-action="wrFetter" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.FetterHint'}}"><i class="fa-solid fa-link"></i></a>
      {{#unless @root.projector.isProjector}}{{#if @root.editable}}<a class="r-vc-btn" data-action="wrResolve" data-kind="fetter" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Res.Hint'}}"><i class="fa-solid fa-dove"></i></a>{{/if}}
      {{#if @root.isGM}}<a class="r-vc-btn" data-action="wrWane" data-kind="fetter" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Res.WaneHintF'}}"><i class="fa-solid fa-hourglass-end"></i></a>{{/if}}{{/unless}}
      {{/unless}}
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrRowDel" data-kind="fetter" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.NoFetters"}}</li>
    {{/each}}
  </ul>

  {{#if wp.transcend}}
  {{!-- Путь к Трансценденции (гл. 8): механики нет — разрешённые Страсти и Оковы и Восемь Истин подсказкой --}}
  <p class="r-wr-transcend" data-tooltip="{{localize 'VTM20.Wraith.Res.Truths'}}"><i class="fa-solid fa-sun"></i> {{localize "VTM20.Wraith.Res.Transcend" p=wp.transcend.passions f=wp.transcend.fetters}}</p>
  {{/if}}

  {{!-- Консорты (гл. 5, «Attunement»): 1 Воля за удачное явление, Вселение или Кукловодство, раз за сцену; чужому 5, близкому 2–3;
       не больше постоянной Воли, Оковы — вне лимита. Арканос на Консорта — сложность −1 галочкой в окне броска (правило системы) --}}
  <h2 class="r-h2"><span data-tooltip="{{localize 'VTM20.Wraith.Consort.Hint'}}">{{localize "VTM20.Wraith.Consort.Title"}} <small class="{{#if consorts.over}}is-warn{{/if}}">{{consorts.count}}/{{consorts.limit}}</small></span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="wrConsortAdd"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Common.Add"}}</span></a></span>{{/if}}
  </h2>
  <ul class="r-edge-list r-wr-rows r-wr-consorts">
    {{#each consorts.rows}}
    <li class="r-wr-row {{#if attuned}}is-attuned{{/if}}">
      <input type="text" class="r-wr-text is-wide" name="system.wraith.consorts.{{i}}.name" value="{{name}}" placeholder="{{localize 'VTM20.Wraith.Consort.NamePh'}}">
      <select class="r-mini-select" name="system.wraith.consorts.{{i}}.need" data-dtype="Number" data-tooltip="{{localize 'VTM20.Wraith.Consort.NeedHint'}}">{{#each needs}}<option value="{{n}}" {{#if selected}}selected{{/if}}>{{n}}</option>{{/each}}</select>
      <span class="r-boxes is-consort">{{#each boxes}}<span class="r-box {{#if filled}}is-filled{{/if}}"></span>{{/each}}</span>
      {{#if attuned}}<span class="r-wr-res-tag"><i class="fa-solid fa-link"></i> {{localize "VTM20.Wraith.Consort.Attuned"}}</span>
      {{else}}{{#if @root.editable}}<a class="r-vc-btn {{#if done}}is-locked{{/if}}" data-action="wrConsort" data-i="{{i}}" data-tooltip="{{#if done}}{{localize 'VTM20.Wraith.Consort.DoneHint'}}{{else}}{{localize 'VTM20.Wraith.Consort.InvestHint'}}{{/if}}"><i class="fa-solid fa-hand-holding-heart"></i></a>{{/if}}{{/if}}
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrConsortDel" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.Consort.None"}}</li>
    {{/each}}
  </ul>

  {{#if spectre}}
  {{!-- Психея (гл. 10): Страсти — Пафос Психеи за успех (сл. 6 при достижении цели, 9 — чужая эмоция); Ветви; Шейдкрафт --}}
  <h2 class="r-h2 is-psyche"><span>{{localize "VTM20.Wraith.Spectre.PsychePassions"}}</span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="spRow" data-kind="psychePassion" data-op="add"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Common.Add"}}</span></a></span>{{/if}}
  </h2>
  <ul class="r-edge-list r-wr-rows is-psyche">
    {{#each spectre.psyche.passions}}
    <li class="r-wr-row">
      <input type="text" class="r-wr-text" name="system.wraith.spectre.psyche.passions.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.PassionText'}}">
      <input type="text" class="r-wr-emo" name="system.wraith.spectre.psyche.passions.{{i}}.emotion" value="{{emotion}}" placeholder="{{localize 'VTM20.Wraith.Emotion'}}">
      {{> rDots dots=dots}}
      <a class="r-vc-btn" data-action="spPassion" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Spectre.PassionHint'}}"><i class="fa-solid fa-dove"></i></a>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="spRow" data-kind="psychePassion" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.NoPassions"}}</li>
    {{/each}}
  </ul>
  <h2 class="r-h2 is-psyche"><span>{{localize "VTM20.Wraith.Spectre.Fronds"}}</span></h2>
  {{#if editable}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.Spectre.AddFrond"}}</option>{{#each spectre.psyche.frondAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="spRow" data-kind="frond" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}
  <ul class="r-edge-list r-wr-thorns">
    {{#each spectre.psyche.fronds}}
    <li class="r-edge"><span class="r-edge-lvl"><i class="fa-solid fa-seedling"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <small>{{en}} · {{costText}}</small><div class="r-edge-text">{{{html}}}</div></span>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="spRow" data-kind="frond" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.Spectre.NoFronds"}}</li>
    {{/each}}
  </ul>
  <h2 class="r-h2 is-shadow"><span>{{localize "VTM20.Wraith.Spectre.Shadecraft"}}</span></h2>
  {{#if editable}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.Spectre.AddShade"}}</option>{{#each spectre.shadeAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="spRow" data-kind="shade" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}
  <ul class="r-edge-list r-wr-thorns">
    {{#each spectre.shade}}
    <li class="r-edge"><span class="r-edge-lvl"><i class="fa-solid fa-teeth"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <small>{{en}}{{#if angst}} · {{angst}} {{localize "VTM20.Wraith.Spectre.Angst"}}{{/if}}</small><div class="r-edge-text">{{{html}}}</div></span>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="spRow" data-kind="shade" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.Spectre.NoShade"}}</li>
    {{/each}}
  </ul>
  {{else}}
  {{#if projector}}
  {{!-- Пятна проектора («Орфей»): одно на 2 постоянного Ангста; проявить — 1 временный Ангст; Социальные сложности +1 за проявленное --}}
  <h2 class="r-h2 is-shadow"><span>{{localize "VTM20.Wraith.Proj.Stains"}} <small>{{projector.stains.length}} / {{projector.slots}}</small></span>
    {{#if projector.isHue}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="uwHueAll" data-tooltip="{{localize 'VTM20.Wraith.Hue.AllHint'}}"><i class="fa-solid fa-droplet"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Hue.All"}}</span></a></span>{{/if}}
    {{#if projector.wild}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="pjSuppress" data-tooltip="{{localize 'VTM20.Wraith.Proj.SuppressHint'}}"><i class="fa-solid fa-hand"></i> <span class="r-h2-lbl">{{localize "VTM20.Wraith.Proj.Suppress"}}</span></a></span>{{/if}}
  </h2>
  {{#if projector.wild}}<p class="r-note is-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "VTM20.Wraith.Proj.Wild"}}</p>{{/if}}
  {{#if projector.shown}}<p class="r-note">{{localize "VTM20.Wraith.Proj.Social" n=projector.social}}</p>{{/if}}
  {{#if editable}}<div class="r-toolbar">
    <select><option value="">{{localize "VTM20.Wraith.Proj.AddStain"}}</option>{{#each projector.stainAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="pjRow" data-op="add"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}
  {{#if projector.overSlots}}<p class="r-note is-warn">{{localize "VTM20.Wraith.Proj.OverSlots" n=projector.slots}}</p>{{/if}}
  <ul class="r-edge-list r-wr-thorns">
    {{#each projector.stains}}
    <li class="r-edge {{#if shown}}is-on{{/if}}"><span class="r-edge-lvl"><i class="fa-solid fa-droplet"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <small>{{en}}</small>
        <div class="r-edge-text"><p><b>+</b> {{adv}}</p><p><b>−</b> {{dis}}</p></div></span>
      {{#if @root.editable}}<a class="r-vc-btn {{#if shown}}is-on{{/if}}" data-action="pjStain" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Proj.StainHint'}}"><i class="fa-solid fa-droplet"></i> {{#if shown}}{{localize "VTM20.Wraith.Proj.Hide"}}{{else}}{{localize "VTM20.Wraith.Proj.Show"}}{{/if}}</a>
      <a class="r-icon-btn is-danger" data-action="pjRow" data-op="del" data-i="{{i}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.Proj.NoStains"}}</li>
    {{/each}}
  </ul>
  {{/if}}
  {{#unless projector.isProjector}}
  {{!-- Тень (гл. 6): Тёмные Страсти — Ангст за успех (сл. 7 или 9, бросок видит ведущий); Шипы --}}
  <h2 class="r-h2 is-shadow"><span>{{localize "VTM20.Wraith.DarkPassions"}} <small>{{wp.darkSum}}</small></span>
    {{#if editable}}<span class="r-h2-tools"><a class="r-h2-btn" data-action="wrRowAdd" data-kind="dark"><i class="fa-solid fa-plus"></i> <span class="r-h2-lbl">{{localize "VTM20.Common.Add"}}</span></a></span>{{/if}}
  </h2>
  <ul class="r-edge-list r-wr-rows is-shadow">
    {{#each wp.dark}}
    <li class="r-wr-row">
      <input type="text" class="r-wr-text" name="system.wraith.shadow.darkPassions.{{i}}.text" value="{{text}}" placeholder="{{localize 'VTM20.Wraith.PassionText'}}">
      <input type="text" class="r-wr-emo" name="system.wraith.shadow.darkPassions.{{i}}.emotion" value="{{emotion}}" placeholder="{{localize 'VTM20.Wraith.Emotion'}}">
      {{> rDots dots=dots}}
      <a class="r-vc-btn" data-action="wrDark" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.DarkHint'}}"><i class="fa-solid fa-mask"></i></a>
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrRowDel" data-kind="dark" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.NoDark"}}</li>
    {{/each}}
  </ul>

  <h2 class="r-h2 is-shadow"><span>{{localize "VTM20.Wraith.Thorns"}}</span></h2>
  {{#if editable}}<div class="r-toolbar">
    <select class="r-wr-thorn-add"><option value="">{{localize "VTM20.Wraith.AddThorn"}}</option>{{#each wp.thornAvail}}<option value="{{key}}">{{label}}</option>{{/each}}</select>
    <a class="r-vc-btn" data-action="wrRowAdd" data-kind="thorn"><i class="fa-solid fa-plus"></i> {{localize "VTM20.Common.Add"}}</a>
  </div>{{/if}}
  <ul class="r-edge-list r-wr-thorns">
    {{#each wp.thorns}}
    <li class="r-edge">
      <span class="r-edge-lvl"><i class="fa-solid fa-spa"></i></span>
      <span class="r-edge-main"><b>{{name}}</b> <small>{{en}} · {{cost}}</small>
        <input type="text" class="r-wr-note" name="system.wraith.shadow.thorns.{{i}}.note" value="{{note}}" placeholder="{{localize 'VTM20.Wraith.ThornNote'}}"{{#if (rEq key "shadowtraits")}} data-tooltip="{{localize 'VTM20.Wraith.Thorn.TraitsHint'}}"{{/if}}>
        <div class="r-edge-text">{{{html}}}</div></span>
      {{#if use}}{{#if @root.wraithInfo.canGuide}}<a class="r-vc-btn" data-action="wrThorn" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Wraith.Thorn.UseHint'}}"><i class="fa-solid fa-spa"></i> {{localize "VTM20.Wraith.Thorn.Use"}}</a>{{/if}}{{/if}}
      {{#if @root.editable}}<a class="r-icon-btn is-danger" data-action="wrRowDel" data-kind="thorn" data-i="{{i}}" data-tooltip="{{localize 'VTM20.Sheet.Delete'}}"><i class="fa-solid fa-xmark"></i></a>{{/if}}
    </li>
    {{else}}<li class="r-note">{{localize "VTM20.Wraith.NoThorns"}}</li>
    {{/each}}
  </ul>
  {{/unless}}
  {{/if}}
</section>
